# Formulário institucional (chave pública fornecida pelo Web3Forms).
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 (opcional; formato G-XXXXXXXXXX).
PUBLIC_GA_MEASUREMENT_ID=

# Supabase do ambiente. Use exclusivamente a URL e a anon/publishable key
# do projeto de homologação; nunca inclua service_role ou senhas do banco.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
