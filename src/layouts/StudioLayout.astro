---
import "../styles/global.css"; import "@fontsource-variable/inter"; import "@fontsource-variable/space-grotesk"; import {st,studioLocale,studioPath} from "../lib/launch/i18n"; import {isSupabaseConfigured,supabaseServer} from "../lib/launch/supabase";
interface Props{title:string;description?:string} const {title,description="CronosStart Launch"}=Astro.props; const locale=studioLocale(Astro.url.toString()); const tr=(v:string)=>st(locale,v); const base=studioPath(locale,"/studio"); const institutional=locale==="es-VE"?"/es/":"/"; const visiblePath=Astro.url.pathname.replace(/^\/es(?=\/studio)/,""); const switchHref=locale==="es-VE"?`${Astro.url.origin}${visiblePath}`:`/es${visiblePath}`; const logoutTarget=`${base}/login`; let authenticated=false; if(isSupabaseConfigured()){const {data:{user}}=await supabaseServer(Astro.cookies).auth.getUser();authenticated=Boolean(user);}
---
<html lang={locale} style="--surface:#080c17;--surface-alt:#0f1626;--ink:#f7f9fc;--ink-muted:#94a0b5;--primary:#3867e8;--primary-ink:#fff;--accent:#56d5ff;--border:rgba(255,255,255,.1);--font-heading:'Space Grotesk Variable',sans-serif;--font-body:'Inter Variable',sans-serif"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>{title} · CronosStart Launch</title><meta name="description" content={description}/></head><body class="min-h-screen bg-[var(--surface)] text-[var(--ink)]"><header class="border-b border-white/10"><div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5"><a href={base} class="font-semibold tracking-tight">CronosStart <span class="text-[var(--accent)]">Launch</span></a><nav class="flex items-center gap-4 text-sm"><a href={switchHref} class="text-white/60 hover:text-white">{locale==="es-VE"?"PT":"ES"}</a><a href={institutional} class="text-white/60 hover:text-white">{tr("Site principal")}</a>{authenticated&&<form method="post" action="/api/launch/auth"><input type="hidden" name="intent" value="logout"/><input type="hidden" name="return_to" value={logoutTarget}/><button class="text-white/60 hover:text-white">{tr("Sair")}</button></form>}</nav></div></header><main><slot/></main></body></html>
