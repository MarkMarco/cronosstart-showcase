---
import "../styles/global.css";
import ShowcaseHeader from "../components/showcase/ShowcaseHeader.astro";
import ShowcaseFooter from "../components/showcase/ShowcaseFooter.astro";
import WhatsAppButton from "../components/showcase/WhatsAppButton.astro";
import DemoNotice from "../components/ui/DemoNotice.astro";
import SEOHead from "../components/seo/SEOHead.astro";
import Analytics from "../components/analytics/Analytics.astro";
import type { ShowcaseConfig } from "../config/showcases/types";

interface Props {
  config: ShowcaseConfig;
}
const { config } = Astro.props;

const t = config.theme;
const cssVars = [
  `--surface:${t.surface}`,
  `--surface-alt:${t.surfaceAlt}`,
  `--ink:${t.ink}`,
  `--ink-muted:${t.inkMuted}`,
  `--primary:${t.primary}`,
  `--primary-ink:${t.primaryInk}`,
  `--accent:${t.accent}`,
  `--border:${t.border}`,
  `--font-heading:${t.fontHeading}`,
  `--font-body:${t.fontBody}`,
  `--radius-card:${t.radiusCard}`,
].join(";");

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="pt-BR" style={cssVars}>
  <head>
    <SEOHead
      title={config.seo.title}
      description={config.seo.description}
      canonicalURL={canonicalURL}
      ogImage={config.seo.ogImage}
      ogImageAlt={config.seo.ogImageAlt}
      robots="noindex"
    />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col bg-[var(--surface)] text-[var(--ink)]">
    <ShowcaseHeader nav={config.nav} ctaLabel={config.hero.ctaPrimaryLabel} ctaHref={config.primaryCtaHref ?? "#contato"}>
      <slot name="header-logo" slot="logo" />
    </ShowcaseHeader>

    <DemoNotice />

    <main class="flex-1">
      <slot />
    </main>

    <ShowcaseFooter company={config.company} nav={config.nav} contact={config.contact}>
      <slot name="footer-logo" slot="logo" />
    </ShowcaseFooter>

    <WhatsAppButton contact={config.contact} />

    <script define:vars={{ modelName: config.company.name, segment: config.company.segment }}>
      window.__cronosDemoView = { modelName, segment };
    </script>
    <script>
      import { trackEvent } from "../utils/analytics";
      const demoInfo = (window as any).__cronosDemoView;
      if (demoInfo) {
        trackEvent("demo_view", {
          modelo: demoInfo.modelName,
          segmento: demoInfo.segment,
          pagina: window.location.pathname,
        });
      }
    </script>
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll("[data-animate]").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
