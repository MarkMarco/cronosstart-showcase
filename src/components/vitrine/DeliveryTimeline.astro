---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import Icon from "../ui/Icon.astro";
import { deliveryEstimate } from "../../config/deliveryTimeline";

const locale = getLocale(Astro.url);
const hasEstimate = deliveryEstimate.minDays !== null && deliveryEstimate.maxDays !== null;
const primaryText = t(locale, hasEstimate
  ? `Entrega estimada entre ${deliveryEstimate.minDays} e ${deliveryEstimate.maxDays} dias úteis.`
  : "A maioria dos sites institucionais pode ser entregue dentro do prazo definido na proposta, após o recebimento e a aprovação de todos os conteúdos.");
---

<section class="bg-[var(--surface)] px-6 pb-20 sm:pb-28">
  <div class="mx-auto max-w-3xl">
    <div
      data-animate
      class="flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/[0.02] p-6 sm:flex-row sm:items-start sm:gap-5 sm:p-7"
    >
      <span
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border text-[var(--accent)]"
        style="background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, var(--border));"
      >
        <Icon name="clock" class="h-5 w-5" />
      </span>
      <div>
        <h3 class="text-base font-semibold text-white">{t(locale, "Prazo estimado")}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{primaryText}</p>
        <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">
          {t(locale, "Projetos com catálogo, painel administrativo, agendamento ou integrações podem exigir prazo adicional.")}
        </p>
        <p class="mt-3 text-xs text-white/40">
          {t(locale, "O prazo começa após a aprovação do escopo e o recebimento dos materiais necessários.")}
        </p>
      </div>
    </div>
  </div>
</section>
