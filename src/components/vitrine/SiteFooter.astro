---
import CronosStartLogo from "../brand/CronosStartLogo.astro";
import Icon from "../ui/Icon.astro";
import { ecosystemItems } from "../../config/ecosystem";
import { company, buildWhatsappLink } from "../../config/company";

const whatsappGeneral = buildWhatsappLink(
  "Olá! Vi o portfólio de modelos da CronosStart e gostaria de saber mais sobre um site para minha empresa."
);

const currentYear = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-[var(--border)] bg-[var(--surface)] px-6 py-16 sm:py-20">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-48 w-[64rem] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-[0.08] blur-[110px]"
    style="background: var(--accent);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_1px_1fr_1px_1fr] lg:gap-10">
      <div>
        <CronosStartLogo imgClass="h-12 w-auto" />
        <p class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--accent)]">
          Presença digital para pequenas empresas
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-[var(--ink-muted)]">
          Sites profissionais, personalizados e preparados para representar sua empresa no digital.
        </p>
      </div>

      <div class="hidden self-stretch bg-[var(--border)] lg:block"></div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-white/50">Contato</h3>
        <ul class="mt-5 space-y-3.5 text-sm text-[var(--ink-muted)]">
          <li class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-[var(--accent)]">
              <Icon name="mail" class="h-4 w-4" />
            </span>
            {company.email}
          </li>
          <li class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-[var(--accent)]">
              <Icon name="arrow-right" class="h-4 w-4" />
            </span>
            <a href={company.website} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">{company.websiteDisplay}</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-[var(--accent)]">
              <Icon name="map-pin" class="h-4 w-4" />
            </span>
            {company.city}
          </li>
        </ul>
      </div>

      <div class="hidden self-stretch bg-[var(--border)] lg:block"></div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-white/50">Atendimento</h3>
        <p class="mt-5 text-sm leading-relaxed text-[var(--ink-muted)]">
          Atendimento em Blumenau, região, todo o Brasil e LATAM.
        </p>
        <a
          href={whatsappGeneral}
          target="_blank"
          rel="noopener noreferrer"
          data-ga-origin="footer"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#0F7A38] px-5 py-2.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 active:scale-[0.98]"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          Falar pelo WhatsApp
        </a>
      </div>
    </div>

    <div class="mt-14 border-t border-[var(--border)] pt-10">
      <h3 class="text-center text-xs font-semibold uppercase tracking-[0.16em] text-white/50 sm:text-left">
        Ecossistema CronosSec
      </h3>
      <p class="mt-2 max-w-xl text-center text-sm leading-relaxed text-[var(--ink-muted)] sm:text-left">
        A CronosStart faz parte de um ecossistema de soluções para segurança, tecnologia, diagnóstico e proteção de
        marca.
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          ecosystemItems.map((item) =>
            item.href ? (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="ecosystem-item ecosystem-item--link flex flex-col items-center gap-2 rounded-2xl border border-white/10 bg-white/[0.02] px-4 py-5 text-center transition-colors hover:border-[var(--accent)]/40"
              >
                <img
                  src={item.logo}
                  alt={item.name}
                  width={item.logoWidth}
                  height={item.logoHeight}
                  class="h-12 w-auto object-contain"
                  loading="lazy"
                  decoding="async"
                />
                <span class="text-sm font-semibold text-white">{item.name}</span>
                <span class="text-xs leading-snug text-[var(--ink-muted)]">{item.description}</span>
              </a>
            ) : (
              <div
                class="ecosystem-item flex flex-col items-center gap-2 rounded-2xl border border-white/10 bg-white/[0.02] px-4 py-5 text-center"
                aria-disabled="true"
              >
                <img
                  src={item.logo}
                  alt={item.name}
                  width={item.logoWidth}
                  height={item.logoHeight}
                  class="h-12 w-auto object-contain opacity-80"
                  loading="lazy"
                  decoding="async"
                />
                <span class="text-sm font-semibold text-white">{item.name}</span>
                <span class="text-xs leading-snug text-[var(--ink-muted)]">{item.description}</span>
                <span class="mt-1 inline-flex items-center rounded-full border border-white/10 bg-white/[0.03] px-2.5 py-0.5 text-[0.65rem] font-medium uppercase tracking-wide text-white/35">
                  Em breve
                </span>
              </div>
            )
          )
        }
      </div>
    </div>

    <div class="mt-10 border-t border-[var(--border)] pt-8">
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-white/60 sm:justify-start">
        <a href="/politica-de-privacidade" class="transition-colors hover:text-white">Política de Privacidade</a>
        <a href="/termos-de-uso" class="transition-colors hover:text-white">Termos de Uso</a>
        <a href="/criacao-de-sites-blumenau" class="transition-colors hover:text-white">Criação de sites em Blumenau</a>
        <a href="/sites-para-pequenas-empresas" class="transition-colors hover:text-white">Sites para pequenas empresas</a>
        <a href="/sites-com-painel-administrativo" class="transition-colors hover:text-white">Sites com painel administrativo</a>
        <a href="/sites-para-imobiliarias" class="transition-colors hover:text-white">Sites para imobiliárias</a>
      </div>
      <div class="mt-4 flex flex-col items-center gap-3 text-center sm:flex-row sm:justify-between sm:text-left">
        <p class="text-xs text-white/55">
          &copy; {currentYear} {company.name} — {company.legalNote}. Todos os direitos reservados.
        </p>
        <div class="flex items-center gap-1.5 text-xs text-white/50">
          <Icon name="shield-check" class="h-3.5 w-3.5" />
          Cada projeto com identidade própria
        </div>
      </div>
      <p class="mt-3 text-center text-xs text-white/50 sm:text-left">
        {company.address} — CEP {company.cep} | CNPJ {company.cnpj}
      </p>
    </div>
  </div>
</footer>
