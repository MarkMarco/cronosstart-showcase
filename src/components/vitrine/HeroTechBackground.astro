---
const clockCenter = { x: 170, y: 610 };
const clockRadii = { outer: 148, mid: 110, inner: 74 };

const ticks = Array.from({ length: 12 }, (_, i) => {
  const angle = (i / 12) * Math.PI * 2;
  const rOuter = clockRadii.outer + 12;
  const rInner = clockRadii.outer;
  return {
    x1: Math.round(Math.cos(angle) * rInner * 100) / 100,
    y1: Math.round(Math.sin(angle) * rInner * 100) / 100,
    x2: Math.round(Math.cos(angle) * rOuter * 100) / 100,
    y2: Math.round(Math.sin(angle) * rOuter * 100) / 100,
  };
});

const circuits = [
  { id: "circuit-l1", d: "M -20 160 L 110 160 L 110 70 L 260 70" },
  { id: "circuit-l2", d: "M -20 360 L 70 360 L 70 470 L 210 470 L 210 540" },
  { id: "circuit-l3", d: "M -20 640 L 130 640 L 130 560" },
  { id: "circuit-r1", d: "M 1460 140 L 1330 140 L 1330 230 L 1190 230", soft: true },
  { id: "circuit-r2", d: "M 1460 380 L 1370 380 L 1370 300 L 1230 300", soft: true },
  { id: "circuit-r3", d: "M 1460 660 L 1310 660 L 1310 570 L 1170 570 L 1170 500" },
  { id: "circuit-t1", d: "M 600 6 L 600 42 L 720 42" },
  { id: "circuit-b1", d: "M 780 794 L 780 750 L 900 750 L 900 715" },
  // Pequeno detalhe adicionado no canto superior esquerdo, para equilibrar
  // com o lado direito (mais carregado por cards, watermark e glow).
  { id: "circuit-tl-detail", d: "M 24 14 L 24 48 L 78 48" },
];

const nodes = [
  { cx: 110, cy: 70, breathe: true, breatheDelay: "0s" },
  { cx: 210, cy: 540 },
  { cx: 130, cy: 640 },
  { cx: 1330, cy: 230 },
  { cx: 1170, cy: 500 },
  { cx: 1310, cy: 660 },
  { cx: 78, cy: 48, breathe: true, breatheDelay: "-2.4s" },
];

const pulses = [
  { pathId: "circuit-l1", dur: "7s", begin: "0s" },
  { pathId: "circuit-r2", dur: "9s", begin: "-3s" },
  { pathId: "circuit-l3", dur: "6.5s", begin: "-1.5s" },
  { pathId: "circuit-r1", dur: "8s", begin: "-5s" },
  { pathId: "circuit-l2", dur: "10s", begin: "-2s", small: true },
];
---

<div class="hero-tech-bg pointer-events-none absolute inset-0 overflow-hidden" data-hero-tech aria-hidden="true">
  <svg
    class="hero-tech-svg h-full w-full"
    viewBox="0 0 1440 800"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Circuitos digitais -->
    <g class="tech-layer tech-layer-circuits" data-depth="10">
      {
        circuits.map((c) => (
          <path id={c.id} d={c.d} class={`circuit-path${c.soft ? " circuit-path-soft" : ""}`} fill="none" />
        ))
      }
      {
        nodes.map((n) => (
          <circle
            cx={n.cx}
            cy={n.cy}
            r="2.6"
            class={`circuit-node${n.breathe ? " circuit-node-breathe" : ""}`}
            style={n.breathe ? `animation-delay: ${n.breatheDelay};` : undefined}
          />
        ))
      }
      {
        pulses.map((p) => (
          <g class="circuit-pulse">
            <circle r={p.small ? 3.4 : 5} class="pulse-glow" />
            <circle r={p.small ? 1.2 : 1.7} class="pulse-core" />
            <animateMotion dur={p.dur} begin={p.begin} repeatCount="indefinite">
              <mpath href={`#${p.pathId}`} />
            </animateMotion>
          </g>
        ))
      }
    </g>

    <!-- Relógio abstrato -->
    <g class="tech-layer tech-layer-clock" data-depth="16">
      <g transform={`translate(${clockCenter.x} ${clockCenter.y})`}>
        <circle r={clockRadii.outer} class="clock-ring clock-ring-outer" />
        <circle r={clockRadii.mid} class="clock-ring clock-ring-mid" />
        <circle r={clockRadii.inner} class="clock-ring clock-ring-inner" />
        {
          ticks.map((t) => (
            <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="clock-tick" />
          ))
        }
        <line x1="0" y1="0" x2="0" y2={-clockRadii.mid + 15} class="clock-hand clock-hand-1">
          <animateTransform
            attributeName="transform"
            type="rotate"
            from="0 0 0"
            to="360 0 0"
            dur="140s"
            repeatCount="indefinite"
          />
        </line>
        <line x1="0" y1="0" x2="0" y2={-clockRadii.inner + 10} class="clock-hand clock-hand-2">
          <animateTransform
            attributeName="transform"
            type="rotate"
            from="0 0 0"
            to="-360 0 0"
            dur="95s"
            repeatCount="indefinite"
          />
        </line>
        <circle r="3" class="clock-pivot" />
      </g>
    </g>

    <!-- Símbolos tecnológicos discretos -->
    <g class="tech-layer tech-layer-symbols" data-depth="24">
      <text x="70" y="240" class="tech-symbol tech-symbol-code" style="animation-delay: 0ms; animation-duration: 11s;">
        &lt;/&gt;
      </text>
      <text
        x="1300"
        y="650"
        class="tech-symbol tech-symbol-code"
        style="animation-delay: 900ms; animation-duration: 13s;"
      >
        {"{ }"}
      </text>
      <g class="tech-symbol tech-symbol-node" style="animation-delay: 1600ms; animation-duration: 9s;" transform="translate(1245 115)">
        <circle cx="0" cy="0" r="3" />
        <circle cx="26" cy="14" r="3" />
        <line x1="0" y1="0" x2="26" y2="14" />
      </g>
      <g class="tech-symbol tech-symbol-node" style="animation-delay: 2400ms; animation-duration: 10s;" transform="translate(55 515)">
        <circle cx="0" cy="0" r="3" />
        <circle cx="-24" cy="18" r="3" />
        <line x1="0" y1="0" x2="-24" y2="18" />
      </g>
      <path
        d="M 1188 435 L 1188 455 L 1200 465 L 1215 455 L 1215 435 L 1200 425 Z M 1188 445 L 1215 445"
        class="tech-symbol tech-symbol-shield"
        style="animation-delay: 3200ms; animation-duration: 12s;"
      />
    </g>
  </svg>
</div>

<style>
  .hero-tech-svg {
    display: block;
    mix-blend-mode: screen;
    overflow: visible;
  }

  .circuit-path {
    stroke: var(--accent);
    stroke-width: 1.2;
    opacity: 0.16;
  }
  /* Lado direito levemente suavizado — reúne cards, watermark e glow;
     estas duas linhas competiam um pouco demais por atenção. */
  .circuit-path-soft {
    opacity: 0.1;
  }

  .circuit-node {
    fill: var(--accent);
    opacity: 0.3;
  }
  /* Brilho muito leve e lento em alguns nós — reforça a sensação de sistema vivo */
  .circuit-node-breathe {
    animation: node-breathe 5.5s ease-in-out infinite;
  }
  @keyframes node-breathe {
    0%, 100% {
      opacity: 0.24;
    }
    50% {
      opacity: 0.55;
    }
  }

  .pulse-glow {
    fill: var(--accent);
    opacity: 0.45;
    filter: blur(2.5px);
  }

  .pulse-core {
    fill: #eaf6ff;
    opacity: 0.85;
  }

  .clock-ring {
    fill: none;
    stroke: var(--accent);
  }
  .clock-ring-outer {
    opacity: 0.16;
    stroke-width: 1;
  }
  .clock-ring-mid {
    opacity: 0.12;
    stroke-width: 1;
    stroke: var(--primary);
  }
  .clock-ring-inner {
    opacity: 0.14;
    stroke-width: 1;
  }
  .clock-tick {
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.14;
  }
  .clock-hand {
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-linecap: round;
    opacity: 0.2;
  }
  .clock-hand-2 {
    stroke: var(--primary);
    opacity: 0.16;
  }
  .clock-pivot {
    fill: var(--accent);
    opacity: 0.22;
  }

  .tech-symbol-code {
    font-family: "Space Grotesk Variable", ui-monospace, monospace;
    font-size: 34px;
    fill: var(--accent);
    opacity: 0.16;
    animation-name: symbol-float;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .tech-symbol-node circle {
    fill: var(--accent);
    opacity: 0.28;
  }
  .tech-symbol-node line {
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.18;
  }
  .tech-symbol-node {
    animation-name: symbol-float;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .tech-symbol-shield {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.16;
    animation-name: symbol-float;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  @keyframes symbol-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }

  .tech-layer-symbols text,
  .tech-layer-symbols g {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (max-width: 640px) {
    .tech-layer-symbols {
      display: none;
    }
    .circuit-pulse {
      display: none;
    }
    .circuit-node-breathe {
      animation: none;
    }
    .hero-tech-bg {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-symbol-code,
    .tech-symbol-node,
    .tech-symbol-shield,
    .circuit-node-breathe {
      animation: none !important;
    }
  }
</style>

<script>
  const wrapper = document.querySelector<HTMLElement>("[data-hero-tech]");
  if (wrapper) {
    const svg = wrapper.querySelector("svg") as SVGSVGElement | null;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isSmallScreen = window.matchMedia("(max-width: 640px)").matches;

    if (svg && (prefersReducedMotion || isSmallScreen)) {
      svg.pauseAnimations();
    }

    const canParallax =
      !prefersReducedMotion && window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    if (canParallax) {
      const layers = wrapper.querySelectorAll<SVGGElement>("[data-depth]");
      const hero = wrapper.closest("section");
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;

      hero?.addEventListener("mousemove", (event) => {
        const rect = hero.getBoundingClientRect();
        targetX = (event.clientX - rect.left) / rect.width - 0.5;
        targetY = (event.clientY - rect.top) / rect.height - 0.5;
      });

      hero?.addEventListener("mouseleave", () => {
        targetX = 0;
        targetY = 0;
      });

      const tick = () => {
        currentX += (targetX - currentX) * 0.06;
        currentY += (targetY - currentY) * 0.06;
        layers.forEach((layer) => {
          const depth = Number(layer.dataset.depth ?? 0);
          layer.style.transform = `translate(${currentX * depth}px, ${currentY * depth}px)`;
        });
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
