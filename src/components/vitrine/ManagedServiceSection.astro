---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import Icon from "../ui/Icon.astro";

const locale = getLocale(Astro.url);
const deliverables = localizeDeep([
  {
    icon: "key" as const,
    title: "Domínio registrado e configurado",
    description: "Ajudamos na escolha e realizamos o registro do domínio em nome da sua empresa.",
  },
  {
    icon: "layers" as const,
    title: "Hospedagem preparada",
    description: "Configuramos a hospedagem, publicamos o site e deixamos toda a estrutura pronta para funcionar.",
  },
  {
    icon: "shield-check" as const,
    title: "Segurança e recursos técnicos",
    description: "Configuramos SSL e os recursos técnicos previstos no plano contratado.",
  },
  {
    icon: "message-circle" as const,
    title: "Suporte e acompanhamento",
    description: "Acompanhamos atualizações, renovações e necessidades futuras conforme o serviço contratado.",
  },
], locale);
---

<section id="servico-gerenciado" class="scroll-mt-24 relative overflow-hidden border-t border-[var(--border)] bg-[var(--surface-alt)] px-6 py-20 sm:py-28">
  <div
    class="pointer-events-none absolute -right-24 top-1/3 h-96 w-96 rounded-full opacity-[0.12] blur-[110px]"
    style="background: var(--primary);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-16">
      <div data-animate>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">{t(locale, "Serviço completo")}</p>
        <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          {t(locale, "Você cuida do seu negócio.")}<br class="hidden sm:block" /> {t(locale, "Nós cuidamos do site.")}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-[var(--ink-muted)]">
          {t(locale, "Não é necessário entender de domínio, hospedagem ou configurações técnicas. A CronosStart prepara,\n          publica e acompanha toda a estrutura necessária para manter sua empresa no digital.")}
        </p>

        <div class="mt-8 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
          <p class="flex items-start gap-2.5 text-sm leading-relaxed text-white/80">
            <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--accent)]" />
            {t(locale, "O cliente é dono do domínio e do projeto, mas não precisa administrar a parte técnica.")}
          </p>
        </div>

        <p class="mt-6 text-sm leading-relaxed text-white/40">
          {t(locale, "Plataformas oferecem ferramentas. A CronosStart entrega o serviço configurado, personalizado e acompanhado.")}
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {
          deliverables.map((item, index) => (
            <div
              data-animate
              style={`transition-delay: ${index * 70}ms; background: linear-gradient(160deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.01) 100%);`}
              class="relative overflow-hidden rounded-2xl border border-white/10 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:shadow-[0_20px_45px_-25px_rgba(56,189,248,0.35)]"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl border text-[var(--accent)]"
                style="background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, var(--border));"
              >
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
              <h3 class="mt-4 text-base font-semibold text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
