---
import type { ShowcaseSummary } from "../../config/showcases";

interface Props {
  item: ShowcaseSummary;
}
const { item } = Astro.props;
const initial = item.companyName.charAt(0);
---

<article class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition-transform duration-200 hover:-translate-y-1">
  <div class="overflow-hidden rounded-t-2xl border-b border-white/10" style={`background:${item.accentSoft}`}>
    <div class="flex items-center gap-1.5 px-4 py-2.5">
      <span class="h-2 w-2 rounded-full" style={`background:${item.accent}55`}></span>
      <span class="h-2 w-2 rounded-full" style={`background:${item.accent}55`}></span>
      <span class="h-2 w-2 rounded-full" style={`background:${item.accent}55`}></span>
    </div>
    <div class="relative px-4 pb-6 pt-1">
      <span
        class="pointer-events-none absolute -bottom-3 right-2 select-none text-7xl font-bold leading-none"
        style={`color:${item.accent}1a`}
        aria-hidden="true"
      >
        {initial}
      </span>
      <div class="h-2.5 w-2/5 rounded-full" style={`background:${item.accent}`}></div>
      <div class="mt-2.5 h-1.5 w-3/5 rounded-full" style={`background:${item.ink}22`}></div>
      <div class="mt-4 grid grid-cols-3 gap-2">
        <div class="h-9 rounded-lg bg-white/70"></div>
        <div class="h-9 rounded-lg bg-white/70"></div>
        <div class="h-9 rounded-lg bg-white/70"></div>
      </div>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em]" style={`color:${item.accent}`}>
      {item.segment}
    </p>
    <h3 class="mt-2 text-lg font-semibold text-white">{item.companyName}</h3>
    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-white/60">{item.shortDescription}</p>

    <div class="mt-6 flex items-center justify-between gap-3">
      {
        item.available ? (
          <a
            href={`/modelos/${item.slug}`}
            class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-black transition-transform hover:-translate-y-0.5"
          >
            Ver demonstração
          </a>
        ) : (
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-medium text-white/50">
            Em breve
          </span>
        )
      }
      <span class="text-xs text-white/40">Personalizável</span>
    </div>
  </div>
</article>
