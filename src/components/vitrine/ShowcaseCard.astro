---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import Icon from "../ui/Icon.astro";
import type { ShowcaseSummary } from "../../config/showcases";

const locale = getLocale(Astro.url);
interface Props {
  item: ShowcaseSummary;
  index?: number;
}
const { item, index = 0 } = localizeDeep(Astro.props, locale);

function hexToRgbTriplet(hex: string): string {
  const clean = hex.replace("#", "");
  const value = parseInt(clean, 16);
  const r = (value >> 16) & 255;
  const g = (value >> 8) & 255;
  const b = value & 255;
  return `${r}, ${g}, ${b}`;
}

const accentRgb = hexToRgbTriplet(item.accent);
const primaryRgb = hexToRgbTriplet(item.primary);

// Duração/atraso variam por índice para as animações idle não ficarem sincronizadas entre os 6 cards.
const breatheDuration = (7.5 + (index % 4) * 1.3).toFixed(1);
const gridDuration = (9 + (index % 5) * 1.1).toFixed(1);
const floatDuration = (12 + (index % 3) * 2.4).toFixed(1);
const floatDelay = (index * 0.6).toFixed(1);

const cardStyle = [
  `--card-accent: ${item.accent}`,
  `--card-accent-rgb: ${accentRgb}`,
  `--card-primary-rgb: ${primaryRgb}`,
  `--card-glow: 0 25px 60px -20px rgba(${accentRgb}, 0.38)`,
  `--breathe-duration: ${breatheDuration}s`,
  `--grid-duration: ${gridDuration}s`,
  `--float-duration: ${floatDuration}s`,
  `--float-delay: ${floatDelay}s`,
  `transition-delay: ${index * 60}ms`,
].join("; ");

const screenshotBase = `/images/showcases/${item.slug}/screenshot`;
const demoHref = localizedPath(`/modelos/${item.slug}`, locale);
---

<article data-animate data-tilt-card class="showcase-card group relative flex h-full flex-col overflow-hidden rounded-[1.25rem] border border-white/10 bg-white/[0.03]" style={cardStyle}>
  <noscript>
    <style>.showcase-card[data-animate] { opacity: 1; transform: none; }</style>
  </noscript>

  {
    item.premium && (
      <span class="absolute right-4 top-4 z-20 inline-flex items-center gap-1 rounded-full border border-white/15 bg-black/40 px-2.5 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.14em] text-white/80 backdrop-blur">
        <Icon name="sparkle" class="h-3 w-3 text-[var(--card-accent)]" />
        {t(locale, "Premium")}
      </span>
    )
  }

  <div class="card-visual relative aspect-[8/5] overflow-hidden border-b border-white/10">
    <div class="card-bg-gradient pointer-events-none absolute inset-0" aria-hidden="true" />
    <div class="card-grid pointer-events-none absolute inset-0" aria-hidden="true" />
    <Icon name={item.icon} class="card-icon pointer-events-none absolute -bottom-3 -right-3 h-24 w-24" />

    <div class="mockup-frame relative z-[1] mx-3 mt-3 overflow-hidden rounded-lg border border-white/10 bg-[#0b0e16] shadow-[0_20px_35px_-22px_rgba(0,0,0,0.7)]">
      <div class="flex items-center gap-1.5 border-b border-white/10 bg-white/[0.04] px-3 py-2">
        <span class="h-2 w-2 rounded-full bg-white/20"></span>
        <span class="h-2 w-2 rounded-full bg-white/20"></span>
        <span class="h-2 w-2 rounded-full bg-white/20"></span>
      </div>
      <div class="relative">
        <picture>
          <source srcset={`${screenshotBase}.webp`} type="image/webp" />
          <img
            src={`${screenshotBase}.jpg`}
            alt={`${t(locale, "Captura de tela real da demonstração")} ${item.companyName}`}
            width="960"
            height="600"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </picture>
        <span class="mockup-sheen pointer-events-none absolute inset-0" aria-hidden="true" />
      </div>
    </div>

    <span
      class="absolute bottom-3 left-4 z-10 rounded-full px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.14em]"
      style={`background: color-mix(in srgb, ${item.accent} 24%, transparent); color: ${item.accent}; backdrop-filter: blur(6px);`}
    >
      {item.segment}
    </span>
  </div>

  <div class="relative z-[1] flex flex-1 flex-col p-6">
    <h3 class="text-lg font-semibold tracking-tight text-white">{item.companyName}</h3>
    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-white/60">{item.shortDescription}</p>

    <div class="mt-6 flex items-center justify-between gap-3">
      {
        item.available ? (
          <a
            href={demoHref}
            aria-label={`${t(locale, "Ver demonstração de")} ${item.companyName}`}
            class="btn-demo group/btn inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-[#0a0e1a] transition-all hover:-translate-y-0.5"
          >
            {t(locale, "Ver demonstração")}
            <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform duration-300 group-hover/btn:translate-x-1" />
          </a>
        ) : (
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-medium text-white/50">
            {t(locale, "Em breve")}
          </span>
        )
      }
      <span class="personalizavel-tag inline-flex items-center gap-1 text-xs text-white/40">
        <Icon name="check" class="h-3.5 w-3.5 text-[var(--card-accent)]" />
        {t(locale, "Personalizável")}
      </span>
    </div>

    <button
      type="button"
      data-open-contact-form
      data-contact-model={item.companyName}
      data-contact-origin={`card-${item.slug}`}
      class="btn-lead group/link mt-4 inline-flex items-center gap-1.5 border-t border-white/10 pt-3.5 text-xs font-medium text-white/45 transition-colors"
    >
      {t(locale, "Quero um site como este")}
      <Icon name="arrow-right" class="h-3 w-3 transition-transform duration-300 group-hover/link:translate-x-1" />
    </button>
  </div>
</article>

<style>
  .showcase-card {
    --pointer-x: 50%;
    --pointer-y: 40%;
    --rotate-x: 0deg;
    --rotate-y: 0deg;
    --card-lift: 0px;
    --mockup-x: 0px;
    --mockup-y: 0px;
    --mockup-scale: 1;
    --icon-x: 0px;
    --icon-y: 0px;
    transform: perspective(1000px) translateY(var(--card-lift)) rotateX(var(--rotate-x)) rotateY(var(--rotate-y));
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s ease, border-color 0.3s ease;
  }

  .showcase-card:hover,
  .showcase-card:focus-within {
    --card-lift: -7px;
    --mockup-scale: 1.018;
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: var(--card-glow);
  }

  @media (hover: none) {
    .showcase-card:hover {
      --card-lift: 0px;
      --mockup-scale: 1;
      border-color: rgba(255, 255, 255, 0.1);
      box-shadow: none;
    }
  }

  .showcase-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    background: radial-gradient(circle at var(--pointer-x) var(--pointer-y), rgba(var(--card-accent-rgb), 0.16), transparent 35%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .showcase-card:hover::before,
  .showcase-card:focus-within::before {
    opacity: 1;
  }
  @media (hover: none) {
    .showcase-card:hover::before {
      opacity: 0;
    }
  }

  .card-bg-gradient {
    background:
      radial-gradient(135% 150% at 18% 0%, rgba(var(--card-accent-rgb), 0.28) 0%, transparent 55%),
      linear-gradient(160deg, rgba(var(--card-primary-rgb), 0.42) 0%, #05070d 130%);
    animation: card-breathe var(--breathe-duration) ease-in-out infinite;
  }
  @keyframes card-breathe {
    0%, 100% { opacity: 0.88; }
    50% { opacity: 1; }
  }

  .card-grid {
    opacity: 0.045;
    background-image: linear-gradient(rgba(255, 255, 255, 0.7) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.7) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(70% 70% at 50% 40%, black 0%, transparent 100%);
    -webkit-mask-image: radial-gradient(70% 70% at 50% 40%, black 0%, transparent 100%);
    animation: card-grid-pulse var(--grid-duration) ease-in-out infinite;
  }
  @keyframes card-grid-pulse {
    0%, 100% { opacity: 0.035; }
    50% { opacity: 0.085; }
  }

  .card-icon {
    color: rgba(255, 255, 255, 0.05);
    transform: translate(var(--icon-x), var(--icon-y));
    transition: transform 0.3s ease, color 0.3s ease;
    animation: card-icon-float var(--float-duration) ease-in-out var(--float-delay) infinite;
  }
  .showcase-card:hover .card-icon {
    color: rgba(var(--card-accent-rgb), 0.16);
  }
  @keyframes card-icon-float {
    0%, 100% { margin-top: 0; }
    50% { margin-top: -4px; }
  }

  .mockup-frame {
    transform: translate(var(--mockup-x), var(--mockup-y)) scale(var(--mockup-scale));
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .mockup-sheen {
    background: linear-gradient(115deg, transparent 40%, rgba(255, 255, 255, 0.16) 50%, transparent 60%);
    transform: translateX(-120%);
  }
  .showcase-card:hover .mockup-sheen {
    animation: sheen-sweep 1.1s ease forwards;
  }
  @keyframes sheen-sweep {
    from { transform: translateX(-120%); }
    to { transform: translateX(120%); }
  }

  .btn-demo:hover,
  .btn-demo:focus-visible {
    box-shadow: 0 12px 28px -10px rgba(var(--card-accent-rgb), 0.55);
  }

  .btn-lead:hover,
  .btn-lead:focus-visible {
    color: var(--card-accent);
  }

  .personalizavel-tag {
    transition: text-shadow 0.3s ease;
  }
  .showcase-card:hover .personalizavel-tag {
    text-shadow: 0 0 12px rgba(var(--card-accent-rgb), 0.35);
  }

  @media (max-width: 640px) {
    .card-bg-gradient,
    .card-grid,
    .card-icon {
      animation-duration: calc(var(--breathe-duration) * 1.6);
      opacity: 0.65;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>("[data-tilt-card]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canTilt = !prefersReducedMotion && window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (canTilt) {
    cards.forEach((card) => {
      let targetRX = 0;
      let targetRY = 0;
      let targetMX = 0;
      let targetMY = 0;
      let targetIX = 0;
      let targetIY = 0;
      let targetPX = 50;
      let targetPY = 40;

      let curRX = 0;
      let curRY = 0;
      let curMX = 0;
      let curMY = 0;
      let curIX = 0;
      let curIY = 0;
      let curPX = 50;
      let curPY = 40;

      let raf: number | null = null;

      const apply = () => {
        card.style.setProperty("--rotate-x", `${curRX.toFixed(2)}deg`);
        card.style.setProperty("--rotate-y", `${curRY.toFixed(2)}deg`);
        card.style.setProperty("--mockup-x", `${curMX.toFixed(2)}px`);
        card.style.setProperty("--mockup-y", `${curMY.toFixed(2)}px`);
        card.style.setProperty("--icon-x", `${curIX.toFixed(2)}px`);
        card.style.setProperty("--icon-y", `${curIY.toFixed(2)}px`);
        card.style.setProperty("--pointer-x", `${curPX.toFixed(2)}%`);
        card.style.setProperty("--pointer-y", `${curPY.toFixed(2)}%`);
      };

      const tick = () => {
        curRX += (targetRX - curRX) * 0.15;
        curRY += (targetRY - curRY) * 0.15;
        curMX += (targetMX - curMX) * 0.15;
        curMY += (targetMY - curMY) * 0.15;
        curIX += (targetIX - curIX) * 0.15;
        curIY += (targetIY - curIY) * 0.15;
        curPX += (targetPX - curPX) * 0.2;
        curPY += (targetPY - curPY) * 0.2;

        apply();

        const settled =
          Math.abs(targetRX - curRX) < 0.01 &&
          Math.abs(targetRY - curRY) < 0.01 &&
          Math.abs(targetMX - curMX) < 0.02 &&
          Math.abs(targetPX - curPX) < 0.05;

        raf = settled ? null : requestAnimationFrame(tick);
      };

      const startLoop = () => {
        if (raf === null) raf = requestAnimationFrame(tick);
      };

      card.addEventListener("pointermove", (event) => {
        const rect = card.getBoundingClientRect();
        const relX = (event.clientX - rect.left) / rect.width;
        const relY = (event.clientY - rect.top) / rect.height;

        targetRY = (relX - 0.5) * 6;
        targetRX = (0.5 - relY) * 6;
        targetMX = (relX - 0.5) * 12;
        targetMY = (relY - 0.5) * 10;
        targetIX = (relX - 0.5) * 4;
        targetIY = (relY - 0.5) * 4;
        targetPX = relX * 100;
        targetPY = relY * 100;

        startLoop();
      });

      card.addEventListener("pointerleave", () => {
        targetRX = 0;
        targetRY = 0;
        targetMX = 0;
        targetMY = 0;
        targetIX = 0;
        targetIY = 0;
        targetPX = 50;
        targetPY = 40;

        startLoop();
      });
    });
  }
</script>
