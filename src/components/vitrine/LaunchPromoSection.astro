---
import { getLocale } from "../../i18n/index";
import Icon from "../ui/Icon.astro";
const es = getLocale(Astro.url) === "es";
const copy = es ? {
  eyebrow: "Una forma sencilla de comenzar",
  title: "¿Quieres comenzar por tu cuenta?",
  text: "Crea una presencia profesional para tu negocio gratis. Elige una plantilla, personaliza tu información y publica.",
  note: "Launch es ideal para dar el primer paso. Los proyectos personalizados de CronosStart siguen disponibles para empresas que necesitan una solución a medida.",
  cta: "Crear mi sitio gratis",
} : {
  eyebrow: "Um jeito simples de começar",
  title: "Quer começar sozinho?",
  text: "Crie uma presença profissional para o seu negócio gratuitamente. Escolha um modelo, personalize suas informações e publique.",
  note: "O Launch é ideal para o primeiro passo. Os projetos personalizados da CronosStart continuam disponíveis para empresas que precisam de uma solução sob medida.",
  cta: "Criar meu site grátis",
};
const href = `/api/launch/start?locale=${es ? "es" : "pt"}&source=home`;
---
<section class="relative overflow-hidden border-y border-[var(--border)] bg-[var(--surface)] px-6 py-16 sm:py-20">
  <div class="pointer-events-none absolute left-1/2 top-0 h-64 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--accent)] opacity-10 blur-[100px]" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-8 rounded-[2rem] border border-white/10 bg-white/[.025] p-7 sm:p-10 lg:grid-cols-[1fr_auto]" data-animate>
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-[var(--accent)]">{copy.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{copy.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-[var(--ink-muted)]">{copy.text}</p>
      <p class="mt-3 text-sm leading-relaxed text-white/45">{copy.note}</p>
    </div>
    <a href={href} class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--primary)] px-7 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-0.5">
      {copy.cta}<Icon name="arrow-right" class="h-4 w-4"/>
    </a>
  </div>
</section>
