---
import Icon from "../ui/Icon.astro";
import { buildWhatsappLink } from "../../config/company";

const href = buildWhatsappLink(
  "Olá! Vi o portfólio de modelos da CronosStart e gostaria de saber mais sobre um site para minha empresa."
);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-whatsapp-floating
  class="fixed z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2"
  style="right: max(1.25rem, env(safe-area-inset-right)); bottom: max(1.25rem, calc(env(safe-area-inset-bottom) + 0.75rem));"
  aria-label="Falar no WhatsApp"
>
  <Icon name="whatsapp" class="h-7 w-7" />
</a>
