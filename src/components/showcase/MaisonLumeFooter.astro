---
import Icon from "../ui/Icon.astro";
import { company as cronosStart } from "../../config/company";
import type { NavItem, ShowcaseContact, CatalogCategory, CatalogCollection } from "../../config/showcases/types";

interface Props {
  nav: NavItem[];
  contact: ShowcaseContact;
  categories: CatalogCategory[];
  collections: CatalogCollection[];
}
const { nav, contact, categories, collections } = Astro.props;
const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---

<footer class="bg-[#211d1a] text-[#efe8dd]">
  <div class="mx-auto max-w-[1400px] px-6 py-14">
    <div class="grid gap-10 md:grid-cols-[1.3fr_0.8fr_0.8fr_0.9fr_0.9fr]">
      <div>
        <span class="inline-flex items-center gap-3">
          <svg viewBox="0 0 40 40" class="h-9 w-9 shrink-0" aria-hidden="true">
            <rect x="6" y="6" width="28" height="28" rx="2" fill="none" stroke="#efe8dd" stroke-width="1.6" />
            <path d="M13 27V15l7-4 7 4v12" fill="none" stroke="#c69a6d" stroke-width="1.6" stroke-linejoin="round" />
            <path d="M13 27h14" stroke="#efe8dd" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <span class="leading-tight">
            <span class="block font-[var(--font-heading)] text-xl font-semibold tracking-tight text-[#efe8dd]">Maison Lume</span>
            <span class="block -mt-1 text-[0.65rem] font-medium uppercase tracking-[0.2em] text-[#a89a8c]">Móveis &amp; decoração</span>
          </span>
        </span>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-[#a89a8c]">
          Curadoria de peças autorais para projetar ambientes com identidade própria. Modelo demonstrativo do portfólio da CronosStart.
        </p>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-2 text-xs font-semibold text-white transition-transform hover:-translate-y-0.5"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          Falar pelo WhatsApp
        </a>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[#efe8dd]">Navegação</h3>
        <ul class="mt-3 space-y-2">
          {nav.map((item) => (
            <li><a href={item.href} class="text-sm text-[#a89a8c] hover:text-[#efe8dd]">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[#efe8dd]">Categorias</h3>
        <ul class="mt-3 space-y-2">
          {categories.slice(0, 6).map((c) => (
            <li><a href={`#catalogo?categoria=${c.slug}`} class="text-sm text-[#a89a8c] hover:text-[#efe8dd]">{c.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[#efe8dd]">Coleções</h3>
        <ul class="mt-3 space-y-2">
          {collections.map((c) => (
            <li><a href={`#colecoes`} class="text-sm text-[#a89a8c] hover:text-[#efe8dd]">{c.name}</a></li>
          ))}
        </ul>
        <a href="/" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#c69a6d] hover:underline">
          Quero um projeto assim
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[#efe8dd]">Contato</h3>
        <ul class="mt-3 space-y-2 text-sm text-[#a89a8c]">
          <li class="flex items-center gap-2"><Icon name="map-pin" class="h-4 w-4 shrink-0" />{contact.city}/{contact.state}</li>
          <li class="flex items-center gap-2"><Icon name="mail" class="h-4 w-4 shrink-0" />{contact.email}</li>
          <li class="flex items-center gap-2"><Icon name="phone" class="h-4 w-4 shrink-0" />{contact.phone}</li>
          {contact.hours && <li class="flex items-center gap-2"><Icon name="clock" class="h-4 w-4 shrink-0" />{contact.hours}</li>}
        </ul>
        <div class="mt-3 flex items-center gap-3">
          {contact.instagram && <a href={contact.instagram} aria-label="Instagram" class="text-[#a89a8c] hover:text-[#efe8dd]"><Icon name="instagram" class="h-5 w-5" /></a>}
          {contact.facebook && <a href={contact.facebook} aria-label="Facebook" class="text-[#a89a8c] hover:text-[#efe8dd]"><Icon name="facebook" class="h-5 w-5" /></a>}
        </div>
        <a href="/modelos/moveis-decoracao/admin" class="mt-4 inline-block text-xs text-[#7d7166] hover:text-[#a89a8c]">
          Acesso administrativo (demonstrativo)
        </a>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-[#7d7166] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Maison Lume. Empresa fictícia usada apenas como demonstração.</p>
      <p>
        Modelo demonstrativo desenvolvido pela{" "}
        <a href={cronosStart.website} target="_blank" rel="noopener noreferrer" class="font-medium text-[#a89a8c] hover:text-[#efe8dd]">
          CronosStart
        </a>
      </p>
    </div>
  </div>
</footer>
