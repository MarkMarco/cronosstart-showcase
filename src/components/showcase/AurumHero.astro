---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import type { VehicleSearchContent } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  image: string;
  imageAlt: string;
  eyebrow?: string;
  headline: string;
  highlight?: string;
  subheadline: string;
  ctaPrimaryLabel: string;
  ctaPrimaryHref: string;
  ctaSecondaryLabel?: string;
  ctaSecondaryHref?: string;
  search?: VehicleSearchContent;
  searchActionHref?: string;
}
const {
  image,
  imageAlt,
  eyebrow,
  headline,
  highlight,
  subheadline,
  ctaPrimaryLabel,
  ctaPrimaryHref,
  ctaSecondaryLabel,
  ctaSecondaryHref,
  search,
  searchActionHref = t(locale, "/modelos/aurum-motors/estoque"),
} = localizeDeep(Astro.props, locale);
---

<section class="relative overflow-hidden bg-[var(--surface)]">
  <div class="absolute inset-0">
    <img src={image} alt={imageAlt} class="h-full w-full object-cover" loading="eager" decoding="async" />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, rgba(19,18,17,0.55) 0%, rgba(19,18,17,0.82) 55%, var(--surface) 100%);"
      aria-hidden="true"
    ></div>
  </div>

  <div class="relative mx-auto max-w-3xl px-6 pb-20 pt-24 text-center sm:pb-24 sm:pt-32">
    {eyebrow && (
      <p class="animate-hero-in mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)] backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
        {eyebrow}
      </p>
    )}
    <h1 class="animate-hero-in text-4xl font-semibold leading-[1.12] tracking-tight text-white sm:text-5xl" style="animation-delay: 60ms">
      {headline} <span class="text-[var(--accent)]">{highlight}</span>
    </h1>
    <p class="animate-hero-in mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/70" style="animation-delay: 120ms">
      {subheadline}
    </p>
    <div class="animate-hero-in mt-8 flex flex-wrap justify-center gap-4" style="animation-delay: 180ms">
      <a
        href={ctaPrimaryHref}
        class="inline-flex items-center justify-center rounded-[var(--radius-control)] bg-[var(--primary)] px-7 py-3.5 text-sm font-semibold text-[var(--primary-ink)] shadow-sm transition-transform hover:-translate-y-0.5"
      >
        {ctaPrimaryLabel}
      </a>
      {ctaSecondaryLabel && ctaSecondaryHref && (
        <a
          href={ctaSecondaryHref}
          class="inline-flex items-center justify-center rounded-[var(--radius-control)] border border-white/20 px-7 py-3.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          {ctaSecondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>

{search && (
  <div class="animate-hero-in relative z-10 mx-auto -mt-12 max-w-4xl px-6 sm:-mt-16" style="animation-delay: 220ms">
    <form
      data-vehicle-search
      action={searchActionHref}
      class="grid gap-3 rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-5 shadow-[0_25px_60px_rgba(0,0,0,0.35)] sm:grid-cols-[1fr_1fr_1fr_auto] sm:p-6"
    >
      <label class="block text-left text-xs font-medium text-[var(--ink-muted)]">
        {t(locale, "Categoria")}
        <select
          name="category"
          class="mt-1 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"
        >
          {search.categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>
      <label class="block text-left text-xs font-medium text-[var(--ink-muted)]">
        {t(locale, "Faixa de preço")}
        <select
          name="price"
          class="mt-1 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"
        >
          {search.priceRanges.map((range) => <option value={range}>{range}</option>)}
        </select>
      </label>
      <label class="block text-left text-xs font-medium text-[var(--ink-muted)]">
        {t(locale, "Marca")}
        <select
          name="brand"
          class="mt-1 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"
        >
          {search.brands.map((brand) => <option value={brand}>{brand}</option>)}
        </select>
      </label>
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-control)] bg-[var(--primary)] px-6 py-2.5 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5 sm:mt-[1.375rem]"
      >
        {t(locale, "Buscar")}
      </button>
    </form>
    <p class="mt-3 text-center text-[0.7rem] text-[var(--ink-muted)]">{t(locale, "Busca demonstrativa, apenas para fins de portfólio.")}</p>
  </div>
)}
