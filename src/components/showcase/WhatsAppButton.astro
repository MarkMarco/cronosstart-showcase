---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import Icon from "../ui/Icon.astro";
import type { ShowcaseContact } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  contact: ShowcaseContact;
  /** "neutral" usa fundo grafite com verde só no hover — opcional, não altera o padrão dos outros modelos. */
  variant?: "green" | "neutral";
}
const { contact, variant = "green" } = localizeDeep(Astro.props, locale);
const href = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(contact.whatsappMessage)}`;
const variantClass =
  variant === "neutral"
    ? "bg-[var(--ink)] hover:bg-[#25D366]"
    : "bg-[#25D366] hover:bg-[#20bd5a]";
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`fixed bottom-5 right-5 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full text-white shadow-lg transition-colors transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 ${variantClass}`}
  aria-label={`Falar no WhatsApp (número demonstrativo ${contact.whatsappNumber})`}
>
  <Icon name="whatsapp" class="h-7 w-7" />
</a>
