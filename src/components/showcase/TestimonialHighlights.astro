---
import Icon from "../ui/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import type { Testimonial } from "../../config/showcases/types";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: Testimonial[];
}
const { eyebrow, title, description, items } = Astro.props;

const initialsOf = (name: string) =>
  name
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("")
    .toUpperCase();
---

<section class="bg-[var(--surface-alt)] px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow={eyebrow} title={title} description={description} align="center" class="mx-auto" />

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {
        items.map((item, index) => (
          <figure
            data-animate
            style={`transition-delay: ${index * 70}ms`}
            class="relative flex flex-col overflow-hidden rounded-2xl bg-[var(--surface)] p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)]"
          >
            <span
              class="pointer-events-none absolute -right-3 -top-5 select-none text-8xl font-bold leading-none text-[var(--primary)]/5"
              aria-hidden="true"
            >
              "
            </span>
            <span class="relative inline-flex w-fit items-center gap-1.5 rounded-full bg-[var(--primary)]/8 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-[var(--primary)]">
              {item.segment}
            </span>

            <blockquote class="relative mt-4 flex-1 text-base leading-relaxed text-[var(--ink)]">
              "{item.quote}"
            </blockquote>

            <div class="relative mt-5 flex items-center gap-3 border-t border-[var(--border)] pt-4">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--accent)] text-xs font-semibold text-white">
                {initialsOf(item.author)}
              </span>
              <div class="leading-tight">
                <span class="block text-sm font-semibold text-[var(--ink)]">{item.author}</span>
                <span class="inline-flex items-center gap-1 text-xs text-[var(--accent)]">
                  <Icon name="check" class="h-3 w-3" />
                  {item.result}
                </span>
              </div>
            </div>
          </figure>
        ))
      }
    </div>

    <p class="mt-6 text-center text-xs text-[var(--ink-muted)]">
      Depoimentos ilustrativos, criados para fins de demonstração deste modelo.
    </p>
  </div>
</section>
