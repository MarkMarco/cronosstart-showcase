---
import { getLocale, localizedPath, localizeDeep, t } from "../../../i18n/index";
// Composição editorial em camadas (sem fotos reais) para o hero da Maison
// Lume — segue o mesmo princípio de ilustração CSS/SVG já usado em
// AccountingHeroVisual/HorizonteHeroVisual, adaptado para um mood board de
// produto em vez de um diagrama de linhas.
import ProductVisual from "../ProductVisual.astro";
import Icon from "../../ui/Icon.astro";

const locale = getLocale(Astro.url);---

<div class="relative mx-auto aspect-square w-full max-w-md">
  <div class="absolute inset-x-6 inset-y-2 overflow-hidden rounded-[var(--radius-card)] shadow-[0_30px_60px_-20px_rgba(43,38,33,0.25)]">
    <ProductVisual tone="sand" icon="sofa" iconClass="h-20 w-20" />
  </div>

  <div class="absolute -left-3 bottom-6 w-2/5 overflow-hidden rounded-[var(--radius-card)] border-4 border-[var(--surface)] shadow-[0_20px_40px_-15px_rgba(43,38,33,0.3)]">
    <ProductVisual tone="clay" icon="lamp" iconClass="h-10 w-10" />
  </div>

  <div class="absolute -right-3 top-6 w-2/5 overflow-hidden rounded-[var(--radius-card)] border-4 border-[var(--surface)] shadow-[0_20px_40px_-15px_rgba(43,38,33,0.3)]">
    <ProductVisual tone="walnut" icon="palette" iconClass="h-10 w-10" />
  </div>

  <div class="absolute bottom-2 right-2 flex items-center gap-2 rounded-full bg-[var(--surface)] px-4 py-2 shadow-md">
    <Icon name="sparkle" class="h-4 w-4 text-[var(--accent)]" />
    <span class="text-xs font-medium text-[var(--ink)]">{t(locale, "17 peças no catálogo")}</span>
  </div>
</div>
