---
import type { NavItem, ShowcaseCompany, ShowcaseContact } from "../../config/showcases/types";
import Icon from "../ui/Icon.astro";

interface Props {
  company: ShowcaseCompany;
  nav: NavItem[];
  contact: ShowcaseContact;
}
const { company, nav, contact } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] bg-[var(--surface-alt)]">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class="grid gap-8 md:grid-cols-[1.3fr_0.8fr_1fr_0.7fr]">
      <div>
        <slot name="logo" />
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-[var(--ink-muted)]">
          {company.description}
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[var(--ink)]">Navegação</h3>
        <ul class="mt-3 space-y-2">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-[var(--ink-muted)] hover:text-[var(--accent)]">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[var(--ink)]">Contato</h3>
        <ul class="mt-3 space-y-2 text-sm text-[var(--ink-muted)]">
          <li class="flex items-center gap-2">
            <Icon name="map-pin" class="h-4 w-4 shrink-0" />
            {contact.city}/{contact.state}
          </li>
          <li class="flex items-center gap-2">
            <Icon name="mail" class="h-4 w-4 shrink-0" />
            {contact.email}
          </li>
          <li class="flex items-center gap-2">
            <Icon name="phone" class="h-4 w-4 shrink-0" />
            {contact.phone}
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[var(--ink)]">Redes</h3>
        <div class="mt-3 flex items-center gap-3">
          {
            contact.instagram && (
              <a href={contact.instagram} aria-label="Instagram" class="text-[var(--ink-muted)] hover:text-[var(--accent)]">
                <Icon name="instagram" class="h-5 w-5" />
              </a>
            )
          }
          {
            contact.facebook && (
              <a href={contact.facebook} aria-label="Facebook" class="text-[var(--ink-muted)] hover:text-[var(--accent)]">
                <Icon name="facebook" class="h-5 w-5" />
              </a>
            )
          }
          {
            contact.linkedin && (
              <a href={contact.linkedin} aria-label="LinkedIn" class="text-[var(--ink-muted)] hover:text-[var(--accent)]">
                <Icon name="linkedin" class="h-5 w-5" />
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-2 border-t border-[var(--border)] pt-5 text-xs text-[var(--ink-muted)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {company.name}. Empresa fictícia usada apenas como demonstração.</p>
      <p>
        Modelo demonstrativo desenvolvido pela{" "}
        <a href="https://www.cronossec.com.br" class="font-medium text-[var(--ink)] hover:text-[var(--accent)]">
          CronosStart
        </a>
      </p>
    </div>
  </div>
</footer>
