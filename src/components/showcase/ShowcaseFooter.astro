---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import type { NavItem, ShowcaseCompany, ShowcaseContact } from "../../config/showcases/types";
import Icon from "../ui/Icon.astro";
import { company as cronosStart } from "../../config/company";

const locale = getLocale(Astro.url);
interface Props {
  company: ShowcaseCompany;
  nav: NavItem[];
  contact: ShowcaseContact;
  /** Coluna extra opcional (ex.: categorias de catálogo + link "projeto semelhante"). Não afeta os modelos que não a usam. */
  extraColumn?: { title: string; links: { label: string; href: string }[] };
  /** Exibe contact.hours na coluna de contato. Falso por padrão para não alterar os modelos existentes. */
  showHours?: boolean;
}
const { company, nav, contact, extraColumn, showHours = false } = localizeDeep(Astro.props, locale);
const year = new Date().getFullYear();
const gridColsClass = extraColumn ? "md:grid-cols-[1.1fr_0.7fr_0.7fr_0.9fr_0.7fr]" : "md:grid-cols-[1.3fr_0.8fr_1fr_0.7fr]";
---

<footer class="border-t border-[var(--border)] bg-[var(--surface-alt)]">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class={`grid gap-8 ${gridColsClass}`}>
      <div>
        <slot name="logo" />
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-[var(--ink-muted)]">
          {company.description}
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[var(--ink)]">{t(locale, "Navegação")}</h3>
        <ul class="mt-3 space-y-2">
          {
            nav.map((item) => (
              <li>
                <a href={localizedPath(item.href, locale)} class="text-sm text-[var(--ink-muted)] hover:text-[var(--accent)]">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {extraColumn && (
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-[var(--ink)]">{extraColumn.title}</h3>
          <ul class="mt-3 space-y-2">
            {extraColumn.links.map((link) => (
              <li>
                <a href={localizedPath(link.href, locale)} class="text-sm text-[var(--ink-muted)] hover:text-[var(--accent)]">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[var(--ink)]">{t(locale, "Contato")}</h3>
        <ul class="mt-3 space-y-2 text-sm text-[var(--ink-muted)]">
          <li class="flex items-center gap-2">
            <Icon name="map-pin" class="h-4 w-4 shrink-0" />
            {contact.city}/{contact.state}
          </li>
          <li class="flex items-center gap-2">
            <Icon name="mail" class="h-4 w-4 shrink-0" />
            {contact.email}
          </li>
          <li class="flex items-center gap-2">
            <Icon name="phone" class="h-4 w-4 shrink-0" />
            {contact.phone}
          </li>
          {showHours && contact.hours && (
            <li class="flex items-center gap-2">
              <Icon name="clock" class="h-4 w-4 shrink-0" />
              {contact.hours}
            </li>
          )}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[var(--ink)]">{t(locale, "Redes")}</h3>
        <div class="mt-3 flex items-center gap-3">
          {
            contact.instagram && (
              <a href={contact.instagram} aria-label={t(locale, "Instagram")} class="text-[var(--ink-muted)] hover:text-[var(--accent)]">
                <Icon name="instagram" class="h-5 w-5" />
              </a>
            )
          }
          {
            contact.facebook && (
              <a href={contact.facebook} aria-label={t(locale, "Facebook")} class="text-[var(--ink-muted)] hover:text-[var(--accent)]">
                <Icon name="facebook" class="h-5 w-5" />
              </a>
            )
          }
          {
            contact.linkedin && (
              <a href={contact.linkedin} aria-label={t(locale, "LinkedIn")} class="text-[var(--ink-muted)] hover:text-[var(--accent)]">
                <Icon name="linkedin" class="h-5 w-5" />
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-2 border-t border-[var(--border)] pt-5 text-xs text-[var(--ink-muted)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {company.name}. {t(locale, "Empresa fictícia usada apenas como demonstração.")}</p>
      <p>
        {t(locale, "Modelo demonstrativo desenvolvido pela")}{" "}
        <a href={cronosStart.website} target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--ink)] hover:text-[var(--accent)]">
          {t(locale, "CronosStart")}
        </a>
      </p>
    </div>
  </div>
</footer>
