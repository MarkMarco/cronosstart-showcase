---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import type { CtaBand } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  cta: CtaBand;
  id?: string;
}
const { cta, id } = localizeDeep(Astro.props, locale);

const timeSlots = localizeDeep(["12:00", "12:30", "13:00", "19:00", "19:30", "20:00", "20:30", "21:00"], locale);
const partySizes = localizeDeep(["1–2 pessoas", "3–4 pessoas", "5–6 pessoas", "7+ pessoas"], locale);
---

<section id={id} class="bg-[var(--surface)] px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-xl text-center" data-animate>
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{t(locale, "Reservas")}</p>
    <h2 class="font-[var(--font-heading)] text-3xl font-medium tracking-tight text-[var(--ink)] sm:text-4xl">
      {cta.title}
    </h2>
    <p class="mt-4 text-base leading-relaxed text-[var(--ink-muted)]">{cta.description}</p>
  </div>

  <form
    data-reservation-form
    data-animate
    style="transition-delay: 80ms"
    class="mx-auto mt-10 max-w-2xl rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-6 shadow-sm sm:p-8"
  >
    <p class="mb-5 text-center text-xs font-medium uppercase tracking-wide text-[var(--ink-muted)]">
      {t(locale, "Formulário demonstrativo — não envia dados")}
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
        {t(locale, "Nome")}
        <input
          type="text"
          name="name"
          required
          class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/15"
        />
      </label>
      <label class="block text-sm font-medium text-[var(--ink)]">
        {t(locale, "WhatsApp")}
        <input
          type="tel"
          name="whatsapp"
          required
          placeholder="(00) 00000-0000"
          class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/15"
        />
      </label>
      <label class="block text-sm font-medium text-[var(--ink)]">
        {t(locale, "E-mail")}
        <input
          type="email"
          name="email"
          class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/15"
        />
      </label>
      <label class="block text-sm font-medium text-[var(--ink)]">
        {t(locale, "Data")}
        <input
          type="text"
          inputmode="numeric"
          name="date"
          required
          placeholder={t(locale, "dd/mm/aaaa")}
          pattern="\d{2}/\d{2}/\d{4}"
          maxlength="10"
          data-date-input
          class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/15"
        />
      </label>
      <label class="block text-sm font-medium text-[var(--ink)]">
        {t(locale, "Horário")}
        <select
          name="time"
          required
          class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/15"
        >
          {timeSlots.map((slot) => (
            <option value={slot}>{slot}</option>
          ))}
        </select>
      </label>
      <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
        {t(locale, "Número de pessoas")}
        <select
          name="partySize"
          required
          class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/15"
        >
          {partySizes.map((size) => (
            <option value={size}>{size}</option>
          ))}
        </select>
      </label>
      <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
        {t(locale, "Observações")}
        <textarea
          name="notes"
          rows="3"
          placeholder={t(locale, "Alguma preferência ou ocasião especial?")}
          class="mt-1.5 w-full resize-none rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/15"
        ></textarea>
      </label>
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-full bg-[var(--primary)] px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 sm:col-span-2"
      >
        {cta.buttonLabel}
      </button>
      <p data-reservation-feedback role="status" class="hidden text-center text-sm font-medium text-[var(--accent)] sm:col-span-2">
        {t(locale, "Reserva de demonstração recebida — nenhum dado foi enviado de verdade.")}
      </p>
    </div>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-reservation-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const feedback = form.querySelector("[data-reservation-feedback]");
      feedback?.classList.remove("hidden");
    });
  });

  document.querySelectorAll<HTMLInputElement>("[data-date-input]").forEach((input) => {
    input.addEventListener("input", () => {
      const digits = input.value.replace(/\D/g, "").slice(0, 8);
      let formatted = digits;
      if (digits.length > 4) {
        formatted = `${digits.slice(0, 2)}/${digits.slice(2, 4)}/${digits.slice(4)}`;
      } else if (digits.length > 2) {
        formatted = `${digits.slice(0, 2)}/${digits.slice(2)}`;
      }
      input.value = formatted;
    });
  });
</script>
