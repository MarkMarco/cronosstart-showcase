---
// Profissionais fictícios — cartões com foto de tratamento uniforme, área
// principal, resumo, idiomas, formação demonstrativa e CTA de atendimento.
// Nunca exibe número de registro real (usa `registrationNote` textual).
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import type { LegalProfessional, PracticeArea } from "../../config/showcases/types";

interface Props {
  id?: string;
  professionals: LegalProfessional[];
  areas: PracticeArea[];
  ctaHref: string;
}
const { id, professionals, areas, ctaHref } = Astro.props;
const active = professionals.filter((p) => p.active).sort((a, b) => a.order - b.order);

function areaTitle(slug: string) {
  return areas.find((a) => a.slug === slug)?.title ?? slug;
}
---

<section id={id} class="bg-[var(--surface)] px-6 py-16 sm:py-24">
  <div class="mx-auto max-w-[1300px]">
    <SectionHeader
      eyebrow="Profissionais"
      title="Uma equipe fictícia, criada para este modelo"
      description="Nomes, fotos e trajetórias são inteiramente demonstrativos — nenhum profissional real está associado a este site."
    />

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        active.map((person, i) => (
          <div data-animate data-professional-card={person.slug} style={`transition-delay:${i * 60}ms`} class="group overflow-hidden rounded-[1.25rem] border border-[var(--border)] bg-[var(--surface-alt)]">
            <div class="relative aspect-[4/3] overflow-hidden">
              {person.photo ? (
                <img src={person.photo} alt={person.photoAlt ?? person.name} class="h-full w-full object-cover" loading="lazy" decoding="async" />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-[var(--primary)]/10 text-[var(--primary)]">
                  <Icon name="users" class="h-10 w-10" />
                </div>
              )}
              <span class="absolute left-3 top-3 rounded-full bg-[#120F10]/80 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-[#E2C98C]">
                {areaTitle(person.mainArea)}
              </span>
            </div>
            <div class="p-5">
              <h3 class="font-[var(--font-heading)] text-lg font-semibold text-[var(--ink)]">{person.name}</h3>
              <p class="mt-0.5 text-xs font-medium uppercase tracking-wide text-[var(--accent)]">{person.role}</p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">{person.summary}</p>

              <dl class="mt-4 space-y-1.5 text-xs text-[var(--ink-muted)]">
                <div class="flex gap-1.5"><dt class="font-semibold text-[var(--ink)]">Idiomas:</dt><dd>{person.languages.join(", ")}</dd></div>
                <div class="flex gap-1.5"><dt class="font-semibold text-[var(--ink)]">Formação:</dt><dd>{person.education.join(" · ")}</dd></div>
              </dl>
              <p class="mt-3 text-[0.7rem] italic text-[var(--ink-muted)]/80">
                {person.registrationNote ?? "Registro profissional demonstrativo"}
              </p>

              <a href={ctaHref} class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--primary)] hover:underline">
                Solicitar atendimento
                <Icon name="arrow-right" class="h-3.5 w-3.5" />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
