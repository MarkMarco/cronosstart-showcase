---
import Icon from "../ui/Icon.astro";
import type { PropertySearchContent } from "../../config/showcases/types";

interface Props {
  eyebrow?: string;
  headline: string;
  highlight?: string;
  subheadline: string;
  ctaPrimaryLabel: string;
  ctaPrimaryHref: string;
  search: PropertySearchContent;
  searchTargetId: string;
}
const { eyebrow, headline, highlight, subheadline, ctaPrimaryLabel, ctaPrimaryHref, search, searchTargetId } =
  Astro.props;
---

<section class="relative overflow-hidden bg-[var(--primary)] pb-16 pt-16 sm:pb-20 sm:pt-20">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.06]"
    style="background-image: repeating-linear-gradient(0deg, white 0, white 1px, transparent 1px, transparent 64px), repeating-linear-gradient(90deg, white 0, white 1px, transparent 1px, transparent 64px);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-3xl px-6 text-center">
    {eyebrow && (
      <p class="animate-hero-in mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--accent)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
        {eyebrow}
      </p>
    )}
    <h1 class="animate-hero-in text-4xl font-semibold leading-[1.12] tracking-tight text-white sm:text-5xl" style="animation-delay: 60ms">
      {headline}{" "}
      {highlight && <span class="text-[var(--accent)]">{highlight}</span>}
    </h1>
    <p class="animate-hero-in mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/65" style="animation-delay: 120ms">
      {subheadline}
    </p>
    <div class="animate-hero-in mt-8" style="animation-delay: 180ms">
      <a
        href={ctaPrimaryHref}
        class="inline-flex items-center justify-center rounded-[var(--radius-control)] bg-[var(--accent)] px-7 py-3.5 text-sm font-semibold text-white shadow-sm transition-transform hover:-translate-y-0.5"
      >
        {ctaPrimaryLabel}
      </a>
    </div>
  </div>
</section>

<div class="animate-hero-in relative z-10 mx-auto -mt-20 max-w-4xl px-6 sm:-mt-24" style="animation-delay: 220ms">
  <form
    data-property-search
    class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 shadow-[0_25px_60px_rgba(0,0,0,0.22)] sm:p-6"
  >
    <div class="flex flex-wrap gap-2" role="group" aria-label="Tipo de operação">
      {
        search.operationOptions.map((op, index) => (
          <button
            type="button"
            data-op-toggle
            aria-pressed={index === 0}
            class="rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--ink-muted)] transition-colors aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--primary)] aria-pressed:text-white"
          >
            {op}
          </button>
        ))
      }
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
      <label class="block text-left text-xs font-medium text-[var(--ink-muted)]">
        Região
        <select
          name="region"
          class="mt-1 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"
        >
          {search.regions.map((region) => (
            <option value={region}>{region}</option>
          ))}
        </select>
      </label>
      <label class="block text-left text-xs font-medium text-[var(--ink-muted)]">
        Tipo de imóvel
        <select
          name="type"
          class="mt-1 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"
        >
          {search.propertyTypes.map((type) => (
            <option value={type}>{type}</option>
          ))}
        </select>
      </label>
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-control)] bg-[var(--primary)] px-6 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 sm:mt-[1.375rem]"
      >
        <Icon name="search" class="h-4 w-4" />
        Buscar
      </button>
    </div>
    <p class="mt-3 text-left text-[0.7rem] text-[var(--ink-muted)]">Busca demonstrativa, apenas para fins de portfólio.</p>
  </form>
</div>

<script define:vars={{ searchTargetId }}>
  const toggles = document.querySelectorAll("[data-op-toggle]");
  toggles.forEach((button) => {
    button.addEventListener("click", () => {
      toggles.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
    });
  });

  const form = document.querySelector("[data-property-search]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    document.getElementById(searchTargetId)?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
</script>
