---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
// Footer premium da Vallora Advocacia — vinho muito escuro/grafite com
// detalhes dourados discretos, link de acesso administrativo e CTA
// "quero um site como este" (não reaproveita o ShowcaseFooter genérico).
import Icon from "../ui/Icon.astro";
import ValloraLogo from "../logos/ValloraLogo.astro";
import { company as cronosStart } from "../../config/company";
import type { NavItem, ShowcaseContact, PracticeArea } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  nav: NavItem[];
  contact: ShowcaseContact;
  areas: PracticeArea[];
}
const { nav, contact, areas } = localizeDeep(Astro.props, locale);
const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---

<footer class="relative overflow-hidden bg-[#120F10] text-[#F5F0E8]">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#C7A35A]/50 to-transparent" />
  <div class="pointer-events-none absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-[#4A0F1D] opacity-40 blur-[110px]" />

  <div class="relative mx-auto max-w-[1400px] px-6 py-14">
    <div class="grid gap-10 md:grid-cols-[1.2fr_0.85fr_0.85fr_0.95fr]">
      <div>
        <ValloraLogo tone="light" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-[#F5F0E8]/50">
          {t(locale, "Escritório de advocacia fictício — modelo demonstrativo do portfólio CronosStart. Nomes, casos e dados são inteiramente ilustrativos.")}
        </p>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-2 text-xs font-semibold text-white transition-transform hover:-translate-y-0.5">
          <Icon name="whatsapp" class="h-4 w-4" />
          {t(locale, "Falar pelo WhatsApp")}
        </a>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[#F5F0E8]/70">{t(locale, "Navegação")}</h3>
        <ul class="mt-3 space-y-2">
          {nav.map((item) => (
            <li><a href={localizedPath(item.href, locale)} class="text-sm text-[#F5F0E8]/50 hover:text-[#E2C98C]">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[#F5F0E8]/70">{t(locale, "Áreas de atuação")}</h3>
        <ul class="mt-3 space-y-2">
          {areas.filter((a) => a.active).slice(0, 6).map((a) => (
            <li><a href="#areas" class="text-sm text-[#F5F0E8]/50 hover:text-[#E2C98C]">{a.title}</a></li>
          ))}
        </ul>
        <a href={localizedPath("/", locale)} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#E2C98C] hover:underline">
          {t(locale, "Quero um site como este")}
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-[#F5F0E8]/70">{t(locale, "Contato")}</h3>
        <ul class="mt-3 space-y-2 text-sm text-[#F5F0E8]/50">
          <li class="flex items-center gap-2"><Icon name="map-pin" class="h-4 w-4 shrink-0" />{contact.city}/{contact.state}</li>
          <li class="flex items-center gap-2"><Icon name="mail" class="h-4 w-4 shrink-0" />{contact.email}</li>
          <li class="flex items-center gap-2"><Icon name="phone" class="h-4 w-4 shrink-0" />{contact.phone}</li>
          {contact.hours && <li class="flex items-center gap-2"><Icon name="clock" class="h-4 w-4 shrink-0" />{contact.hours}</li>}
        </ul>
        <div class="mt-3 flex items-center gap-3">
          {contact.instagram && <a href={contact.instagram} aria-label={t(locale, "Instagram")} class="text-[#F5F0E8]/50 hover:text-[#E2C98C]"><Icon name="instagram" class="h-5 w-5" /></a>}
          {contact.linkedin && <a href={contact.linkedin} aria-label={t(locale, "LinkedIn")} class="text-[#F5F0E8]/50 hover:text-[#E2C98C]"><Icon name="linkedin" class="h-5 w-5" /></a>}
        </div>
        <a href={localizedPath("/modelos/advocacia/admin", locale)} class="mt-4 inline-block text-xs text-[#F5F0E8]/30 hover:text-[#F5F0E8]/60">
          {t(locale, "Acesso administrativo (demonstrativo)")}
        </a>
      </div>
    </div>

    <div class="mt-10 rounded-xl border border-[#C7A35A]/20 bg-[#C7A35A]/[0.06] px-5 py-3.5 text-xs leading-relaxed text-[#F5F0E8]/55">
      {t(locale, "Vallora Advocacia é um escritório fictício, criado exclusivamente como modelo demonstrativo do portfólio CronosStart. Não representa uma sociedade de advogados real.")}
    </div>

    <div class="mt-6 flex flex-col gap-2 border-t border-[#F5F0E8]/10 pt-6 text-xs text-[#F5F0E8]/35 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Vallora Advocacia. {t(locale, "Empresa fictícia usada apenas como demonstração.")}</p>
      <p>
        {t(locale, "Modelo demonstrativo desenvolvido pela")}{" "}
        <a href={cronosStart.website} target="_blank" rel="noopener noreferrer" class="font-medium text-[#F5F0E8]/55 hover:text-[#E2C98C]">
          {t(locale, "CronosStart")}
        </a>
      </p>
    </div>
  </div>
</footer>
