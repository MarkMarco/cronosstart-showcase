---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
// Áreas de atuação — composição editorial: uma área em destaque (bloco maior,
// fundo escuro) + as demais em cartões compactos com expansão nativa
// (<details>) para mais informações, evitando um grid uniforme repetitivo.
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import type { PracticeArea, LegalProfessional } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  id?: string;
  areas: PracticeArea[];
  professionals: LegalProfessional[];
  ctaHref: string;
}
const { id, areas, professionals, ctaHref } = localizeDeep(Astro.props, locale);

const active = areas.filter((a) => a.active).sort((a, b) => a.order - b.order);
const featured = active.find((a) => a.featured) ?? active[0];
const rest = active.filter((a) => a.slug !== featured.slug);

function relatedNames(area: PracticeArea) {
  return (area.relatedProfessionalSlugs ?? [])
    .map((slug) => professionals.find((p) => p.slug === slug)?.name)
    .filter(Boolean) as string[];
}
---

<section id={id} class="bg-[var(--surface)] px-6 py-16 sm:py-24">
  <div class="mx-auto max-w-[1300px]">
    <SectionHeader
      eyebrow="Áreas de atuação"
      title={t(locale, "Uma atuação consultiva, organizada por área")}
      description="Cada frente reúne um raciocínio próprio — apresentamos aqui um recorte demonstrativo das principais áreas do escritório fictício."
    />

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.1fr_1fr]">
      <div data-animate class="relative overflow-hidden rounded-[1.5rem] bg-[#2b0d17] p-8 sm:p-10">
        <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-[#C7A35A] opacity-[0.08] blur-[100px]" />
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-[#C7A35A]/40 bg-[#C7A35A]/10 text-[#E2C98C]">
          <Icon name={featured.icon} class="h-6 w-6" />
        </span>
        <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-[#E2C98C]">{t(locale, "Área em destaque")}</p>
        <h3 class="mt-2 font-[var(--font-heading)] text-2xl font-semibold text-[#F5F0E8] sm:text-3xl">{featured.title}</h3>
        <p class="mt-4 text-sm leading-relaxed text-[#F5F0E8]/70">{featured.description}</p>
        {relatedNames(featured).length > 0 && (
          <p class="mt-5 text-xs text-[#F5F0E8]/50">
            Profissionais desta área: {relatedNames(featured).join(", ")}
          </p>
        )}
        <a href={ctaHref} class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[#E2C98C] hover:underline">
          {t(locale, "Solicitar atendimento nesta área")}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          rest.map((area, i) => (
            <details data-animate data-area-card={area.slug} style={`transition-delay:${(i + 1) * 50}ms`} class="group rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-5">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-3">
                <span class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--primary)]/10 text-[var(--primary)]">
                    <Icon name={area.icon} class="h-[1.125rem] w-[1.125rem]" />
                  </span>
                  <span>
                    <span class="block text-sm font-semibold text-[var(--ink)]">{area.title}</span>
                    <span class="mt-0.5 block text-xs leading-snug text-[var(--ink-muted)]">{area.shortDescription}</span>
                  </span>
                </span>
                <Icon name="chevron-down" class="mt-1 h-4 w-4 shrink-0 text-[var(--ink-muted)] transition-transform group-open:rotate-180 group-open:text-[var(--accent)]" />
              </summary>
              <div class="mt-4 border-t border-[var(--border)] pt-4">
                <p class="text-sm leading-relaxed text-[var(--ink-muted)]">{area.description}</p>
                {relatedNames(area).length > 0 && (
                  <p class="mt-3 text-xs text-[var(--ink-muted)]">Profissionais: {relatedNames(area).join(", ")}</p>
                )}
                <a href={ctaHref} class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--accent)] hover:underline">
                  {t(locale, "Solicitar atendimento")}
                  <Icon name="arrow-right" class="h-3.5 w-3.5" />
                </a>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
