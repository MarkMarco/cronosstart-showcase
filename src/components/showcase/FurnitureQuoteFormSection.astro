---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import Icon from "../ui/Icon.astro";
import type { CtaBand, ShowcaseContact } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  cta: CtaBand;
  contact: ShowcaseContact;
  id?: string;
}
const { cta, contact, id } = localizeDeep(Astro.props, locale);
const whatsappHref = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---

<section id={id} class="bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
  <div class="mx-auto grid max-w-[1400px] gap-12 lg:grid-cols-[1fr_1.05fr] lg:items-start">
    <div data-animate>
      <div class="overflow-hidden rounded-[var(--radius-card)]">
        <img
          src="/images/showcases/moveis-decoracao/ambientes/sala-de-jantar.jpg"
          alt="Sala de jantar Maison Lume"
          loading="lazy"
          decoding="async"
          width="900"
          height="600"
          class="aspect-[3/2] w-full object-cover"
        />
      </div>
      <h2 class="mt-8 font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-[var(--ink)] sm:text-4xl">{cta.title}</h2>
      <p class="mt-3 max-w-md text-base leading-relaxed text-[var(--ink-muted)]">{cta.description}</p>

      <ul class="mt-6 space-y-3 text-sm text-[var(--ink-muted)]">
        <li class="flex items-center gap-3">
          <Icon name="phone" class="h-5 w-5 text-[var(--accent)]" />
          {contact.phone}
        </li>
        <li class="flex items-center gap-3">
          <Icon name="mail" class="h-5 w-5 text-[var(--accent)]" />
          {contact.email}
        </li>
        {contact.hours && (
          <li class="flex items-center gap-3">
            <Icon name="clock" class="h-5 w-5 text-[var(--accent)]" />
            {contact.hours}
          </li>
        )}
      </ul>

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-[var(--radius-control)] bg-[#25D366] px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        {t(locale, "Falar pelo WhatsApp")}
      </a>
      <p class="mt-2 text-xs text-[var(--ink-muted)]">
        {t(locale, "Número de WhatsApp fictício")} ({contact.whatsappNumber}), {t(locale, "apenas para demonstração.")}
      </p>
    </div>

    <form
      data-furniture-quote-form
      data-animate
      style="transition-delay: 80ms"
      class="rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface)] p-6 shadow-sm sm:p-7"
    >
      <p class="mb-5 text-xs font-medium uppercase tracking-wide text-[var(--ink-muted)]">
        {t(locale, "Formulário demonstrativo — não envia dados")}
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
          {t(locale, "Nome")}
          <input
            type="text"
            name="name"
            required
            class="mt-1.5 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/10"
          />
        </label>
        <label class="block text-sm font-medium text-[var(--ink)]">
          {t(locale, "Telefone")}
          <input
            type="tel"
            name="phone"
            required
            placeholder="(00) 00000-0000"
            class="mt-1.5 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/10"
          />
        </label>
        <label class="block text-sm font-medium text-[var(--ink)]">
          {t(locale, "E-mail")}
          <input
            type="email"
            name="email"
            required
            class="mt-1.5 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/10"
          />
        </label>
        <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
          {t(locale, "Produto ou ambiente de interesse")}
          <input
            type="text"
            name="interest"
            placeholder={t(locale, "Ex.: Sofá Modular Aurora, ou Sala contemporânea")}
            class="mt-1.5 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/10"
          />
        </label>
        <label class="block text-sm font-medium text-[var(--ink)]">
          {t(locale, "Cidade")}
          <input
            type="text"
            name="city"
            class="mt-1.5 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/10"
          />
        </label>
        <label class="block text-sm font-medium text-[var(--ink)]">
          {t(locale, "Preferência de contato")}
          <select
            name="contactPreference"
            class="mt-1.5 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/10"
          >
            <option>{t(locale, "WhatsApp")}</option>
            <option>{t(locale, "E-mail")}</option>
            <option>{t(locale, "Telefone")}</option>
          </select>
        </label>
        <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
          {t(locale, "Mensagem")}
          <textarea
            name="message"
            rows="3"
            class="mt-1.5 w-full resize-none rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none transition-shadow focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/10"
          ></textarea>
        </label>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-[var(--radius-control)] bg-[var(--primary)] px-6 py-3 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5 sm:col-span-2"
        >
          {cta.buttonLabel}
        </button>
        <p data-furniture-quote-feedback role="status" class="hidden text-sm font-medium text-[var(--accent)] sm:col-span-2">
          {t(locale, "Mensagem de demonstração — nenhum dado foi enviado.")}
        </p>
      </div>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-furniture-quote-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      form.querySelector("[data-furniture-quote-feedback]")?.classList.remove("hidden");
    });
  });
</script>
