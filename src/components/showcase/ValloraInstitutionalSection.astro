---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
// Seção "Escritório" — posicionamento institucional em 3 pilares, com
// fotografia editorial e composição própria (nunca linguagem de "melhor
// escritório" ou promessas de resultado).
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import type { InstitutionalPillar } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  id?: string;
  title: string;
  paragraphs: string[];
  image: string;
  imageAlt: string;
  pillars: InstitutionalPillar[];
}
const { id, title, paragraphs, image, imageAlt, pillars } = localizeDeep(Astro.props, locale);
---

<section id={id} class="bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
  <div class="mx-auto max-w-[1300px]">
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div data-animate class="relative overflow-hidden rounded-[1.5rem]">
        <img src={image} alt={imageAlt} class="aspect-[4/5] w-full object-cover" loading="lazy" decoding="async" />
        <div class="absolute inset-x-6 bottom-6 rounded-2xl border border-[#C7A35A]/25 bg-[#120F10]/85 p-5 backdrop-blur-sm">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#E2C98C]">{t(locale, "Escritório fictício")}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-[#F5F0E8]/80">{t(locale, "Ambiente demonstrativo, usado apenas para compor a identidade visual deste modelo.")}</p>
        </div>
      </div>

      <div>
        <SectionHeader eyebrow="O escritório" title={title} />
        <div class="mt-5 space-y-4">
          {paragraphs.map((p) => <p class="text-sm leading-relaxed text-[var(--ink-muted)] sm:text-base">{p}</p>)}
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-3">
          {
            pillars.map((pillar, i) => (
              <div data-animate style={`transition-delay:${i * 70}ms`} class="border-t-2 border-[var(--accent)] pt-4">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--primary)]/10 text-[var(--primary)]">
                  <Icon name={pillar.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-3 text-sm font-semibold text-[var(--ink)]">{pillar.title}</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-[var(--ink-muted)]">{pillar.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
