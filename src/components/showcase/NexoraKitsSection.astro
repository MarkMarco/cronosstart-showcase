---
import Icon from "../ui/Icon.astro";
import NexoraProductVisual from "./NexoraProductVisual.astro";
import { productRenderVariant, moodForCategory } from "../../utils/nexoraProductRender";
import type { CatalogKit, CatalogProduct } from "../../config/showcases/types";

interface Props {
  id?: string;
  kits: CatalogKit[];
  products: CatalogProduct[];
  accents: Record<string, string>;
}
const { id, kits, products, accents } = Astro.props;

const productBySlug = new Map(products.map((p) => [p.slug, p]));
function formatBRL(value: number) {
  return value.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}
---

<section id={id} class="border-b border-white/[0.06] bg-[var(--surface)] px-6 py-16 sm:py-24">
  <div class="mx-auto max-w-[1400px]">
    <div class="mb-10 max-w-xl" data-animate>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">Kits e combinações</p>
      <h2 class="font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-white sm:text-4xl">Monte seu setup completo</h2>
      <p class="mt-3 text-base leading-relaxed text-[var(--ink-muted)]">Combinações demonstrativas com compatibilidade já confirmada entre os itens.</p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {
        kits.filter((k) => k.active).sort((a, b) => a.order - b.order).map((kit, i) => {
          const items = kit.productSlugs.map((s) => productBySlug.get(s)).filter((p): p is CatalogProduct => Boolean(p));
          const subtotal = items.reduce((sum, p) => sum + p.price, 0);
          return (
            <div
              data-animate
              data-kit-products={items.map((p) => p.slug).join(",")}
              style={`transition-delay: ${i * 70}ms`}
              class={`flex flex-col rounded-2xl border p-5 sm:p-6 ${kit.featured ? "border-[var(--accent)]/40 bg-[var(--accent)]/[0.05]" : "border-white/10 bg-white/[0.02]"}`}
            >
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="font-[var(--font-heading)] text-xl font-semibold text-white">{kit.name}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-[var(--ink-muted)]">{kit.description}</p>
                </div>
                {kit.featured && (
                  <span class="shrink-0 rounded-full border border-[var(--accent)]/40 px-2.5 py-1 text-[0.6rem] font-bold uppercase tracking-wide text-[var(--accent)]">Popular</span>
                )}
              </div>

              <div class="mt-4 flex -space-x-3">
                {items.map((p) => (
                  <div class="h-14 w-14 overflow-hidden rounded-full border-2 border-[var(--surface)]" title={p.name}>
                    <NexoraProductVisual
                      variant={productRenderVariant(p)}
                      accent={accents[p.category] ?? "#22d3ee"}
                      mood={moodForCategory(p.category)}
                      photoSrc={p.images?.main}
                      photoAlt={p.name}
                      class="h-full w-full"
                    />
                  </div>
                ))}
              </div>

              <ul class="mt-4 space-y-1.5">
                {items.map((p) => (
                  <li class="flex items-center justify-between text-sm">
                    <span class="text-[var(--ink-muted)]">{p.name}</span>
                    <span class="text-white/70">{formatBRL(p.price)}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-4 flex items-center gap-1.5 text-xs text-[var(--accent)]">
                <Icon name="check" class="h-3.5 w-3.5" />
                Compatibilidade confirmada entre os itens
              </div>

              <div class="mt-4 flex items-baseline justify-between border-t border-white/10 pt-4">
                <span class="text-xs uppercase tracking-wide text-[var(--ink-muted)]">Subtotal do kit</span>
                <span class="text-lg font-semibold text-white">{formatBRL(subtotal)}</span>
              </div>
              {kit.savingsLabel && <p class="mt-1 text-xs text-[var(--ink-muted)]">{kit.savingsLabel}</p>}

              <div class="mt-4 flex flex-wrap gap-3">
                <button
                  type="button"
                  data-add-kit={kit.slug}
                  class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
                  style="background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);"
                >
                  <Icon name="cart" class="h-4 w-4" />
                  Adicionar kit ao carrinho
                </button>
                <button
                  type="button"
                  data-request-quote-kit={kit.name}
                  class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-white/30"
                >
                  Solicitar orçamento
                </button>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  document.addEventListener("click", async (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLElement>("[data-add-kit]");
    if (!btn) return;
    const card = btn.closest<HTMLElement>("[data-kit-products]");
    const slugs = (card?.dataset.kitProducts ?? "").split(",").filter(Boolean);
    if (slugs.length === 0) return;
    const { addToCart } = await import("../../utils/nexoraTechShop");
    slugs.forEach((slug) => addToCart(slug, 1));
    window.dispatchEvent(new CustomEvent("nx:toast", { detail: "Itens do kit adicionados ao carrinho." }));
  });

  document.addEventListener("click", (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLElement>("[data-request-quote-kit]");
    if (!btn) return;
    window.dispatchEvent(new CustomEvent("nx:prefill-quote", { detail: { kit: btn.dataset.requestQuoteKit } }));
    document.getElementById("orcamento")?.scrollIntoView({ behavior: "smooth" });
  });
</script>
