---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
// Catálogo com busca, filtros rápidos, drawer de filtros avançados
// (categoria, marca, preço, disponibilidade, oferta, lançamento,
// conectividade, cor) e ordenação. Card editorial de encerramento aponta
// para a seção consultiva em vez de WhatsApp direto (a Nexora Tech tem uma
// seção própria para isso).
import Icon from "../ui/Icon.astro";
import NexoraProductCard from "./NexoraProductCard.astro";
import type { CatalogProduct, CatalogCategory, CatalogBrand } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  id?: string;
  products: CatalogProduct[];
  categories: CatalogCategory[];
  brands: CatalogBrand[];
  accents: Record<string, string>;
}
const { id, products, categories, brands, accents } = localizeDeep(Astro.props, locale);

const categoryBySlug = new Map(categories.map((c) => [c.slug, c]));
const sorted = [...products].sort((a, b) => a.displayOrder - b.displayOrder);

const connectivityOptions = localizeDeep(["5G", "Wi-Fi", "Bluetooth", "USB-C", "NFC", "HDMI"], locale);
const colorOptions = Array.from(new Set(products.flatMap((p) => p.colors))).sort();
---

<section id={id} class="border-b border-white/[0.06] bg-[var(--surface)] px-6 py-16 sm:py-24">
  <div class="mx-auto max-w-[1400px]">
    <div class="mb-8 max-w-xl" data-animate>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">{t(locale, "Catálogo completo")}</p>
      <h2 class="font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t(locale, "Todos os produtos")}</h2>
      <p class="mt-3 text-base leading-relaxed text-[var(--ink-muted)]">{t(locale, "Busque, filtre e compare o catálogo demonstrativo da Nexora Tech.")}</p>
    </div>

    <div data-catalog-controls class="rounded-2xl border border-white/10 bg-white/[0.02] p-3">
      <div class="flex flex-wrap items-center gap-2.5">
        <label class="relative min-w-[200px] flex-1">
          <span class="sr-only">{t(locale, "Buscar produto")}</span>
          <Icon name="search" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--ink-muted)]" />
          <input
            type="search"
            data-catalog-search
            placeholder={t(locale, "Buscar por nome, marca...")}
            class="w-full rounded-full border border-white/10 bg-white/[0.03] py-2.5 pl-9 pr-3 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]/60"
          />
        </label>

        <select data-catalog-sort class="rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]/60">
          <option value="relevance">{t(locale, "Relevância")}</option>
          <option value="price-asc">{t(locale, "Menor preço")}</option>
          <option value="price-desc">{t(locale, "Maior preço")}</option>
          <option value="newest">{t(locale, "Lançamentos")}</option>
          <option value="popular">{t(locale, "Mais procurados")}</option>
        </select>

        <button
          type="button"
          data-open-filters
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-[var(--ink)] transition-colors hover:border-[var(--accent)]/60"
        >
          <Icon name="filter" class="h-4 w-4" />
          {t(locale, "Filtros")}
          <span data-filter-count class="hidden h-4 min-w-4 items-center justify-center rounded-full bg-[var(--accent)] px-1 text-[0.6rem] font-bold text-[#04121a]">0</span>
        </button>
      </div>

      <div class="mt-3 flex flex-wrap gap-2 px-0.5">
        <button type="button" data-quick-category="" class="quick-chip is-active rounded-full border border-white/10 px-3 py-1.5 text-xs font-medium text-[var(--ink)]">{t(locale, "Todas")}</button>
        {categories.filter((c) => c.active).sort((a, b) => a.order - b.order).map((c) => (
          <button type="button" data-quick-category={c.slug} class="quick-chip rounded-full border border-white/10 px-3 py-1.5 text-xs font-medium text-[var(--ink-muted)] transition-colors hover:text-white">
            {c.name}
          </button>
        ))}
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
      <p data-catalog-count class="text-sm text-[var(--ink-muted)]"></p>
      <div data-active-chips class="flex flex-wrap gap-2"></div>
    </div>

    <div data-catalog-grid class="mt-4 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3 xl:grid-cols-4">
      {
        sorted.map((product, i) => (
          <NexoraProductCard product={product} category={categoryBySlug.get(product.category)} accent={accents[product.category] ?? "#22d3ee"} index={i} />
        ))
      }

      <div
        style="order: 999"
        class="col-span-2 flex flex-col items-start justify-center gap-3 rounded-2xl border border-dashed border-white/15 bg-white/[0.02] p-6 lg:col-span-3 xl:col-span-4"
      >
        <h3 class="font-[var(--font-heading)] text-xl font-semibold text-white sm:text-2xl">{t(locale, "Não sabe qual configuração escolher?")}</h3>
        <p class="max-w-md text-sm leading-relaxed text-[var(--ink-muted)]">
          {t(locale, "Conte o que você vai fazer com o produto — trabalho, estudo, jogos ou criação — e veja sugestões demonstrativas.")}
        </p>
        <a
          href="#assistente"
          class="mt-1 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
          style="background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);"
        >
          {t(locale, "Usar o assistente")}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <p data-catalog-empty class="mt-4 hidden rounded-2xl border border-dashed border-white/15 py-12 text-center text-sm text-[var(--ink-muted)]">
      {t(locale, "Nenhum produto encontrado com os filtros selecionados. Tente ajustar a busca ou limpar os filtros.")}
    </p>
  </div>

  
  <div data-filters-drawer class="pointer-events-none fixed inset-0 z-[105] hidden" role="dialog" aria-modal="true" aria-label={t(locale, "Filtros")}>
    <div data-filters-backdrop class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-300" />
    <div
      data-filters-panel
      class="absolute right-0 top-0 flex h-full w-full max-w-sm translate-x-full flex-col border-l border-white/10 bg-[var(--surface)] shadow-2xl transition-transform duration-300"
    >
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
        <h3 id="nx-filters-title" class="text-base font-semibold text-white">{t(locale, "Filtros")}</h3>
        <button type="button" data-close-filters aria-label={t(locale, "Fechar filtros")} class="inline-flex h-9 w-9 items-center justify-center rounded-full text-[var(--ink-muted)] hover:bg-white/[0.06] hover:text-white">
          <Icon name="close" class="h-5 w-5" />
        </button>
      </div>

      <div class="flex-1 space-y-6 overflow-y-auto px-5 py-5">
        <div>
          <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-[var(--ink-muted)]">{t(locale, "Categoria")}</label>
          <select data-catalog-category class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]/60">
            <option value="">{t(locale, "Todas")}</option>
            {categories.filter((c) => c.active).map((c) => <option value={c.slug}>{c.name}</option>)}
          </select>
        </div>

        <div>
          <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-[var(--ink-muted)]">{t(locale, "Marca")}</label>
          <select data-catalog-brand class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]/60">
            <option value="">{t(locale, "Todas")}</option>
            {brands.filter((b) => b.active).map((b) => <option value={b.slug}>{b.name}</option>)}
          </select>
        </div>

        <div>
          <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-[var(--ink-muted)]">{t(locale, "Preço")}</label>
          <select data-catalog-price class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]/60">
            <option value="">{t(locale, "Qualquer valor")}</option>
            <option value="0-500">{t(locale, "Até R$ 500")}</option>
            <option value="500-1500">{t(locale, "R$ 500 a R$ 1.500")}</option>
            <option value="1500-5000">{t(locale, "R$ 1.500 a R$ 5.000")}</option>
            <option value="5000-999999">{t(locale, "Acima de R$ 5.000")}</option>
          </select>
        </div>

        <div class="space-y-2.5">
          <label class="flex items-center gap-2.5 text-sm text-[var(--ink)]">
            <input type="checkbox" data-catalog-available class="h-4 w-4 rounded border-white/20 accent-[var(--accent)]" />
            {t(locale, "Somente disponíveis")}
          </label>
          <label class="flex items-center gap-2.5 text-sm text-[var(--ink)]">
            <input type="checkbox" data-catalog-offer class="h-4 w-4 rounded border-white/20 accent-[var(--accent)]" />
            {t(locale, "Somente em oferta")}
          </label>
          <label class="flex items-center gap-2.5 text-sm text-[var(--ink)]">
            <input type="checkbox" data-catalog-launch class="h-4 w-4 rounded border-white/20 accent-[var(--accent)]" />
            {t(locale, "Somente lançamentos")}
          </label>
        </div>

        <div>
          <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-[var(--ink-muted)]">{t(locale, "Conectividade")}</label>
          <div class="flex flex-wrap gap-1.5">
            {connectivityOptions.map((opt) => (
              <button type="button" data-conn-toggle={opt} class="conn-chip rounded-full border border-white/10 px-2.5 py-1 text-xs text-[var(--ink-muted)] transition-colors hover:text-white">{opt}</button>
            ))}
          </div>
        </div>

        <div>
          <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-[var(--ink-muted)]">{t(locale, "Cor")}</label>
          <div class="flex flex-wrap gap-1.5">
            {colorOptions.map((opt) => (
              <button type="button" data-color-toggle={opt} aria-label={opt} title={opt} class="color-chip h-7 w-7 rounded-full border-2 border-transparent" style={`background:${opt}`} />
            ))}
          </div>
        </div>
      </div>

      <div class="border-t border-white/10 px-5 py-4">
        <button type="button" data-catalog-clear class="w-full rounded-full border border-white/10 py-2.5 text-sm font-semibold text-[var(--ink-muted)] transition-colors hover:border-white/25 hover:text-white">
          {t(locale, "Limpar todos os filtros")}
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { colorToHex } from "../../utils/colorSwatches";

  const controls = document.querySelector<HTMLElement>("[data-catalog-controls]");
  const grid = document.querySelector<HTMLElement>("[data-catalog-grid]");
  const emptyState = document.querySelector<HTMLElement>("[data-catalog-empty]");
  const countLabel = document.querySelector<HTMLElement>("[data-catalog-count]");
  const filtersDrawer = document.querySelector<HTMLElement>("[data-filters-drawer]");

  if (controls && grid && emptyState && countLabel && filtersDrawer) {
    const searchInput = controls.querySelector<HTMLInputElement>("[data-catalog-search]")!;
    const sortSelect = controls.querySelector<HTMLSelectElement>("[data-catalog-sort]")!;
    const categorySelect = filtersDrawer.querySelector<HTMLSelectElement>("[data-catalog-category]")!;
    const brandSelect = filtersDrawer.querySelector<HTMLSelectElement>("[data-catalog-brand]")!;
    const priceSelect = filtersDrawer.querySelector<HTMLSelectElement>("[data-catalog-price]")!;
    const availableCheckbox = filtersDrawer.querySelector<HTMLInputElement>("[data-catalog-available]")!;
    const offerCheckbox = filtersDrawer.querySelector<HTMLInputElement>("[data-catalog-offer]")!;
    const launchCheckbox = filtersDrawer.querySelector<HTMLInputElement>("[data-catalog-launch]")!;
    const connButtons = Array.from(filtersDrawer.querySelectorAll<HTMLButtonElement>("[data-conn-toggle]"));
    const colorButtons = Array.from(filtersDrawer.querySelectorAll<HTMLButtonElement>("[data-color-toggle]"));
    const clearButton = filtersDrawer.querySelector<HTMLButtonElement>("[data-catalog-clear]")!;
    const activeChips = document.querySelector<HTMLElement>("[data-active-chips]")!;
    const filterCountBadge = document.querySelector<HTMLElement>("[data-filter-count]")!;
    const quickChips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-quick-category]"));

    colorButtons.forEach((btn) => {
      const name = btn.dataset.colorToggle ?? "";
      btn.style.background = colorToHex(name);
    });

    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-product-card]"));
    let activeConn = new Set<string>();
    let activeColors = new Set<string>();

    function activeFilterCount(): number {
      let n = 0;
      if (categorySelect.value) n++;
      if (brandSelect.value) n++;
      if (priceSelect.value) n++;
      if (availableCheckbox.checked) n++;
      if (offerCheckbox.checked) n++;
      if (launchCheckbox.checked) n++;
      n += activeConn.size + activeColors.size;
      return n;
    }

    function renderChips() {
      const chips: { label: string; onClear: () => void }[] = [];
      if (searchInput.value.trim()) chips.push({ label: `"${searchInput.value.trim()}"`, onClear: () => (searchInput.value = "") });
      if (categorySelect.value) chips.push({ label: categorySelect.options[categorySelect.selectedIndex].text, onClear: () => (categorySelect.value = "") });
      if (brandSelect.value) chips.push({ label: brandSelect.options[brandSelect.selectedIndex].text, onClear: () => (brandSelect.value = "") });
      if (priceSelect.value) chips.push({ label: priceSelect.options[priceSelect.selectedIndex].text, onClear: () => (priceSelect.value = "") });
      if (availableCheckbox.checked) chips.push({ label: "Disponíveis", onClear: () => (availableCheckbox.checked = false) });
      if (offerCheckbox.checked) chips.push({ label: "Em oferta", onClear: () => (offerCheckbox.checked = false) });
      if (launchCheckbox.checked) chips.push({ label: "Lançamentos", onClear: () => (launchCheckbox.checked = false) });
      activeConn.forEach((c) => chips.push({ label: c, onClear: () => { activeConn.delete(c); connButtons.find((b) => b.dataset.connToggle === c)?.classList.remove("is-active"); } }));
      activeColors.forEach((c) => chips.push({ label: c, onClear: () => { activeColors.delete(c); colorButtons.find((b) => b.dataset.colorToggle === c)?.classList.remove("is-active"); } }));

      activeChips.innerHTML = "";
      chips.forEach((chip) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-xs font-medium text-[var(--ink)] hover:border-white/25";
        btn.innerHTML = `${chip.label} <span aria-hidden="true">&times;</span>`;
        btn.addEventListener("click", () => { chip.onClear(); run(); });
        activeChips.appendChild(btn);
      });

      const n = activeFilterCount();
      filterCountBadge.textContent = String(n);
      filterCountBadge.classList.toggle("hidden", n === 0);
      filterCountBadge.classList.toggle("flex", n > 0);
    }

    function run() {
      const query = searchInput.value.trim().toLowerCase();
      const category = categorySelect.value;
      const brand = brandSelect.value;
      const priceRange = priceSelect.value;
      const onlyAvailable = availableCheckbox.checked;
      const onlyOffer = offerCheckbox.checked;
      const onlyLaunch = launchCheckbox.checked;
      const sort = sortSelect.value;
      const [min, max] = priceRange ? priceRange.split("-").map(Number) : [0, Infinity];

      let visibleCount = 0;
      cards.forEach((card) => {
        const price = Number(card.dataset.price ?? 0);
        const name = (card.dataset.name ?? "").toLowerCase();
        const brandVal = card.dataset.brand ?? "";
        const categoryMatch = category === "ofertas" ? card.dataset.offer === "true" : !category || card.dataset.category === category;
        const connText = (card.dataset.conn ?? "").toLowerCase();
        const connMatch = activeConn.size === 0 || Array.from(activeConn).some((c) => connText.includes(c.toLowerCase()));
        const colorMatch = activeColors.size === 0 || Array.from(card.querySelectorAll<HTMLElement>("[data-color-dot]")).some((d) => activeColors.has(d.dataset.colorDot ?? ""));

        const matches =
          (!query || name.includes(query) || brandVal.toLowerCase().includes(query)) &&
          categoryMatch &&
          (!brand || brandVal === brand) &&
          (!priceRange || (price >= min && price <= max)) &&
          (!onlyAvailable || card.dataset.available === "true") &&
          (!onlyOffer || card.dataset.offer === "true") &&
          (!onlyLaunch || card.dataset.launch === "true") &&
          connMatch &&
          colorMatch;

        card.classList.toggle("hidden", !matches);
        if (matches) visibleCount++;
      });

      const sortKey = (card: HTMLElement): number => {
        switch (sort) {
          case "price-asc":
            return Number(card.dataset.price ?? 0);
          case "price-desc":
            return -Number(card.dataset.price ?? 0);
          case "newest":
            return -new Date(card.dataset.created ?? 0).getTime();
          case "popular":
            return card.dataset.featured === "true" ? -1 : 0;
          default:
            return 0;
        }
      };
      cards.forEach((card) => (card.style.order = String(sortKey(card))));

      emptyState!.classList.toggle("hidden", visibleCount > 0);
      grid!.classList.toggle("hidden", visibleCount === 0);
      countLabel!.textContent = `${visibleCount} ${visibleCount === 1 ? "produto encontrado" : "produtos encontrados"}`;

      quickChips.forEach((chip) => chip.classList.toggle("is-active", (chip.dataset.quickCategory ?? "") === category));
      renderChips();
    }

    [searchInput].forEach((el) => el.addEventListener("input", run));
    [sortSelect, categorySelect, brandSelect, priceSelect].forEach((el) => el.addEventListener("change", run));
    [availableCheckbox, offerCheckbox, launchCheckbox].forEach((el) => el.addEventListener("change", run));

    connButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const val = btn.dataset.connToggle ?? "";
        if (activeConn.has(val)) { activeConn.delete(val); btn.classList.remove("is-active"); }
        else { activeConn.add(val); btn.classList.add("is-active"); }
        run();
      });
    });
    colorButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const val = btn.dataset.colorToggle ?? "";
        if (activeColors.has(val)) { activeColors.delete(val); btn.classList.remove("is-active"); }
        else { activeColors.add(val); btn.classList.add("is-active"); }
        run();
      });
    });

    quickChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        categorySelect.value = chip.dataset.quickCategory ?? "";
        run();
      });
    });

    clearButton.addEventListener("click", () => {
      searchInput.value = "";
      categorySelect.value = "";
      brandSelect.value = "";
      priceSelect.value = "";
      availableCheckbox.checked = false;
      offerCheckbox.checked = false;
      launchCheckbox.checked = false;
      activeConn.clear();
      activeColors.clear();
      connButtons.forEach((b) => b.classList.remove("is-active"));
      colorButtons.forEach((b) => b.classList.remove("is-active"));
      run();
    });

    // Drawer open/close
    const backdrop = filtersDrawer.querySelector<HTMLElement>("[data-filters-backdrop]")!;
    const panel = filtersDrawer.querySelector<HTMLElement>("[data-filters-panel]")!;
    let lastFocused: HTMLElement | null = null;

    function openFilters() {
      lastFocused = document.activeElement as HTMLElement;
      filtersDrawer!.classList.remove("hidden");
      filtersDrawer!.classList.remove("pointer-events-none");
      requestAnimationFrame(() => {
        backdrop.classList.remove("opacity-0");
        panel.classList.remove("translate-x-full");
      });
      panel.querySelector<HTMLElement>("select, input, button")?.focus();
      document.addEventListener("keydown", onKeydown);
    }
    function closeFilters() {
      backdrop.classList.add("opacity-0");
      panel.classList.add("translate-x-full");
      document.removeEventListener("keydown", onKeydown);
      window.setTimeout(() => {
        filtersDrawer!.classList.add("hidden");
        filtersDrawer!.classList.add("pointer-events-none");
      }, 300);
      lastFocused?.focus();
    }
    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") closeFilters();
    }

    document.querySelector("[data-open-filters]")?.addEventListener("click", openFilters);
    document.querySelector("[data-close-filters]")?.addEventListener("click", closeFilters);
    backdrop.addEventListener("click", closeFilters);

    document.addEventListener("nx:catalog-set-category", ((e: CustomEvent<string>) => {
      categorySelect.value = e.detail;
      run();
    }) as EventListener);

    document.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest<HTMLElement>("[data-category-link]");
      if (!link) return;
      event.preventDefault();
      categorySelect.value = link.dataset.categoryLink ?? "";
      run();
      document.getElementById("catalogo")?.scrollIntoView({ behavior: "smooth" });
    });

    run();
  }
</script>

<style>
  .quick-chip.is-active {
    background: var(--accent);
    color: #04121a;
    border-color: transparent;
  }
  .conn-chip.is-active {
    background: var(--accent);
    color: #04121a;
    border-color: transparent;
  }
  .color-chip.is-active {
    border-color: var(--accent);
  }
</style>
