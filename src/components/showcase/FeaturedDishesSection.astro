---
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import CardGrid from "./CardGrid.astro";
import GridCard from "./GridCard.astro";
import type { DishItem } from "../../config/showcases/types";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: DishItem[];
  id?: string;
}
const { eyebrow, title, description, items, id } = Astro.props;
---

<section id={id} class="bg-[var(--surface)] px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow={eyebrow} title={title} description={description} align="center" class="mx-auto" />

    <CardGrid cols={3} class="mt-10">
      {
        items.map((dish, index) => (
          <GridCard variant="standard" animateDelay={Math.min(index, 5) * 60} class="!p-0 overflow-hidden">
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={dish.image}
                alt={dish.imageAlt}
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              {dish.tag && (
                <span class="absolute left-3 top-3 rounded-full bg-[var(--accent)] px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-white">
                  {dish.tag}
                </span>
              )}
            </div>
            <div class="p-6">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-[var(--font-heading)] text-lg font-medium text-[var(--ink)]">{dish.name}</h3>
                <span class="shrink-0 text-sm font-semibold text-[var(--accent)]">{dish.price}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{dish.description}</p>
            </div>
            <a
              slot="cta"
              href="#reservas"
              class="inline-flex items-center gap-1.5 px-6 pb-6 text-xs font-semibold text-[var(--accent)]"
            >
              Reservar para provar
              <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </a>
          </GridCard>
        ))
      }
    </CardGrid>
  </div>
</section>
