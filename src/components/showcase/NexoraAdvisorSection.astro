---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
// "Não sabe qual configuração escolher?" — assistente local (sem IA/backend):
// o usuário escolhe um perfil de uso e vê sugestões pré-definidas com uma
// breve explicação do porquê.
import Icon from "../ui/Icon.astro";
import NexoraProductVisual from "./NexoraProductVisual.astro";
import { productRenderVariant, moodForCategory } from "../../utils/nexoraProductRender";
import type { CatalogProduct, IconName } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  id?: string;
  products: CatalogProduct[];
  accents: Record<string, string>;
}
const { id, products, accents } = localizeDeep(Astro.props, locale);
const bySlug = new Map(products.map((p) => [p.slug, p]));

function formatBRL(value: number) {
  return value.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}

const profiles: { key: string; label: string; icon: IconName; why: string; slugs: string[] }[] = localizeDeep([
  {
    key: "trabalho", label: "Trabalho", icon: "briefcase",
    why: "Equilíbrio entre desempenho e portabilidade para reuniões, planilhas e múltiplas abas abertas o dia todo.",
    slugs: ["nexora-core-book", "velstra-view-27q", "orbex-click-pro"],
  },
  {
    key: "estudo", label: "Estudo", icon: "layers",
    why: "Bom custo-benefício com autonomia de bateria para acompanhar aulas e ler o dia inteiro.",
    slugs: ["nexora-core-book", "nexora-vision-lite", "nexora-pulse-buds"],
  },
  {
    key: "jogos", label: "Jogos", icon: "gamepad",
    why: "Placa gráfica dedicada e alta taxa de atualização para partidas competitivas sem engasgos.",
    slugs: ["draventa-forge-tower", "velstra-curve-34u", "draventa-strike-controller"],
  },
  {
    key: "criacao", label: "Criação de conteúdo", icon: "sparkle",
    why: "Tela de cor precisa e processamento consistente para edição de fotos, vídeo e áudio.",
    slugs: ["nexora-studio-14", "velstra-view-27q", "nexora-pulse-max"],
  },
  {
    key: "casa", label: "Casa inteligente", icon: "wifi",
    why: "Central única para conectar câmeras, tomadas e sensores sem complicação.",
    slugs: ["nexora-home-hub", "nexora-home-cam", "nexora-home-plug-kit"],
  },
  {
    key: "geral", label: "Uso geral", icon: "smartphone",
    why: "Bom desempenho no dia a dia sem pesar no orçamento — para quem quer só o essencial bem feito.",
    slugs: ["nexora-vision-lite", "kaion-prisma-5", "nexora-air-charger"],
  },
], locale);
---

<section id={id} class="border-b border-white/[0.06] bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
  <div class="mx-auto max-w-[1400px]">
    <div class="mx-auto max-w-2xl text-center" data-animate>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">{t(locale, "Assistente demonstrativo")}</p>
      <h2 class="font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t(locale, "Não sabe qual configuração escolher?")}</h2>
      <p class="mt-3 text-base leading-relaxed text-[var(--ink-muted)]">{t(locale, "Selecione o que você mais vai fazer e veja sugestões demonstrativas do catálogo.")}</p>
    </div>

    <div class="mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-2.5" role="tablist" aria-label={t(locale, "Perfil de uso")}>
      {
        profiles.map((p, i) => (
          <button
            type="button"
            data-advisor-profile={p.key}
            aria-pressed={i === 0 ? "true" : "false"}
            class={`advisor-chip inline-flex items-center gap-2 rounded-full border px-4 py-2.5 text-sm font-medium transition-colors ${i === 0 ? "is-active" : "border-white/10 text-[var(--ink-muted)]"}`}
          >
            <Icon name={p.icon} class="h-4 w-4" />
            {p.label}
          </button>
        ))
      }
    </div>

    <div class="relative mt-10">
      {
        profiles.map((profile, i) => {
          const items = profile.slugs.map((s) => bySlug.get(s)).filter((p): p is CatalogProduct => Boolean(p));
          return (
            <div data-advisor-panel={profile.key} class={i === 0 ? "" : "hidden"}>
              <p class="mx-auto mb-6 max-w-xl text-center text-sm leading-relaxed text-[var(--ink-muted)]">{profile.why}</p>
              <div class="grid gap-4 sm:grid-cols-3">
                {items.map((p) => (
                  <div class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02]">
                    <div class="aspect-[4/3]">
                      <NexoraProductVisual
                        variant={productRenderVariant(p)}
                        accent={accents[p.category] ?? "#22d3ee"}
                        mood={moodForCategory(p.category)}
                        photoSrc={p.images?.main}
                        photoAlt={p.name}
                        class="h-full w-full"
                      />
                    </div>
                    <div class="flex flex-1 flex-col p-4">
                      <p class="text-[0.65rem] uppercase tracking-wide text-[var(--ink-muted)]">{p.subcategory ?? p.category}</p>
                      <h3 class="mt-1 line-clamp-1 text-sm font-semibold text-white">{p.name}</h3>
                      <p class="mt-1 text-sm font-semibold" style={`color:${accents[p.category] ?? "#22d3ee"}`}>{formatBRL(p.price)}</p>
                      <button type="button" data-open-product={p.slug} class="mt-auto flex items-center gap-1.5 pt-3 text-xs font-medium text-[var(--ink-muted)] hover:text-white">
                        {t(locale, "Ver detalhes")}
                        <Icon name="arrow-right" class="h-3 w-3" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .advisor-chip.is-active {
    background: var(--accent);
    color: #04121a;
    border-color: transparent;
  }
</style>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-advisor-profile]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-advisor-panel]"));

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const key = chip.dataset.advisorProfile;
      chips.forEach((c) => {
        const active = c === chip;
        c.classList.toggle("is-active", active);
        c.setAttribute("aria-pressed", String(active));
      });
      panels.forEach((panel) => panel.classList.toggle("hidden", panel.dataset.advisorPanel !== key));
    });
  });
</script>
