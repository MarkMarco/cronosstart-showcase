---
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import type { Testimonial } from "../../config/showcases/types";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: Testimonial[];
}
const { eyebrow, title, description, items } = Astro.props;
const [featured, ...rest] = items;

const initialsOf = (name: string) =>
  name
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("")
    .toUpperCase();
---

<section class="bg-[var(--surface-alt)] px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow={eyebrow} title={title} description={description} align="center" class="mx-auto" />

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.3fr_1fr]">
      {featured && (
        <figure data-animate class="relative flex flex-col justify-between rounded-2xl bg-[var(--surface)] p-8">
          <Icon name="quote" class="h-8 w-8 text-[var(--accent)]" />
          <blockquote class="mt-5 flex-1 text-xl leading-relaxed text-[var(--ink)]">"{featured.quote}"</blockquote>
          <figcaption class="mt-6 flex items-center gap-3 border-t border-[var(--border)] pt-5">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[var(--primary)] text-sm font-semibold text-white">
              {initialsOf(featured.author)}
            </span>
            <div class="leading-tight">
              <span class="block text-sm font-semibold text-[var(--ink)]">{featured.author}</span>
              <span class="text-xs text-[var(--ink-muted)]">
                {featured.role} · {featured.segment}
              </span>
            </div>
            <span class="ml-auto inline-flex items-center gap-1 text-xs font-semibold text-[var(--accent)]">
              <Icon name="check" class="h-3.5 w-3.5" />
              {featured.result}
            </span>
          </figcaption>
        </figure>
      )}

      <div class="flex flex-col divide-y divide-[var(--border)] rounded-2xl bg-[var(--surface)] px-6">
        {
          rest.map((item, index) => (
            <figure data-animate style={`transition-delay: ${(index + 1) * 70}ms`} class="py-6 first:pt-6">
              <blockquote class="text-sm leading-relaxed text-[var(--ink)]">"{item.quote}"</blockquote>
              <figcaption class="mt-3 flex items-center gap-2.5">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--accent)] text-[0.65rem] font-semibold text-white">
                  {initialsOf(item.author)}
                </span>
                <div class="leading-tight">
                  <span class="block text-xs font-semibold text-[var(--ink)]">{item.author}</span>
                  <span class="text-[0.7rem] text-[var(--ink-muted)]">{item.segment}</span>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-[var(--ink-muted)]">
      Depoimentos ilustrativos, criados para fins de demonstração deste modelo.
    </p>
  </div>
</section>
