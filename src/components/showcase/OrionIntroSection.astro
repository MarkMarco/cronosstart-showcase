---
interface Props {
  eyebrow?: string;
  title: string;
  paragraphs: string[];
  quote: string;
  id?: string;
}
const { eyebrow, title, paragraphs, quote, id } = Astro.props;
---

<section id={id} class="bg-[var(--surface-alt)] px-6 py-16 sm:py-20">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
    <div data-animate>
      {eyebrow && (
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--primary)]">{eyebrow}</p>
      )}
      <h2 class="font-[var(--font-heading)] text-3xl font-medium leading-tight tracking-tight text-[var(--ink)] sm:text-4xl">
        {title}
      </h2>
    </div>

    <div data-animate style="transition-delay: 80ms">
      <blockquote class="border-l-2 border-[var(--primary)] pl-6 font-[var(--font-heading)] text-xl font-medium leading-snug text-[var(--ink)] sm:text-2xl">
        “{quote}”
      </blockquote>
      <div class="mt-6 space-y-4">
        {paragraphs.map((paragraph) => (
          <p class="text-base leading-relaxed text-[var(--ink-muted)]">{paragraph}</p>
        ))}
      </div>
    </div>
  </div>
</section>
