---
interface Props {
  variant?: "split" | "centered";
  eyebrow?: string;
  headline: string;
  highlight?: string;
  subheadline: string;
  ctaPrimaryLabel: string;
  ctaPrimaryHref: string;
  ctaSecondaryLabel?: string;
  ctaSecondaryHref?: string;
}

const {
  variant = "split",
  eyebrow,
  headline,
  highlight,
  subheadline,
  ctaPrimaryLabel,
  ctaPrimaryHref,
  ctaSecondaryLabel,
  ctaSecondaryHref,
} = Astro.props;
---

<section class="relative overflow-hidden bg-[var(--surface)]">
  <div
    class={`mx-auto grid max-w-6xl gap-10 px-6 pb-14 pt-12 sm:pt-16 ${
      variant === "split" ? "lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-8" : "text-center"
    }`}
  >
    <div class={variant === "centered" ? "mx-auto max-w-2xl" : ""}>
      {eyebrow && (
        <p class="animate-hero-in mb-4 inline-flex items-center gap-2 rounded-full bg-[var(--surface-alt)] px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--accent)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
          {eyebrow}
        </p>
      )}
      <h1
        class="animate-hero-in text-4xl font-semibold leading-[1.12] tracking-tight text-[var(--ink)] sm:text-5xl"
        style="animation-delay: 60ms"
      >
        {headline}{" "}
        {highlight && <span class="text-[var(--primary)]">{highlight}</span>}
      </h1>
      <p
        class="animate-hero-in mt-5 max-w-xl text-lg leading-relaxed text-[var(--ink-muted)]"
        style="animation-delay: 120ms"
      >
        {subheadline}
      </p>
      <div
        class={`animate-hero-in mt-8 flex flex-wrap gap-4 ${variant === "centered" ? "justify-center" : ""}`}
        style="animation-delay: 180ms"
      >
        <a
          href={ctaPrimaryHref}
          class="inline-flex items-center justify-center rounded-[var(--radius-control)] bg-[var(--primary)] px-7 py-3.5 text-sm font-semibold text-[var(--primary-ink)] shadow-sm transition-transform hover:-translate-y-0.5"
        >
          {ctaPrimaryLabel}
        </a>
        {ctaSecondaryLabel && ctaSecondaryHref && (
          <a
            href={ctaSecondaryHref}
            class="inline-flex items-center justify-center rounded-[var(--radius-control)] border border-[var(--border)] px-7 py-3.5 text-sm font-semibold text-[var(--ink)] transition-transform hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            {ctaSecondaryLabel}
          </a>
        )}
      </div>
    </div>

    {variant === "split" && (
      <div class="animate-hero-in relative" style="animation-delay: 100ms">
        <slot name="visual" />
      </div>
    )}
  </div>
</section>
