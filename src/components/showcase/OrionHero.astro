---
import Icon from "../ui/Icon.astro";

interface Stat {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  highlight?: string;
  subheadline: string;
  ctaPrimaryLabel: string;
  ctaPrimaryHref: string;
  ctaSecondaryLabel?: string;
  ctaSecondaryHref?: string;
  image: string;
  imageAlt: string;
  stats: Stat[];
  ratingBadge?: string;
}
const {
  eyebrow,
  headline,
  highlight,
  subheadline,
  ctaPrimaryLabel,
  ctaPrimaryHref,
  ctaSecondaryLabel,
  ctaSecondaryHref,
  image,
  imageAlt,
  stats,
  ratingBadge,
} = Astro.props;
---

<section class="relative overflow-hidden bg-[var(--surface)]">
  <div
    class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full opacity-[0.35] blur-3xl"
    style="background: var(--primary);"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -right-20 bottom-0 h-72 w-72 rounded-full opacity-[0.25] blur-3xl"
    style="background: var(--accent);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-6 py-16 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10 lg:py-24">
    <div class="animate-hero-in">
      {eyebrow && (
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface-alt)] px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--primary)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--primary)]"></span>
          {eyebrow}
        </p>
      )}
      <h1 class="text-4xl font-medium leading-[1.12] tracking-tight text-[var(--ink)] sm:text-5xl lg:text-[3.25rem]">
        {headline} <span class="text-[var(--primary)]">{highlight}</span>
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-[var(--ink-muted)]">
        {subheadline}
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a
          href={ctaPrimaryHref}
          class="inline-flex items-center justify-center rounded-[var(--radius-control)] bg-[var(--primary)] px-7 py-3.5 text-sm font-semibold text-[var(--primary-ink)] shadow-[0_12px_28px_-8px_color-mix(in_srgb,var(--primary)_60%,transparent)] transition-transform hover:-translate-y-0.5"
        >
          {ctaPrimaryLabel}
        </a>
        {ctaSecondaryLabel && ctaSecondaryHref && (
          <a
            href={ctaSecondaryHref}
            class="inline-flex items-center justify-center rounded-[var(--radius-control)] border border-[var(--border)] px-7 py-3.5 text-sm font-semibold text-[var(--ink)] transition-transform hover:-translate-y-0.5 hover:border-[var(--primary)] hover:text-[var(--primary)]"
          >
            {ctaSecondaryLabel}
          </a>
        )}
      </div>

      <dl class="mt-11 grid grid-cols-3 gap-6 border-t border-[var(--border)] pt-7">
        {
          stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd class="font-[var(--font-heading)] text-2xl font-medium text-[var(--ink)] sm:text-3xl">{stat.value}</dd>
              <p class="mt-1 text-xs leading-snug text-[var(--ink-muted)]">{stat.label}</p>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="animate-hero-in relative" style="animation-delay: 120ms">
      <div class="overflow-hidden rounded-[1.75rem] shadow-[0_30px_60px_-20px_rgba(35,40,42,0.35)]">
        <img src={image} alt={imageAlt} class="aspect-[4/5] w-full object-cover" loading="eager" decoding="async" />
      </div>

      {ratingBadge && (
        <div class="absolute bottom-5 left-5 right-5 flex items-center gap-3 rounded-2xl border border-[var(--border)] bg-[var(--surface)]/95 p-4 shadow-[0_18px_35px_-15px_rgba(35,40,42,0.4)] backdrop-blur sm:right-auto sm:min-w-[15rem]">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--primary)]/10 text-[var(--primary)]">
            <Icon name="star" class="h-5 w-5" />
          </span>
          <p class="text-sm font-semibold text-[var(--ink)]">{ratingBadge}</p>
        </div>
      )}
    </div>
  </div>
</section>
