---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
// "Marcas em destaque" — reforça a leitura de loja multimarcas (não uma
// página institucional de um único fabricante).
import type { CatalogBrand, CatalogProduct } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  id?: string;
  brands: CatalogBrand[];
  products: CatalogProduct[];
  accents: Record<string, string>;
}
const { id, brands, products, accents } = localizeDeep(Astro.props, locale);

const activeBrands = brands.filter((b) => b.active);
function brandAccent(slug: string) {
  const product = products.find((p) => p.brand === slug);
  return product ? accents[product.category] ?? "#22d3ee" : "#22d3ee";
}
function brandCount(slug: string) {
  return products.filter((p) => p.brand === slug).length;
}
---

<section id={id} class="border-b border-white/[0.06] bg-[var(--surface-alt)] px-6 py-14">
  <div class="mx-auto max-w-[1400px]">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">{t(locale, "Marcas em destaque")}</p>
    <h2 class="font-[var(--font-heading)] text-2xl font-semibold tracking-tight text-white sm:text-3xl">{t(locale, "Um catálogo multimarcas")}</h2>
    <p class="mt-2 max-w-xl text-sm leading-relaxed text-[var(--ink-muted)]">{t(locale, "Marcas fictícias próprias e parceiras, reunidas no mesmo catálogo demonstrativo.")}</p>

    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {
        activeBrands.map((brand) => {
          const accent = brandAccent(brand.slug);
          const count = brandCount(brand.slug);
          return (
            <div class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-full text-sm font-bold text-white" style={`background: linear-gradient(135deg, ${accent}55, ${accent}20); border: 1px solid ${accent}55;`}>
                {brand.name.slice(0, 1)}
              </span>
              <h3 class="mt-3 text-sm font-semibold text-white">{brand.name}</h3>
              <p class="mt-1 line-clamp-2 flex-1 text-xs leading-relaxed text-[var(--ink-muted)]">{brand.description}</p>
              <p class="mt-2 text-[0.7rem] uppercase tracking-wide text-[var(--ink-muted)]">{count} produto{count === 1 ? "" : "s"}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
