---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import Icon from "../ui/Icon.astro";
import type { VehicleItem } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  vehicle: VehicleItem;
}
const { vehicle } = localizeDeep(Astro.props, locale);

const km = (n: number) => `${n.toLocaleString("pt-BR")} km`;
---

<div class="relative aspect-[4/3] overflow-hidden" data-field="image-wrap">
  <img
    src={vehicle.image}
    alt={vehicle.imageAlt}
    loading="lazy"
    decoding="async"
    data-field="image"
    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
  />
  {vehicle.tag && (
    <span class="absolute left-3 top-3 rounded-full bg-[var(--primary)] px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-[var(--primary-ink)]">
      {vehicle.tag}
    </span>
  )}
  <span
    data-field="status-ribbon"
    class="absolute inset-0 hidden items-center justify-center bg-[var(--surface)]/80 text-sm font-semibold uppercase tracking-widest text-[var(--ink)]"
  ></span>
</div>
<div class="flex flex-1 flex-col p-5">
  <p class="text-xs font-medium uppercase tracking-wide text-[var(--ink-muted)]">{vehicle.brand}</p>
  <h3 class="mt-1 text-base font-semibold text-[var(--ink)]">{vehicle.name}</h3>

  <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5 text-xs text-[var(--ink-muted)]">
    <span class="inline-flex items-center gap-1">
      <Icon name="calendar" class="h-3.5 w-3.5" />
      {vehicle.spec.year}
    </span>
    <span class="inline-flex items-center gap-1">
      <Icon name="gauge" class="h-3.5 w-3.5" />
      {km(vehicle.spec.mileageKm)}
    </span>
    <span class="inline-flex items-center gap-1">
      <Icon name="fuel" class="h-3.5 w-3.5" />
      {vehicle.spec.fuel}
    </span>
  </div>

  <p data-field="price" class="mt-4 font-[var(--font-heading)] text-xl font-semibold text-[var(--ink)]">{vehicle.price}</p>

  <a
    href={`/modelos/aurum-motors/veiculos/${vehicle.slug}`}
    data-field="cta"
    class="mt-4 inline-flex items-center justify-center gap-2 rounded-[var(--radius-control)] border border-[var(--border)] px-4 py-2.5 text-sm font-semibold text-[var(--ink)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
  >
    {t(locale, "Ver detalhes")}
    <Icon name="arrow-right" class="h-4 w-4" />
  </a>
</div>
