---
// Lançamentos — composição assimétrica (produto principal grande +
// lançamentos complementares empilhados), não uma repetição da grade do
// catálogo.
import Icon from "../ui/Icon.astro";
import NexoraProductVisual from "./NexoraProductVisual.astro";
import { colorToHex } from "../../utils/colorSwatches";
import { productRenderVariant, moodForCategory } from "../../utils/nexoraProductRender";
import type { CatalogProduct } from "../../config/showcases/types";

interface Props {
  id?: string;
  primary: CatalogProduct;
  complementary: CatalogProduct[];
  accents: Record<string, string>;
}
const { id, primary, complementary, accents } = Astro.props;

function formatBRL(value: number) {
  return value.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}
const primaryAccent = accents[primary.category] ?? "#22d3ee";
const specs = Object.entries(primary.specs ?? {}).slice(0, 5);
---

<section id={id} class="border-b border-white/[0.06] bg-[var(--surface)] px-6 py-16 sm:py-24">
  <div class="mx-auto max-w-[1400px]">
    <div class="mb-10 max-w-xl" data-animate>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">Lançamentos</p>
      <h2 class="font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-white sm:text-4xl">Tecnologia em primeira mão</h2>
      <p class="mt-3 text-base leading-relaxed text-[var(--ink-muted)]">Os lançamentos mais recentes do catálogo demonstrativo Nexora Tech.</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.3fr_1fr]">
      <div data-animate class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02]">
        <div class="grid gap-0 sm:grid-cols-2">
          <div class="relative aspect-square sm:aspect-auto">
            <NexoraProductVisual
              variant={productRenderVariant(primary)}
              accent={primaryAccent}
              mood={moodForCategory(primary.category)}
              photoSrc={primary.images?.main}
              photoAlt={primary.name}
              class="h-full w-full"
            />
            <span class="absolute left-4 top-4 rounded-full bg-white px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wide text-[#0a0e16]">Lançamento</span>
          </div>
          <div class="flex flex-col justify-center p-6 sm:p-8">
            <p class="text-xs uppercase tracking-wide text-[var(--ink-muted)]">{primary.subcategory ?? primary.category}</p>
            <h3 class="mt-1 font-[var(--font-heading)] text-2xl font-semibold text-white sm:text-3xl">{primary.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">{primary.description}</p>

            <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2.5">
              {specs.map(([label, value]) => (
                <div>
                  <dt class="text-[0.65rem] uppercase tracking-wide text-[var(--ink-muted)]">{label}</dt>
                  <dd class="text-sm font-medium text-white">{value}</dd>
                </div>
              ))}
            </dl>

            {primary.colors.length > 0 && (
              <div class="mt-5 flex items-center gap-1.5">
                {primary.colors.map((c) => (
                  <span class="h-4 w-4 rounded-full border border-white/25" style={`background:${colorToHex(c)}`} title={c} />
                ))}
              </div>
            )}

            <div class="mt-5 flex items-center gap-2.5">
              <span class="font-[var(--font-heading)] text-2xl font-semibold text-white">{formatBRL(primary.price)}</span>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
              <button
                type="button"
                data-open-product={primary.slug}
                class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
                style={`background: linear-gradient(135deg, var(--primary) 0%, ${primaryAccent} 100%);`}
              >
                Ver detalhes
                <Icon name="arrow-right" class="h-4 w-4" />
              </button>
              <button
                type="button"
                data-add-cart={primary.slug}
                class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-white/30"
              >
                <Icon name="cart" class="h-4 w-4" />
                Adicionar
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        {
          complementary.map((p, i) => {
            const accent = accents[p.category] ?? "#22d3ee";
            return (
              <div
                data-animate
                style={`transition-delay: ${(i + 1) * 70}ms`}
                class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.02] p-3 transition-colors hover:border-white/20"
              >
                <div class="relative h-20 w-20 shrink-0 overflow-hidden rounded-xl">
                  <NexoraProductVisual
                    variant={productRenderVariant(p)}
                    accent={accent}
                    mood={moodForCategory(p.category)}
                    photoSrc={p.images?.main}
                    photoAlt={p.name}
                    class="h-full w-full"
                  />
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-[0.65rem] uppercase tracking-wide text-[var(--ink-muted)]">{p.subcategory ?? p.category}</p>
                  <h4 class="truncate text-sm font-semibold text-white">{p.name}</h4>
                  <p class="mt-0.5 text-sm font-semibold" style={`color:${accent}`}>{formatBRL(p.price)}</p>
                </div>
                <button
                  type="button"
                  data-open-product={p.slug}
                  aria-label={`Ver ${p.name}`}
                  class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 text-white transition-colors group-hover:border-white/25"
                >
                  <Icon name="arrow-right" class="h-4 w-4" />
                </button>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
