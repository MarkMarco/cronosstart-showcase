---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import type { ServiceItem } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: ServiceItem[];
  id?: string;
}
const { eyebrow, title, description, items, id } = localizeDeep(Astro.props, locale);
---

<section id={id} class="bg-[var(--surface)] px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow={eyebrow} title={title} description={description} />

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item, index) => (
          <div
            data-animate
            style={`transition-delay: ${Math.min(index, 5) * 60}ms`}
            class="group rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface-alt)] p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-all hover:-translate-y-0.5 hover:border-[var(--accent)]/40 hover:shadow-[0_8px_24px_rgba(15,23,42,0.08)]"
          >
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-[var(--radius-control)] bg-[var(--surface)] text-[var(--primary)] transition-colors group-hover:text-[var(--accent)]">
              <Icon name={item.icon} class="h-5 w-5" />
            </div>
            <h3 class="text-base font-semibold text-[var(--ink)]">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
