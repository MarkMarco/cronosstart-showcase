---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import CardGrid from "./CardGrid.astro";
import GridCard from "./GridCard.astro";
import type { PropertyItem } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: PropertyItem[];
  id?: string;
}
const { eyebrow, title, description, items, id } = localizeDeep(Astro.props, locale);
---

<section id={id} class="bg-[var(--surface)] px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow={eyebrow} title={title} description={description} align="center" class="mx-auto" />

    <CardGrid cols={3} class="mt-10">
      {
        items.map((item, index) => (
          <GridCard variant="standard" animateDelay={Math.min(index, 5) * 60} class="!p-0 overflow-hidden">
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={item.image}
                alt={item.imageAlt}
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span
                class={`absolute left-3 top-3 rounded-full px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide ${
                  item.operation === "Venda" ? "bg-[var(--primary)] text-white" : "bg-[var(--accent)] text-white"
                }`}
              >
                {item.operation}
              </span>
            </div>

            <div class="p-6">
              <p class="text-lg font-semibold tracking-tight text-[var(--primary)]">{item.price}</p>
              <h3 class="mt-1 text-base font-semibold text-[var(--ink)]">{item.title}</h3>
              <p class="mt-1 flex items-center gap-1.5 text-sm text-[var(--ink-muted)]">
                <Icon name="map-pin" class="h-4 w-4 shrink-0" />
                {item.location}
              </p>

              <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 border-t border-[var(--border)] pt-3 text-xs text-[var(--ink-muted)]">
                {item.bedrooms !== undefined && (
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="bed" class="h-4 w-4 text-[var(--accent)]" />
                    {item.bedrooms} {item.bedrooms === 1 ? "quarto" : "quartos"}
                  </span>
                )}
                {item.area && (
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="maximize" class="h-4 w-4 text-[var(--accent)]" />
                    {item.area}
                  </span>
                )}
                {item.parking !== undefined && (
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="car" class="h-4 w-4 text-[var(--accent)]" />
                    {item.parking} {item.parking === 1 ? "vaga" : "vagas"}
                  </span>
                )}
                {item.note && (
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="check" class="h-4 w-4 text-[var(--accent)]" />
                    {item.note}
                  </span>
                )}
              </div>
            </div>

            <a
              slot="cta"
              href="#encontrar"
              class="inline-flex items-center gap-1.5 px-6 pb-6 text-xs font-semibold text-[var(--accent)]"
            >
              {t(locale, "Falar sobre este imóvel")}
              <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </a>
          </GridCard>
        ))
      }
    </CardGrid>
  </div>
</section>
