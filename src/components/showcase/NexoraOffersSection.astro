---
// "Upgrade da semana" — campanha comercial, não uma grade comum: produto
// principal em destaque + ofertas complementares, com economia e validade.
import Icon from "../ui/Icon.astro";
import NexoraProductVisual from "./NexoraProductVisual.astro";
import { productRenderVariant, moodForCategory } from "../../utils/nexoraProductRender";
import type { CatalogProduct } from "../../config/showcases/types";

interface Props {
  id?: string;
  primary: CatalogProduct;
  complementary: CatalogProduct[];
  accents: Record<string, string>;
}
const { id, primary, complementary, accents } = Astro.props;

function formatBRL(value: number) {
  return value.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}
function formatDate(iso?: string) {
  if (!iso) return "—";
  return new Date(iso).toLocaleDateString("pt-BR", { day: "2-digit", month: "long" });
}
const primaryAccent = accents[primary.category] ?? "#f59e0b";
const savingsPrimary = primary.previousPrice ? primary.previousPrice - primary.price : 0;
---

<section id={id} class="relative overflow-hidden border-b border-white/[0.06] bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
  <div class="pointer-events-none absolute -right-24 top-0 h-96 w-96 rounded-full bg-[#f59e0b] opacity-[0.1] blur-[120px]" />

  <div class="relative mx-auto max-w-[1400px]">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-animate>
      <div class="max-w-xl">
        <p class="mb-3 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-[#f59e0b]">
          <Icon name="zap" class="h-3.5 w-3.5" />
          Upgrade da semana
        </p>
        <h2 class="font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-white sm:text-4xl">Ofertas demonstrativas</h2>
        <p class="mt-3 text-base leading-relaxed text-[var(--ink-muted)]">Economia ilustrativa por tempo limitado — valores fictícios, apenas para demonstração.</p>
      </div>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1fr_1fr]">
      <div data-animate class="relative flex h-full flex-col overflow-hidden rounded-3xl border border-[#f59e0b]/30 bg-gradient-to-br from-[#1a1200]/40 to-transparent p-6 sm:p-8">
        <div class="relative min-h-[220px] flex-1 overflow-hidden rounded-2xl sm:min-h-[260px]">
          <NexoraProductVisual
            variant={productRenderVariant(primary)}
            accent={primaryAccent}
            mood={moodForCategory(primary.category)}
            photoSrc={primary.images?.main}
            photoAlt={primary.name}
            class="h-full w-full"
          />
          <span class="absolute left-3 top-3 rounded-full bg-[#f59e0b] px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-wide text-[#1a1200]">Oferta</span>
        </div>

        <div class="mt-5">
          <p class="text-xs uppercase tracking-wide text-[var(--ink-muted)]">{primary.subcategory ?? primary.category}</p>
          <h3 class="mt-1 font-[var(--font-heading)] text-2xl font-semibold text-white sm:text-3xl">{primary.name}</h3>
          <div class="mt-3 flex flex-wrap items-baseline gap-2.5">
            {primary.previousPrice && <span class="text-sm text-white/40 line-through">{formatBRL(primary.previousPrice)}</span>}
            <span class="text-2xl font-semibold text-white sm:text-3xl">{formatBRL(primary.price)}</span>
          </div>
          <p class="mt-0.5 text-xs text-[var(--ink-muted)]">ou 10x de {formatBRL(primary.price / 10)} (demonstrativo)</p>
          {savingsPrimary > 0 && (
            <p class="mt-1 text-sm font-semibold text-[#f59e0b]">Economia demonstrativa de {formatBRL(savingsPrimary)}</p>
          )}
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-[var(--ink-muted)]">
            <span>Válida até {formatDate(primary.offerEndsAt)}</span>
            <span>Estoque demonstrativo: {primary.stockQty ?? "—"} un.</span>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap gap-3">
          <button
            type="button"
            data-open-product={primary.slug}
            class="inline-flex items-center gap-2 rounded-full bg-[#f59e0b] px-5 py-2.5 text-sm font-semibold text-[#1a1200] transition-transform hover:-translate-y-0.5"
          >
            Ver oferta
            <Icon name="arrow-right" class="h-4 w-4" />
          </button>
          <button
            type="button"
            data-add-cart={primary.slug}
            class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-white/30"
          >
            <Icon name="cart" class="h-4 w-4" />
            Adicionar
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          complementary.map((p, i) => {
            const accent = accents[p.category] ?? "#f59e0b";
            const savings = p.previousPrice ? p.previousPrice - p.price : 0;
            return (
              <div
                data-animate
                style={`transition-delay: ${(i + 1) * 60}ms`}
                class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02]"
              >
                <div class="relative aspect-[4/3]">
                  <NexoraProductVisual
                    variant={productRenderVariant(p)}
                    accent={accent}
                    mood={moodForCategory(p.category)}
                    photoSrc={p.images?.main}
                    photoAlt={p.name}
                    class="h-full w-full"
                  />
                  <span class="absolute left-2.5 top-2.5 rounded-full bg-[#f59e0b] px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-wide text-[#1a1200]">Oferta</span>
                </div>
                <div class="flex flex-1 flex-col p-3.5">
                  <h4 class="line-clamp-1 text-sm font-semibold text-white">{p.name}</h4>
                  <div class="mt-1.5 flex items-baseline gap-1.5">
                    {p.previousPrice && <span class="text-xs text-white/40 line-through">{formatBRL(p.previousPrice)}</span>}
                    <span class="text-sm font-semibold text-white">{formatBRL(p.price)}</span>
                  </div>
                  {savings > 0 && <p class="mt-0.5 text-[0.7rem] text-[#f59e0b]">Economize {formatBRL(savings)}</p>}
                  <button type="button" data-open-product={p.slug} class="mt-auto pt-2.5 text-left text-xs font-medium text-[var(--ink-muted)] hover:text-white">
                    Ver oferta →
                  </button>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
