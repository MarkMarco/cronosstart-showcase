---
import SectionHeader from "../ui/SectionHeader.astro";
import CardGrid from "./CardGrid.astro";
import GridCard from "./GridCard.astro";
import Icon from "../ui/Icon.astro";
import type { DealerHighlight } from "../../config/showcases/types";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: DealerHighlight[];
  id?: string;
}
const { eyebrow, title, description, items, id } = Astro.props;
---

<section id={id} class="bg-[var(--surface-alt)] px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <SectionHeader eyebrow={eyebrow} title={title} description={description} align="center" class="mx-auto" />

    <CardGrid cols={4} tabletCols={2} class="mt-10">
      {
        items.map((item, index) => (
          <GridCard variant="outlined" animateDelay={index * 60}>
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[var(--primary)]/10 text-[var(--primary)]">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-[var(--ink)]">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{item.description}</p>
          </GridCard>
        ))
      }
    </CardGrid>
  </div>
</section>
