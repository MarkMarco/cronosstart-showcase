---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import type { FaqItem } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: FaqItem[];
  id?: string;
  /** Presença visual um pouco mais rica (sombra + selo decorativo). Opcional — não altera modelos existentes. */
  elevated?: boolean;
}
const { eyebrow, title, description, items, id, elevated = false } = localizeDeep(Astro.props, locale);
---

<section id={id} class="bg-[var(--surface-alt)] px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-3xl">
    <SectionHeader eyebrow={eyebrow} title={title} description={description} align="center" class="mx-auto" />

    <div class={`relative mt-8 divide-y divide-[var(--border)] rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--surface)] ${elevated ? "shadow-[0_25px_60px_-25px_rgba(43,38,33,0.18)]" : ""}`}>
      {elevated && (
        <span class="absolute -top-4 left-6 flex h-8 w-8 items-center justify-center rounded-full bg-[var(--primary)] text-[var(--primary-ink)] shadow-md">
          <Icon name="message-circle" class="h-4 w-4" />
        </span>
      )}
      {
        items.map((item) => (
          <details class="group px-6 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-sm font-semibold text-[var(--ink)] marker:content-none group-open:text-[var(--accent)]">
              {item.question}
              <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-[var(--ink-muted)] transition-transform duration-200 group-open:rotate-180 group-open:text-[var(--accent)]" />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
