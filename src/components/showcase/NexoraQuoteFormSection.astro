---
import Icon from "../ui/Icon.astro";
import type { CtaBand, ShowcaseContact } from "../../config/showcases/types";

interface Props {
  id?: string;
  cta: CtaBand;
  contact: ShowcaseContact;
}
const { id, cta, contact } = Astro.props;
const whatsappHref = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---

<section id={id} class="border-b border-white/[0.06] bg-[var(--surface)] px-6 py-16 sm:py-24">
  <div class="mx-auto grid max-w-[1400px] gap-12 lg:grid-cols-[1fr_1.05fr] lg:items-start">
    <div data-animate>
      <h2 class="font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-white sm:text-4xl">{cta.title}</h2>
      <p class="mt-3 max-w-md text-base leading-relaxed text-[var(--ink-muted)]">{cta.description}</p>

      <ul class="mt-6 space-y-3 text-sm text-[var(--ink-muted)]">
        <li class="flex items-center gap-3"><Icon name="phone" class="h-5 w-5 text-[var(--accent)]" />{contact.phone}</li>
        <li class="flex items-center gap-3"><Icon name="mail" class="h-5 w-5 text-[var(--accent)]" />{contact.email}</li>
        {contact.hours && <li class="flex items-center gap-3"><Icon name="clock" class="h-5 w-5 text-[var(--accent)]" />{contact.hours}</li>}
      </ul>

      <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">
        <Icon name="whatsapp" class="h-5 w-5" />
        Falar pelo WhatsApp
      </a>
      <p class="mt-2 text-xs text-[var(--ink-muted)]">Número de WhatsApp fictício ({contact.whatsappNumber}), apenas para demonstração.</p>
    </div>

    <form data-nx-quote-form data-animate style="transition-delay: 80ms" class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 sm:p-7">
      <p class="mb-5 text-xs font-medium uppercase tracking-wide text-[var(--ink-muted)]">Formulário demonstrativo — não envia dados</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-medium text-white sm:col-span-2">
          Nome
          <input type="text" name="name" required class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60" />
        </label>
        <label class="block text-sm font-medium text-white">
          Telefone
          <input type="tel" name="phone" required placeholder="(00) 00000-0000" class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60" />
        </label>
        <label class="block text-sm font-medium text-white">
          E-mail
          <input type="email" name="email" required class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60" />
        </label>
        <label class="block text-sm font-medium text-white">
          Cidade
          <input type="text" name="city" class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60" />
        </label>
        <label class="block text-sm font-medium text-white">
          Categoria de interesse
          <select name="category" class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60">
            <option>Smartphones</option>
            <option>Notebooks</option>
            <option>Computadores</option>
            <option>Monitores</option>
            <option>Áudio</option>
            <option>Acessórios</option>
            <option>Casa inteligente</option>
            <option>Gamer</option>
            <option>Não sei ainda</option>
          </select>
        </label>
        <label class="block text-sm font-medium text-white sm:col-span-2">
          Produto, kit ou comparação de interesse
          <input type="text" name="interest" data-quote-interest placeholder="Ex.: Nexora Vision X1, ou Kit Setup Gamer" class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60" />
        </label>
        <label class="block text-sm font-medium text-white">
          Perfil de uso
          <select name="usage" class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60">
            <option>Trabalho</option>
            <option>Estudo</option>
            <option>Jogos</option>
            <option>Criação de conteúdo</option>
            <option>Casa inteligente</option>
            <option>Uso geral</option>
          </select>
        </label>
        <label class="block text-sm font-medium text-white">
          Orçamento aproximado
          <select name="budget" class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60">
            <option>Até R$ 1.000</option>
            <option>R$ 1.000 a R$ 3.000</option>
            <option>R$ 3.000 a R$ 8.000</option>
            <option>Acima de R$ 8.000</option>
          </select>
        </label>
        <label class="block text-sm font-medium text-white sm:col-span-2">
          Mensagem
          <textarea name="message" rows="3" class="mt-1.5 w-full resize-none rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60"></textarea>
        </label>
        <label class="block text-sm font-medium text-white sm:col-span-2">
          Preferência de contato
          <select name="contactPreference" class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]/60">
            <option>WhatsApp</option>
            <option>E-mail</option>
            <option>Telefone</option>
          </select>
        </label>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 sm:col-span-2"
          style="background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);"
        >
          {cta.buttonLabel}
        </button>
        <p data-nx-quote-feedback role="status" class="hidden text-sm font-medium text-[var(--accent)] sm:col-span-2">
          Mensagem de demonstração — nenhum dado foi enviado.
        </p>
      </div>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-nx-quote-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      form.querySelector("[data-nx-quote-feedback]")?.classList.remove("hidden");
    });
  });

  window.addEventListener("nx:prefill-quote", ((event: CustomEvent<{ product?: string; kit?: string }>) => {
    const input = document.querySelector<HTMLInputElement>("[data-quote-interest]");
    if (!input) return;
    const value = event.detail.product ?? event.detail.kit;
    if (value) input.value = value;
  }) as EventListener);
</script>
