---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
import Icon from "../ui/Icon.astro";
import type { HighlightBandContent } from "../../config/showcases/types";

const locale = getLocale(Astro.url);
interface Props {
  content: HighlightBandContent;
}
const { content } = localizeDeep(Astro.props, locale);
---

<section class="bg-[var(--primary)] px-6 py-16 sm:py-20">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div data-animate>
      {content.eyebrow && (
        <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--accent)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
          {content.eyebrow}
        </p>
      )}
      <h2 class="max-w-xl text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl">
        {content.title}
      </h2>
      <p class="mt-4 max-w-lg text-base leading-relaxed text-white/65">{content.description}</p>
    </div>

    <div data-animate class="flex justify-center lg:justify-end" style="transition-delay: 80ms">
      <div class="w-full max-w-xs rounded-2xl border border-white/15 bg-white/[0.06] p-6 backdrop-blur-sm">
        <div
          class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-[var(--accent)]/15 text-[var(--accent)] ring-1 ring-[var(--accent)]/40"
        >
          <Icon name="shield-check" class="h-6 w-6" />
        </div>
        <p class="mt-4 text-base font-semibold text-white">{content.badgeLabel}</p>
        <p class="mt-1.5 text-sm leading-relaxed text-white/60">{content.badgeText}</p>
      </div>
    </div>
  </div>
</section>
