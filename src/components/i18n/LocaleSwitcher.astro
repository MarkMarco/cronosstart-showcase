---
import { alternateLocalePath, getLocale } from "../../i18n";

const locale = getLocale(Astro.url);
const alternate = alternateLocalePath(Astro.url.pathname);
const ptHref = locale === "pt-BR" ? Astro.url.pathname : alternate;
const esHref = locale === "es" ? Astro.url.pathname : alternate;
---

<nav class="cronos-locale-switch" aria-label={locale === "es" ? "Idioma" : "Idioma"}>
  <a href={ptHref} lang="pt-BR" hreflang="pt-BR" aria-current={locale === "pt-BR" ? "page" : undefined}>PT</a>
  <span aria-hidden="true">/</span>
  <a href={esHref} lang="es" hreflang="es" aria-current={locale === "es" ? "page" : undefined}>ES</a>
</nav>

<style>
  .cronos-locale-switch {
    position: fixed;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(127, 127, 127, 0.25);
    border-radius: 999px;
    background: color-mix(in srgb, Canvas 82%, transparent);
    backdrop-filter: blur(12px);
    color: CanvasText;
    font: 600 0.75rem/1 system-ui;
  }
  a { color: inherit; text-decoration: none; opacity: 0.65; }
  a[aria-current="page"] { opacity: 1; text-decoration: underline; text-underline-offset: 0.25rem; }
</style>
