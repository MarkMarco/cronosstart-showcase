---
import { getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
const locale = getLocale(Astro.url);
// Logo demonstrativo da Vértice Imóveis. Para substituir por um logo
// definitivo do cliente, basta trocar o conteúdo deste componente (ou
// apontar os slots "header-logo"/"footer-logo" em modelos/imobiliaria.astro
// para um novo componente) — nenhum outro arquivo depende deste marcador.
interface Props {
  variant?: "full" | "mark";
  class?: string;
}
const { variant = "full", class: className = "" } = localizeDeep(Astro.props, locale);
---

<span class={`inline-flex items-center gap-3 ${className}`}>
  <svg viewBox="0 0 40 40" class="h-9 w-9 shrink-0" aria-hidden="true">
    <path d="M4 30L20 8L36 30" fill="none" stroke="var(--primary)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
    <rect x="17.5" y="6" width="5" height="5" rx="1" fill="var(--accent)" transform="rotate(45 20 8.5)" />
  </svg>
  {variant === "full" && (
    <span class="leading-tight">
      <span class="block font-[var(--font-heading)] text-xl font-semibold tracking-tight text-[var(--ink)]">
        {t(locale, "Vértice")}
      </span>
      <span class="block -mt-1 text-[0.65rem] font-medium uppercase tracking-[0.2em] text-[var(--ink-muted)]">
        {t(locale, "Imóveis")}
      </span>
    </span>
  )}
</span>
