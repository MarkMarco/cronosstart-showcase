---
// Logo fictício da Vallora Advocacia — monograma "V" sobre moldura
// geométrica (escudo sutil) com uma linha horizontal fina evocando,
// de forma discreta, o fiel de uma balança — sem usar o ícone genérico
// de balança da justiça. variant "mark": só o símbolo. "horizontal":
// símbolo + nome (padrão). "tone" controla o traço para fundo claro/escuro.
interface Props {
  variant?: "horizontal" | "mark";
  tone?: "dark" | "light";
  class?: string;
}
const { variant = "horizontal", tone = "dark", class: className = "" } = Astro.props;

const shieldStroke = tone === "light" ? "#E2C98C" : "#4A0F1D";
const monogramFill = tone === "light" ? "#F5F0E8" : "#4A0F1D";
const nameColor = tone === "light" ? "#F5F0E8" : "#211C1D";
const subColor = tone === "light" ? "#E2C98C" : "#C7A35A";
---

<span class={`inline-flex items-center gap-3 ${className}`}>
  <svg viewBox="0 0 40 44" class="h-10 w-9 shrink-0" aria-hidden="true">
    <path
      d="M20 2.5l15 5v11c0 11-6.5 18.5-15 22-8.5-3.5-15-11-15-22v-11z"
      fill="none"
      stroke={shieldStroke}
      stroke-width="1.3"
    />
    <path d="M20 8l10.5 3.5v8c0 7.8-4.5 12.9-10.5 15.5-6-2.6-10.5-7.7-10.5-15.5v-8z" fill="none" stroke={shieldStroke} stroke-width="0.7" opacity="0.55" />
    <path
      d="M13 14.5h3.1l3.9 9.4 3.9-9.4H27l-6.2 14h-1.6z"
      fill={monogramFill}
    />
    <path d="M11.5 27.5h17" stroke="#C7A35A" stroke-width="1.1" stroke-linecap="round" />
    <circle cx="11.5" cy="27.5" r="1.3" fill="#C7A35A" />
    <circle cx="28.5" cy="27.5" r="1.3" fill="#C7A35A" />
  </svg>
  {variant === "horizontal" && (
    <span class="leading-tight">
      <span class="block text-xl font-semibold tracking-tight" style={`color:${nameColor}; font-family: var(--font-heading);`}>
        Vallora
      </span>
      <span class="block -mt-1 text-[0.62rem] font-medium uppercase tracking-[0.32em]" style={`color:${subColor}`}>
        Advocacia
      </span>
    </span>
  )}
</span>
