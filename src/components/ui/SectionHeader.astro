---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, description, align = "left", class: className = "" } = Astro.props;
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---

<div class={`max-w-2xl ${alignClass} ${className}`}>
  {eyebrow && (
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">
      {eyebrow}
    </p>
  )}
  <h2 class="text-3xl font-semibold tracking-tight text-[var(--ink)] sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-relaxed text-[var(--ink-muted)]">{description}</p>}
</div>
