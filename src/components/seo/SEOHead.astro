---
import { alternateLocalePath, getLocale, localizedPath, localizeDeep, t } from "../../i18n/index";
const locale = getLocale(Astro.url);
interface Props {
  title: string;
  description: string;
  canonicalURL: URL | string;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
  siteName?: string;
  themeColor?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, ogImage, ogImageAlt, robots, siteName, themeColor, structuredData } =
  localizeDeep(Astro.props, locale);

const absoluteOgImage = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateURL = new URL(alternateLocalePath(Astro.url.pathname), Astro.site);
const ptURL = locale === "pt-BR" ? canonicalURL : alternateURL;
const esURL = locale === "es" ? canonicalURL : alternateURL;
const localizedStructuredData = structuredData
  ? JSON.parse(JSON.stringify(structuredData), (key, value) => {
      if (key === "inLanguage") return locale;
      if (locale === "es" && typeof value === "string" && /^(?:name|headline|description|text|serviceType|articleSection)$/.test(key)) {
        return t(locale, value);
      }
      if (locale === "es" && typeof value === "string" && value.startsWith(Astro.site?.origin ?? "https://cronosstart.com.br")) {
        const parsed = new URL(value);
        parsed.pathname = localizedPath(parsed.pathname, locale);
        return parsed.toString();
      }
      return value;
    })
  : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="google-site-verification" content="T1N5Kl2_lV6uT4Pq3U-_2fSYZwNhT2AsWDbglzPNC_Y" />
{robots && <meta name="robots" content={robots} />}
{themeColor && <meta name="theme-color" content={themeColor} />}
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="pt-BR" href={ptURL} />
<link rel="alternate" hreflang="es" href={esURL} />
<link rel="alternate" hreflang="x-default" href={ptURL} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={locale === "es" ? "es_419" : "pt_BR"} />
{siteName && <meta property="og:site_name" content={siteName} />}
{absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
{absoluteOgImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

{localizedStructuredData && <script type="application/ld+json" set:html={JSON.stringify(localizedStructuredData)} />}
