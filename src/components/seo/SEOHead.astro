---
interface Props {
  title: string;
  description: string;
  canonicalURL: URL | string;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, canonicalURL, ogImage, ogImageAlt, robots, structuredData } = Astro.props;

const absoluteOgImage = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="google-site-verification" content="T1N5Kl2_lV6uT4Pq3U-_2fSYZwNhT2AsWDbglzPNC_Y" />
{robots && <meta name="robots" content={robots} />}
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalURL} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="pt_BR" />
{absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
{absoluteOgImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
