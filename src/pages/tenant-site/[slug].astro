---
import SiteRenderer from "../../components/launch/SiteRenderer.astro";
import {isSupabaseConfigured,supabaseServer} from "../../lib/launch/supabase";
export const prerender=false;
const {slug}=Astro.params; if(!isSupabaseConfigured())return Astro.redirect("https://cronosstart.com.br",302); const db=supabaseServer(Astro.cookies); const {data:site}=await db.rpc("get_public_site",{target_slug:slug}); if(!site)return new Response('<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex"><title>Site não encontrado · CronosStart</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0b1220;color:#f8fafc;font-family:system-ui,sans-serif}main{width:min(32rem,calc(100% - 3rem));text-align:center}p{color:#aab6c8;line-height:1.7}a{display:inline-block;margin-top:1rem;border-radius:999px;background:#315be8;color:white;padding:.85rem 1.2rem;text-decoration:none;font-weight:700}</style></head><body><main><p>404</p><h1>Site não encontrado</h1><p>Verifique o endereço informado ou visite o site principal da CronosStart.</p><a href="https://cronosstart.com.br/">Ir para a CronosStart</a></main></body></html>',{status:404,headers:{"content-type":"text/html; charset=utf-8","cache-control":"no-store"}}); const canonical=`https://${site.slug}.sites.cronosstart.com.br/`; const seo=site.settings?.seo??{};
---
<html lang={site.language}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{seo.title||site.name}</title><meta name="description" content={seo.description||`Site oficial de ${site.name}`}/><link rel="canonical" href={canonical}/><meta name="robots" content="index,follow"/><meta property="og:title" content={seo.title||site.name}/><meta property="og:description" content={seo.description||`Site oficial de ${site.name}`}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/></head><body><SiteRenderer site={site}/></body></html>
