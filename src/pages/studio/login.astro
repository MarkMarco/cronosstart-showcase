---
import StudioLayout from "../../layouts/StudioLayout.astro";
import { isSupabaseConfigured, supabaseServer } from "../../lib/launch/supabase";
import { st, studioLocale, studioPath } from "../../lib/launch/i18n";
import { safeStudioReturnTo } from "../../lib/launch/auth";
export const prerender = false;
const configured=isSupabaseConfigured(); const locale=studioLocale(Astro.url.toString()); const tr=(value:string)=>st(locale,value); const dashboard=studioPath(locale,"/studio");
const returnTo=safeStudioReturnTo(Astro.url.searchParams.get("return_to"),locale,dashboard);
if(configured){const db=supabaseServer(Astro.cookies);const {data:{user}}=await db.auth.getUser();if(user)return Astro.redirect(returnTo);}
const error=Astro.url.searchParams.get("error"); const errorMessage=error==="invalid_credentials"?tr("Informe um email válido e uma senha com pelo menos 8 caracteres."):error?tr("Não foi possível entrar. Confira o email e a senha e tente novamente."):"";
const notice=Astro.url.searchParams.get("notice"); const noticeMessage=notice==="check_email"?tr("Confira seu email para confirmar a conta e continuar."):notice==="password_updated"?tr("Senha atualizada. Entre novamente com sua nova senha."):"";
const recovery=studioPath(locale,"/studio/recuperar-senha");
---
<StudioLayout title={tr("Entrar")}><section class="mx-auto grid min-h-[calc(100vh-4rem)] max-w-6xl place-items-center px-5 py-16"><div class="grid w-full gap-10 lg:grid-cols-2 lg:items-center"><div><p class="mb-3 text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">{tr("Seu negócio online")}</p><h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">{tr("Crie um site bonito sem complicação.")}</h1><p class="mt-5 max-w-lg text-lg leading-relaxed text-[var(--ink-muted)]">{tr("Escolha um modelo profissional, personalize o conteúdo e publique gratuitamente.")}</p></div><div class="rounded-3xl border border-white/10 bg-white/[.04] p-6 sm:p-8">{!configured&&<div class="mb-5 rounded-xl border border-amber-400/30 bg-amber-400/10 p-4 text-sm text-amber-100">{tr("O Launch está instalado. Configure as variáveis do Supabase para ativar cadastro e login.")}</div>}{errorMessage&&<div role="alert" class="mb-5 rounded-xl border border-red-400/30 bg-red-400/10 p-4 text-sm text-red-100">{errorMessage}</div>}{noticeMessage&&<div role="status" class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-400/10 p-4 text-sm text-emerald-100">{noticeMessage}</div>}<form method="post" action="/api/launch/auth" class="grid gap-4"><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="locale" value={locale==="es-VE"?"es":"pt"}/><label class="grid gap-2 text-sm font-semibold">Email<input class="rounded-xl border border-white/15 bg-black/20 px-4 py-3" type="email" name="email" required autocomplete="email"/></label><label class="grid gap-2 text-sm font-semibold">{tr("Senha")}<input class="rounded-xl border border-white/15 bg-black/20 px-4 py-3" type="password" name="password" minlength="8" required autocomplete="current-password"/></label><a class="-mt-1 text-right text-sm text-[var(--accent)] hover:underline" href={`${recovery}?return_to=${encodeURIComponent(returnTo)}`}>{tr("Esqueci minha senha")}</a><div class="grid grid-cols-2 gap-3"><button name="intent" value="login" class="rounded-full bg-[var(--primary)] px-5 py-3 font-semibold">{tr("Entrar")}</button><button name="intent" value="signup" class="rounded-full border border-white/15 px-5 py-3 font-semibold">{tr("Criar conta")}</button></div></form></div></div></section></StudioLayout>
