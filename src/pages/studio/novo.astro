---
import StudioLayout from "../../layouts/StudioLayout.astro";
import { launchThemes } from "../../lib/launch/design";
import { st, studioLocale, studioPath } from "../../lib/launch/i18n";
import { isSupabaseConfigured, supabaseServer } from "../../lib/launch/supabase";
import { launchTemplates } from "../../lib/launch/templates";

export const prerender = false;
const locale = studioLocale(Astro.url.toString());
const tr = (value: string) => st(locale, value);
const base = studioPath(locale, "/studio");
const onboarding = `${base}/novo${Astro.url.search}`;
const login = `${base}/login?return_to=${encodeURIComponent(onboarding)}`;
if (!isSupabaseConfigured()) return Astro.redirect(login);
const db = supabaseServer(Astro.cookies);
const { data: { user } } = await db.auth.getUser();
if (!user) return Astro.redirect(login);
const { count } = await db.from("sites").select("id", { count: "exact", head: true }).eq("plan", "free");
if ((count ?? 0) >= 3) return Astro.redirect(`${base}?error=site_limit`);
const requestedTemplate = Astro.url.searchParams.get("template");
const selectedTemplate = launchTemplates.some((template) => template.id === requestedTemplate) ? requestedTemplate : "services";
const error = Astro.url.searchParams.get("error");
---

<StudioLayout title={tr("Criar site")}>
  <div class="mx-auto max-w-5xl px-5 py-12">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">{tr("Novo site")} · {(count ?? 0) + 1} {tr("de")} 3</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{tr("Conte um pouco sobre seu negócio")}</h1>
    {error && <p role="alert" class="mt-6 rounded-xl border border-red-400/30 bg-red-400/10 p-4 text-sm text-red-100">{tr(error === "invalid_slug" ? "Use apenas letras minúsculas, números e hífens no endereço." : "Não foi possível concluir esta ação.")}</p>}
    <form method="post" action="/api/launch/sites" class="mt-10 grid gap-8">
      <input type="hidden" name="locale" value={locale === "es-VE" ? "es" : "pt"} />
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-2 text-sm font-semibold">{tr("Nome da empresa")}<input class="rounded-xl border border-white/15 bg-white/[.04] px-4 py-3" name="name" required maxlength="100" /></label>
        <label class="grid gap-2 text-sm font-semibold">{tr("Endereço gratuito")}<input class="rounded-xl border border-white/15 bg-white/[.04] px-4 py-3" name="slug" required maxlength="48" placeholder={locale === "es-VE" ? "mi-empresa" : "minha-empresa"} /></label>
        <label class="grid gap-2 text-sm font-semibold">{tr("Segmento")}<input class="rounded-xl border border-white/15 bg-white/[.04] px-4 py-3" name="segment" required maxlength="80" /></label>
        <label class="grid gap-2 text-sm font-semibold">WhatsApp<input class="rounded-xl border border-white/15 bg-white/[.04] px-4 py-3" name="phone" maxlength="20" placeholder={locale === "es-VE" ? "+58 412 000 0000" : "+55 47 99999-9999"} /></label>
        <label class="grid gap-2 text-sm font-semibold sm:col-span-2">{tr("Descrição")}<textarea class="min-h-28 rounded-xl border border-white/15 bg-white/[.04] px-4 py-3" name="description" required maxlength="500"></textarea></label>
      </div>
      <fieldset>
        <legend class="text-xl font-semibold">{tr("Escolha um modelo")}</legend>
        <p class="mt-2 text-sm text-[var(--ink-muted)]">{tr("Modelo define a estrutura; tema define a aparência.")}</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">{launchTemplates.map((template) => <label class="cursor-pointer overflow-hidden rounded-2xl border border-white/10 bg-white/[.035] has-[:checked]:border-[var(--accent)]"><img src={template.image} alt="" class="aspect-[4/3] w-full object-cover" /><span class="block p-4"><input type="radio" name="template_id" value={template.id} checked={template.id === selectedTemplate} class="mr-2" /><strong>{tr(template.name)}</strong><small class="mt-1 block text-white/50">{tr(template.segment)}</small></span></label>)}</div>
      </fieldset>
      <fieldset>
        <legend class="text-xl font-semibold">{tr("Escolha um tema")}</legend>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{launchThemes.map((theme) => {
          const label = theme === "modern" ? "Moderno" : theme === "elegant" ? "Elegante" : theme === "minimal" ? "Minimalista" : "Vibrante";
          return <label class="cursor-pointer rounded-2xl border border-white/10 bg-white/[.035] p-4 has-[:checked]:border-[var(--accent)]"><input type="radio" name="theme" value={theme} checked={theme === "modern"} class="mr-2" /><strong>{tr(label)}</strong></label>;
        })}</div>
      </fieldset>
      <button class="justify-self-start rounded-full bg-[var(--primary)] px-6 py-3 font-semibold">{tr("Criar meu site")}</button>
    </form>
  </div>
</StudioLayout>
