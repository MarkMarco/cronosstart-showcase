---
import StudioLayout from "../../layouts/StudioLayout.astro";
import { isSupabaseConfigured } from "../../lib/launch/supabase";
import { safeStudioReturnTo } from "../../lib/launch/auth";
import { st, studioLocale, studioPath } from "../../lib/launch/i18n";
export const prerender = false;
const locale=studioLocale(Astro.url.toString()); const tr=(value:string)=>st(locale,value);
const returnTo=safeStudioReturnTo(Astro.url.searchParams.get("return_to"),locale);
const error=Astro.url.searchParams.get("error"); const sent=Astro.url.searchParams.get("sent")==="1";
const login=studioPath(locale,"/studio/login");
---
<StudioLayout title={tr("Recuperar senha")}><section class="mx-auto grid min-h-[calc(100vh-4rem)] max-w-xl place-items-center px-5 py-16"><div class="w-full rounded-3xl border border-white/10 bg-white/[.04] p-6 sm:p-8"><h1 class="text-3xl font-semibold">{tr("Recuperar senha")}</h1><p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">{tr("Informe o email da sua conta. Se ele estiver cadastrado, enviaremos um link seguro para criar uma nova senha.")}</p>{!isSupabaseConfigured()&&<div role="alert" class="mt-5 rounded-xl border border-amber-400/30 bg-amber-400/10 p-4 text-sm text-amber-100">{tr("A recuperação está indisponível enquanto o Supabase não estiver configurado.")}</div>}{error==="invalid_email"&&<div role="alert" class="mt-5 rounded-xl border border-red-400/30 bg-red-400/10 p-4 text-sm text-red-100">{tr("Informe um email válido.")}</div>}{sent&&<div role="status" class="mt-5 rounded-xl border border-emerald-400/30 bg-emerald-400/10 p-4 text-sm text-emerald-100">{tr("Se o email estiver cadastrado, você receberá as instruções em alguns minutos.")}</div>}<form method="post" action="/api/launch/auth" class="mt-6 grid gap-4"><input type="hidden" name="intent" value="request_recovery"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="locale" value={locale==="es-VE"?"es":"pt"}/><label class="grid gap-2 text-sm font-semibold">Email<input class="rounded-xl border border-white/15 bg-black/20 px-4 py-3" type="email" name="email" required autocomplete="email"/></label><button class="rounded-full bg-[var(--primary)] px-5 py-3 font-semibold">{tr("Enviar link de recuperação")}</button></form><a class="mt-5 inline-flex text-sm text-[var(--accent)] hover:underline" href={`${login}?return_to=${encodeURIComponent(returnTo)}`}>← {tr("Voltar para o login")}</a></div></section></StudioLayout>
