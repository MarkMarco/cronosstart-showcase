---
import { getLocale, localizedPath, localizeDeep, t } from "../i18n/index";
import LegalLayout from "../layouts/LegalLayout.astro";
import { company } from "../config/company";

const locale = getLocale(Astro.url);
const lastUpdated = new Date().toLocaleDateString("pt-BR", { year: "numeric", month: "long", day: "numeric" });
---

<LegalLayout
  title={t(locale, "Termos de Uso — CronosStart")}
  description="Condições gerais de uso do site e do portfólio de modelos demonstrativos da CronosStart."
>
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">{t(locale, "Documento legal")}</p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t(locale, "Termos de Uso")}</h1>
  <p class="mt-3 text-sm text-white/40">Última atualização: {lastUpdated}</p>

  <div class="mt-10 space-y-9">
    <section>
      <h2 class="text-lg font-semibold text-white">{t(locale, "1. Caráter informativo do site")}</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
        {t(locale, "Este site tem caráter institucional e informativo. Ele apresenta o portfólio de modelos de sites\n        desenvolvidos pela CronosStart e explica como funciona o nosso serviço de criação e gestão de presença\n        digital para pequenas empresas.")}
      </p>
    </section>

    <section>
      <h2 class="text-lg font-semibold text-white">{t(locale, "2. Modelos demonstrativos")}</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
        {t(locale, "Os modelos apresentados neste portfólio (como Atlas Contabilidade, Horizonte Seguros, Vértice Imóveis,\n        Essenza Restaurante, Aurum Motors e Orion Odontologia) são projetos demonstrativos. Os nomes, marcas,\n        empresas, pessoas, depoimentos, imagens e dados apresentados nesses modelos são fictícios e servem\n        exclusivamente para ilustrar possibilidades de layout e funcionalidades.")}
      </p>
    </section>

    <section>
      <h2 class="text-lg font-semibold text-white">{t(locale, "3. Valores, funcionalidades e prazos")}</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
        {t(locale, "As informações sobre planos, recursos e prazos apresentadas neste site são gerais e variam conforme as\n        necessidades de cada projeto. Valores comerciais, funcionalidades específicas e prazos de entrega são\n        definidos exclusivamente em proposta comercial e/ou contrato firmado entre a CronosStart e o cliente. Cada\n        projeto é personalizado conforme o escopo aprovado nessa proposta ou contrato.")}
      </p>
    </section>

    <section>
      <h2 class="text-lg font-semibold text-white">{t(locale, "4. Uso permitido do conteúdo")}</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
        {t(locale, "O conteúdo deste site pode ser acessado livremente para fins de consulta sobre os serviços da CronosStart.\n        Não é permitida a reprodução, cópia ou reutilização do conteúdo, layout, textos ou identidade visual para\n        fins comerciais sem autorização prévia.")}
      </p>
    </section>

    <section>
      <h2 class="text-lg font-semibold text-white">{t(locale, "5. Propriedade da identidade CronosStart")}</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
        {t(locale, "A marca, o logotipo e a identidade visual \"CronosStart\" são de propriedade da CronosSec e não podem ser\n        utilizados por terceiros sem autorização expressa.")}
      </p>
    </section>

    <section>
      <h2 class="text-lg font-semibold text-white">{t(locale, "6. O formulário de contato não representa contratação")}</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
        {t(locale, "O envio do formulário de contato presente neste site serve apenas para iniciar uma conversa comercial. Ele\n        não representa, por si só, a contratação de nenhum serviço. A contratação de qualquer serviço da\n        CronosStart ocorre somente mediante proposta comercial aceita e/ou contrato formalizado entre as partes.")}
      </p>
    </section>

    <section>
      <h2 class="text-lg font-semibold text-white">{t(locale, "7. Regras gerais de navegação")}</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
        {t(locale, "Ao navegar neste site, você concorda em não utilizá-lo para fins ilícitos, não tentar acessar áreas\n        restritas sem autorização e não utilizar meios automatizados para extrair conteúdo do site sem\n        consentimento prévio.")}
      </p>
    </section>

    <section>
      <h2 class="text-lg font-semibold text-white">{t(locale, "8. Contrato de prestação de serviços")}</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
        {t(locale, "Estes Termos de Uso não substituem o contrato de prestação de serviços. Questões relativas a domínio,\n        hospedagem, suporte, forma de pagamento, renovação, cancelamento, transferência, manutenção e\n        responsabilidades de cada parte são detalhadas no contrato comercial firmado no momento da contratação.")}
      </p>
    </section>

    <section>
      <h2 class="text-lg font-semibold text-white">{t(locale, "9. Dúvidas")}</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
        {t(locale, "Em caso de dúvidas sobre estes Termos de Uso, entre em contato pelo e-mail")}
        <a href={`mailto:${company.email}`} class="text-[var(--accent)] underline hover:text-white">{company.email}</a>.
      </p>
    </section>
  </div>
</LegalLayout>
