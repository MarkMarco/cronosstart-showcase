---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import { getLocale } from "../i18n/index";
import SEOHead from "../components/seo/SEOHead.astro";
import Analytics from "../components/analytics/Analytics.astro";
import LocaleSwitcher from "../components/i18n/LocaleSwitcher.astro";
import SiteHeader from "../components/vitrine/SiteHeader.astro";
import SiteFooter from "../components/vitrine/SiteFooter.astro";
import AstroAssistant from "../components/vitrine/AstroAssistant.astro";
import ContactFormModal from "../components/vitrine/ContactFormModal.astro";
import Icon from "../components/ui/Icon.astro";
import { launchTemplates } from "../lib/launch/templates";

const es = getLocale(Astro.url) === "es";
const c = es ? {
  title: "Crea tu sitio gratis | CronosStart",
  description: "Crea gratis un sitio profesional para tu negocio con CronosStart. Elige una plantilla, personaliza tu contenido y publica en una dirección gratuita.",
  eyebrow: "CronosStart Launch",
  headline: "Crea tu sitio gratis",
  hero: "Elige una plantilla profesional, agrega la información de tu negocio y publica una presencia digital clara, sin complicaciones.",
  cta: "Crear mi sitio gratis",
  secondary: "Ver plantillas",
  benefitsTitle: "Lo esencial para comenzar bien",
  benefits: [
    ["Plantillas profesionales", "Una base visual cuidada para presentar tu negocio con confianza."],
    ["Editor sencillo", "Cambia textos, secciones, tarjetas, imágenes, colores y contenido."],
    ["Publicación gratuita", "Publica, actualiza o retira tu sitio cuando lo necesites."],
  ],
  howTitle: "De la plantilla al sitio publicado",
  steps: [["Elige", "Selecciona la plantilla más cercana a tu negocio."], ["Personaliza", "Completa tus datos, servicios, imágenes y contacto."], ["Publica", "Revisa la vista previa y coloca tu sitio en línea."]],
  templatesTitle: "Elige tu punto de partida",
  customizeTitle: "Tu información, tu identidad",
  customizeText: "Puedes organizar secciones, editar servicios, diferenciales, galería, testimonios y preguntas frecuentes, además de ajustar imágenes, WhatsApp y SEO.",
  previewTitle: "La misma experiencia en computadora y celular",
  previewText: "La vista previa utiliza el mismo sistema que genera el sitio publicado, para que puedas revisar el resultado antes de publicarlo.",
  freeTitle: "Incluido en el sitio gratuito",
  freeItems: ["1 sitio por cuenta", "Editor de contenido y secciones", "Carga de imágenes", "Vista previa móvil y de escritorio", "Formulario de contacto y contactos recibidos", "Publicación y despublicación", "Configuración básica de SEO"],
  addressTitle: "Una dirección gratuita para comenzar",
  addressText: "Tu sitio utiliza una dirección como:",
  addressNote: "El plan gratuito no incluye dominio propio. No necesitas configurar DNS para comenzar.",
  compareTitle: "Elige la forma adecuada de avanzar",
  launchName: "Launch",
  launchText: "Para quien quiere comenzar de forma sencilla y gratuita, con una plantilla y las herramientas esenciales.",
  projectName: "Proyecto CronosStart",
  projectText: "Para empresas que necesitan una solución a medida, más páginas, integraciones, estrategia o funcionalidades específicas.",
  projectCta: "Hablar sobre un proyecto",
  faqTitle: "Preguntas frecuentes",
  faq: [["¿Es realmente gratuito?", "Sí. Puedes crear y publicar un sitio con los recursos indicados en esta página, sin mostrar precios ni solicitar pagos."], ["¿Puedo usar un dominio propio?", "El sitio gratuito utiliza una dirección de CronosStart. Los dominios propios corresponden a proyectos personalizados y no están incluidos en Launch Free."], ["¿Puedo cambiar la plantilla?", "La plantilla define el punto de partida. Después puedes editar contenido, secciones, tarjetas, imágenes y apariencia."], ["¿Qué ocurre si necesito algo específico?", "CronosStart también desarrolla proyectos personalizados para necesidades que van más allá del sitio gratuito."]],
  finalTitle: "Tu presencia digital puede comenzar hoy",
  finalText: "Elige una plantilla y crea tu primera versión gratis.",
} : {
  title: "Crie seu site grátis | CronosStart",
  description: "Crie gratuitamente um site profissional para seu negócio com a CronosStart. Escolha um modelo, personalize seu conteúdo e publique em um endereço gratuito.",
  eyebrow: "CronosStart Launch",
  headline: "Crie seu site grátis",
  hero: "Escolha um modelo profissional, adicione as informações do seu negócio e publique uma presença digital clara, sem complicação.",
  cta: "Criar meu site grátis",
  secondary: "Ver modelos",
  benefitsTitle: "O essencial para começar bem",
  benefits: [["Modelos profissionais", "Uma base visual bem cuidada para apresentar seu negócio com confiança."], ["Editor simples", "Altere textos, seções, cards, imagens, cores e conteúdo."], ["Publicação gratuita", "Publique, atualize ou retire seu site quando precisar."]],
  howTitle: "Do modelo ao site publicado",
  steps: [["Escolha", "Selecione o modelo mais próximo do seu negócio."], ["Personalize", "Preencha seus dados, serviços, imagens e contato."], ["Publique", "Revise o preview e coloque seu site no ar."]],
  templatesTitle: "Escolha seu ponto de partida",
  customizeTitle: "Suas informações, sua identidade",
  customizeText: "Você pode organizar seções, editar serviços, diferenciais, galeria, depoimentos e perguntas frequentes, além de ajustar imagens, WhatsApp e SEO.",
  previewTitle: "A mesma experiência no computador e no celular",
  previewText: "O preview utiliza o mesmo sistema que gera o site publicado, para você conferir o resultado antes de publicar.",
  freeTitle: "Incluído no site gratuito",
  freeItems: ["1 site por conta", "Editor de conteúdo e seções", "Upload de imagens", "Preview mobile e desktop", "Formulário de contato e leads recebidos", "Publicação e despublicação", "Configuração básica de SEO"],
  addressTitle: "Um endereço gratuito para começar",
  addressText: "Seu site utiliza um endereço como:",
  addressNote: "O plano gratuito não inclui domínio próprio. Você não precisa configurar DNS para começar.",
  compareTitle: "Escolha a forma certa de avançar",
  launchName: "Launch",
  launchText: "Para quem quer começar de forma simples e gratuita, com um modelo e as ferramentas essenciais.",
  projectName: "Projeto CronosStart",
  projectText: "Para empresas que precisam de uma solução sob medida, mais páginas, integrações, estratégia ou funcionalidades específicas.",
  projectCta: "Falar sobre um projeto",
  faqTitle: "Perguntas frequentes",
  faq: [["É realmente grátis?", "Sim. Você pode criar e publicar um site com os recursos informados nesta página, sem preços ou pagamentos."], ["Posso usar domínio próprio?", "O site gratuito utiliza um endereço CronosStart. Domínios próprios pertencem aos projetos personalizados e não estão incluídos no Launch Free."], ["Posso trocar o modelo?", "O modelo define o ponto de partida. Depois, você pode editar conteúdo, seções, cards, imagens e aparência."], ["E se eu precisar de algo específico?", "A CronosStart também desenvolve projetos personalizados para necessidades que vão além do site gratuito."]],
  finalTitle: "Sua presença digital pode começar hoje",
  finalText: "Escolha um modelo e crie sua primeira versão gratuitamente.",
};
const startHref = `/api/launch/start?locale=${es ? "es" : "pt"}&source=landing`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CronosStart Launch",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  inLanguage: es ? "es-VE" : "pt-BR",
  description: c.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
};
---
<html lang={es ? "es-VE" : "pt-BR"} style="--surface:#070b16;--surface-alt:#0d1424;--ink:#f3f6fb;--ink-muted:rgba(243,246,251,.62);--primary:#2f5fd1;--primary-ink:#fff;--accent:#38bdf8;--border:rgba(255,255,255,.1);--font-heading:'Space Grotesk Variable',system-ui,sans-serif;--font-body:'Inter Variable',system-ui,sans-serif">
<head><SEOHead title={c.title} description={c.description} canonicalURL={new URL(Astro.url.pathname,Astro.site)} robots="index, follow" ogImage="/images/og/home.png" ogImageAlt={c.headline} siteName="CronosStart" themeColor="#070b16" structuredData={structuredData}/><Analytics/></head>
<body class="min-h-screen bg-[var(--surface)] font-[var(--font-body)] text-[var(--ink)] antialiased"><LocaleSwitcher/><SiteHeader/>
<main>
  <section class="relative overflow-hidden px-6 py-20 sm:py-28"><div class="pointer-events-none absolute left-1/2 top-0 h-[28rem] w-[48rem] -translate-x-1/2 rounded-full bg-[var(--primary)] opacity-20 blur-[130px]"></div><div class="relative mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[1fr_.9fr]"><div><p class="text-xs font-semibold uppercase tracking-[.22em] text-[var(--accent)]">{c.eyebrow}</p><h1 class="mt-5 max-w-3xl text-5xl font-semibold leading-[1.04] tracking-tight text-white sm:text-7xl">{c.headline}</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--ink-muted)]">{c.hero}</p><div class="mt-9 flex flex-wrap gap-4"><a href={startHref} class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-7 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-0.5">{c.cta}<Icon name="arrow-right" class="h-4 w-4"/></a><a href="#modelos-launch" class="rounded-full border border-white/15 px-7 py-3.5 text-sm font-semibold text-white hover:border-[var(--accent)]">{c.secondary}</a></div></div><div class="relative mx-auto w-full max-w-xl"><div class="overflow-hidden rounded-2xl border border-white/15 bg-[#0a0e1a] p-2 shadow-2xl"><div class="flex gap-1.5 px-2 py-2"><i class="h-2 w-2 rounded-full bg-red-400"></i><i class="h-2 w-2 rounded-full bg-amber-400"></i><i class="h-2 w-2 rounded-full bg-emerald-400"></i></div><img src={launchTemplates[0].image} alt="" class="w-full rounded-xl"/></div><div class="absolute -bottom-8 -right-2 w-32 overflow-hidden rounded-[1.4rem] border-4 border-[#111827] bg-[#111827] shadow-xl sm:w-40"><img src={launchTemplates[1].image} alt="" class="aspect-[9/16] w-full object-cover object-top"/></div></div></div></section>
  <section class="border-y border-[var(--border)] bg-[var(--surface-alt)] px-6 py-20"><div class="mx-auto max-w-6xl"><h2 class="text-center text-3xl font-semibold text-white sm:text-4xl">{c.benefitsTitle}</h2><div class="mt-10 grid gap-5 md:grid-cols-3">{c.benefits.map(([title,text],i)=><article class="rounded-2xl border border-white/10 bg-white/[.025] p-7"><span class="text-sm font-bold text-[var(--accent)]">0{i+1}</span><h3 class="mt-4 text-xl font-semibold">{title}</h3><p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">{text}</p></article>)}</div></div></section>
  <section class="px-6 py-20 sm:py-24"><div class="mx-auto max-w-6xl"><h2 class="text-center text-3xl font-semibold sm:text-4xl">{c.howTitle}</h2><ol class="mt-12 grid gap-6 md:grid-cols-3">{c.steps.map(([title,text],i)=><li class="relative rounded-2xl border border-white/10 p-7"><span class="absolute right-5 top-3 text-5xl font-bold text-white/[.05]">0{i+1}</span><h3 class="text-xl font-semibold">{title}</h3><p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">{text}</p></li>)}</ol></div></section>
<section id="modelos-launch" class="scroll-mt-24 border-y border-[var(--border)] bg-[var(--surface-alt)] px-6 py-20"><div class="mx-auto max-w-6xl"><h2 class="text-center text-3xl font-semibold sm:text-4xl">{c.templatesTitle}</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{launchTemplates.map(template=>{const display=es?(template.id==="services"?["Empresa y servicios","Servicios"]:template.id==="legal"?["Servicios jurídicos","Jurídico"]:["Belleza y barbería","Belleza"]):[template.name,template.segment];return <article class="overflow-hidden rounded-2xl border border-white/10 bg-white/[.03]"><img src={template.image} alt={display[0]} class="aspect-[4/3] w-full object-cover"/><div class="p-5"><p class="text-xs text-[var(--accent)]">{display[1]}</p><h3 class="mt-1 text-lg font-semibold">{display[0]}</h3><a href={`/api/launch/start?locale=${es?"es":"pt"}&template=${template.id}&source=landing-template`} class="mt-4 inline-flex text-sm font-semibold text-[var(--accent)]">{c.cta} →</a></div></article>})}</div></div></section>
  <section class="px-6 py-20"><div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-2"><article class="rounded-3xl border border-white/10 bg-white/[.025] p-8 sm:p-10"><p class="text-xs font-semibold uppercase tracking-[.18em] text-[var(--accent)]">{c.customizeTitle}</p><p class="mt-5 text-lg leading-relaxed text-[var(--ink-muted)]">{c.customizeText}</p></article><article class="rounded-3xl border border-white/10 bg-white/[.025] p-8 sm:p-10"><p class="text-xs font-semibold uppercase tracking-[.18em] text-[var(--accent)]">{c.previewTitle}</p><p class="mt-5 text-lg leading-relaxed text-[var(--ink-muted)]">{c.previewText}</p><div class="mt-7 flex items-end gap-4"><div class="h-24 flex-1 rounded-lg border border-white/10 bg-gradient-to-br from-blue-500/20 to-cyan-400/5"></div><div class="h-20 w-11 rounded-lg border-2 border-white/20 bg-gradient-to-b from-blue-500/20 to-transparent"></div></div></article></div></section>
  <section class="border-y border-[var(--border)] bg-[var(--surface-alt)] px-6 py-20"><div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2"><div><h2 class="text-3xl font-semibold sm:text-4xl">{c.freeTitle}</h2><ul class="mt-7 grid gap-3 sm:grid-cols-2">{c.freeItems.map(item=><li class="flex gap-3 text-sm text-[var(--ink-muted)]"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--accent)]"/>{item}</li>)}</ul></div><div class="rounded-3xl border border-[var(--accent)]/25 bg-[var(--accent)]/[.05] p-8"><h2 class="text-2xl font-semibold">{c.addressTitle}</h2><p class="mt-4 text-[var(--ink-muted)]">{c.addressText}</p><code class="mt-5 block overflow-x-auto rounded-xl border border-white/10 bg-black/25 p-4 text-sm text-cyan-200">suaempresa.sites.cronosstart.com.br</code><p class="mt-4 text-sm text-white/45">{c.addressNote}</p></div></div></section>
  <section class="px-6 py-20"><div class="mx-auto max-w-6xl"><h2 class="text-center text-3xl font-semibold sm:text-4xl">{c.compareTitle}</h2><div class="mt-10 grid gap-6 md:grid-cols-2"><article class="rounded-3xl border border-[var(--accent)]/30 bg-[var(--accent)]/[.04] p-8"><p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">{c.launchName}</p><p class="mt-5 text-lg leading-relaxed text-[var(--ink-muted)]">{c.launchText}</p><a href={startHref} class="mt-7 inline-flex rounded-full bg-[var(--primary)] px-6 py-3 text-sm font-semibold">{c.cta}</a></article><article class="rounded-3xl border border-white/10 bg-white/[.025] p-8"><p class="text-xs font-bold uppercase tracking-[.2em] text-white/55">{c.projectName}</p><p class="mt-5 text-lg leading-relaxed text-[var(--ink-muted)]">{c.projectText}</p><button type="button" data-open-contact-form data-contact-origin="launch-comparison" class="mt-7 rounded-full border border-white/15 px-6 py-3 text-sm font-semibold">{c.projectCta}</button></article></div></div></section>
  <section class="border-y border-[var(--border)] bg-[var(--surface-alt)] px-6 py-20"><div class="mx-auto max-w-3xl"><h2 class="text-center text-3xl font-semibold">{c.faqTitle}</h2><div class="mt-9 space-y-3">{c.faq.map(([q,a])=><details class="rounded-2xl border border-white/10 bg-white/[.025] p-5"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">{a}</p></details>)}</div></div></section>
  <section class="px-6 py-20 sm:py-28"><div class="mx-auto max-w-4xl rounded-[2rem] border border-white/10 bg-gradient-to-br from-blue-600/20 to-cyan-400/[.04] p-10 text-center sm:p-16"><h2 class="text-3xl font-semibold sm:text-5xl">{c.finalTitle}</h2><p class="mx-auto mt-5 max-w-xl text-[var(--ink-muted)]">{c.finalText}</p><a href={startHref} class="mt-8 inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-7 py-3.5 text-sm font-semibold">{c.cta}<Icon name="arrow-right" class="h-4 w-4"/></a></div></section>
</main><SiteFooter/><ContactFormModal/><AstroAssistant/><script>const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add("is-visible");observer.unobserve(entry.target)}}),{threshold:.12});document.querySelectorAll("[data-animate]").forEach(element=>observer.observe(element));</script></body></html>
