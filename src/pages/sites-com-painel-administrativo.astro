---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import SiteHeader from "../components/vitrine/SiteHeader.astro";
import SiteFooter from "../components/vitrine/SiteFooter.astro";
import ContactFormModal from "../components/vitrine/ContactFormModal.astro";
import AstroAssistant from "../components/vitrine/AstroAssistant.astro";
import FAQSection from "../components/vitrine/FAQSection.astro";
import SEOHead from "../components/seo/SEOHead.astro";
import Analytics from "../components/analytics/Analytics.astro";
import Icon from "../components/ui/Icon.astro";
import { buildWhatsappLink, homeStructuredData, ORGANIZATION_ID, SITE_URL } from "../config/company";

const title = "Sites com Painel Administrativo | CronosStart";
const description =
  "Criamos sites com painel administrativo para atualizar produtos, imóveis, cardápios, serviços, preços e conteúdos sem depender do desenvolvedor.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const whatsappPanel = buildWhatsappLink(
  "Olá! Vi a página de sites com painel administrativo da CronosStart e gostaria de saber mais sobre um projeto com esse recurso."
);

const examples = [
  {
    icon: "home" as const,
    title: "Imobiliárias",
    description: "Atualizam imóveis, preços e disponibilidade sem depender de um desenvolvedor a cada mudança.",
    demoHref: "/modelos/imobiliaria",
    demoLabel: "Ver demonstração Vértice Imóveis",
  },
  {
    icon: "flame" as const,
    title: "Restaurantes",
    description: "Atualizam cardápio, preços e itens em destaque conforme a necessidade do dia a dia.",
    demoHref: "/modelos/restaurante",
    demoLabel: "Ver demonstração Essenza Restaurante",
  },
  {
    icon: "car" as const,
    title: "Concessionárias e lojas de veículos",
    description: "Atualizam o estoque de veículos disponíveis, com um painel administrativo demonstrativo já em funcionamento.",
    demoHref: "/modelos/aurum-motors/admin",
    demoLabel: "Ver painel demonstrativo Aurum Motors",
  },
  {
    icon: "tooth" as const,
    title: "Clínicas odontológicas",
    description: "Atualizam serviços, especialidades e equipe conforme a clínica cresce ou muda.",
    demoHref: "/modelos/orion-odontologia",
    demoLabel: "Ver demonstração Orion Odontologia",
  },
  {
    icon: "layers" as const,
    title: "Lojas e comércio",
    description: "Atualizam produtos, fotos e descrições de um catálogo digital sem precisar solicitar cada alteração.",
  },
  {
    icon: "briefcase" as const,
    title: "Empresas em geral",
    description: "Atualizam notícias, vagas abertas ou itens de portfólio conforme a empresa avança.",
  },
];

const audiences = [
  "Empresas que atualizam catálogo, estoque ou cardápio com frequência",
  "Negócios que crescem e precisam adicionar conteúdo regularmente",
  "Equipes que querem autonomia para pequenas mudanças no site",
  "Empresas que hoje dependem de pedir cada alteração a um desenvolvedor",
];

const features = [
  { icon: "layers" as const, label: "Cadastro e edição de itens (produtos, imóveis, cardápio, serviços)" },
  { icon: "sliders" as const, label: "Atualização de preços e disponibilidade" },
  { icon: "briefcase" as const, label: "Publicação de conteúdos (notícias, vagas, portfólio)" },
  { icon: "users" as const, label: "Gestão de equipe ou especialidades, quando aplicável" },
];

const security = [
  { icon: "key" as const, title: "Níveis de acesso", description: "É possível definir diferentes permissões conforme quem vai usar o painel." },
  { icon: "shield-check" as const, title: "Segurança", description: "O acesso ao painel é protegido e configurado conforme as necessidades do projeto." },
  { icon: "tool" as const, title: "Treinamento", description: "A equipe da empresa recebe orientação sobre como usar o painel no dia a dia." },
  { icon: "message-circle" as const, title: "Suporte", description: "Acompanhamento disponível para dúvidas e ajustes após o lançamento, conforme o plano contratado." },
];

const steps = [
  { title: "Levantamento de necessidades", description: "Entendemos o que precisa ser atualizado no site e com que frequência." },
  { title: "Definição do escopo do painel", description: "Definimos quais telas, campos e permissões fazem sentido para o seu projeto." },
  { title: "Desenvolvimento e testes", description: "Construímos o painel junto com o site e testamos o fluxo de atualização." },
  { title: "Treinamento e publicação", description: "Publicamos o site, orientamos a equipe e seguimos disponíveis para suporte." },
];

const faqItems = [
  {
    question: "Qual a diferença entre um site estático e um site com painel administrativo?",
    answer:
      "Um site estático tem o conteúdo definido no desenvolvimento e alterações dependem de uma solicitação. Um site com painel administrativo permite que a própria empresa atualize informações como produtos, preços ou conteúdo, sem depender do desenvolvedor a cada mudança.",
  },
  {
    question: "Quando o painel administrativo é realmente necessário?",
    answer:
      "Quando a empresa precisa atualizar informações com frequência — como estoque, cardápio, imóveis ou vagas — o painel evita depender de terceiros a cada alteração.",
  },
  {
    question: "Quando um site mais simples é suficiente?",
    answer:
      "Se o conteúdo muda raramente, um site institucional ou uma landing page sem painel costuma ser suficiente e mais rápido de desenvolver.",
  },
  {
    question: "Todos os painéis têm as mesmas funcionalidades?",
    answer:
      "Não. O painel é definido conforme a necessidade de cada projeto — as telas, campos e permissões variam de acordo com o que a empresa precisa atualizar.",
  },
  {
    question: "É possível adicionar novos recursos ao painel no futuro?",
    answer:
      "Sim. Conforme a empresa cresce ou surgem novas necessidades, o painel pode receber novos recursos, avaliados caso a caso.",
  },
  {
    question: "Minha equipe precisa saber programar para usar o painel?",
    answer:
      "Não. O painel é pensado para ser usado por quem não tem conhecimento técnico, com treinamento incluído na entrega.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    ...homeStructuredData["@graph"],
    {
      "@type": "Service",
      "@id": `${canonicalURL}#service`,
      name: "Sites com painel administrativo",
      serviceType: "Desenvolvimento de sites com painel administrativo",
      provider: { "@id": ORGANIZATION_ID },
      areaServed: [
        { "@type": "Country", name: "Brasil" },
        { "@type": "Place", name: "América Latina" },
      ],
      description,
      url: canonicalURL.toString(),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "CronosStart", item: SITE_URL },
        { "@type": "ListItem", position: 2, name: "Sites com Painel Administrativo", item: canonicalURL.toString() },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<html
  lang="pt-BR"
  style="--surface:#070b16; --surface-alt:#0d1424; --ink:#f3f6fb; --ink-muted:rgba(243,246,251,0.62); --primary:#2f5fd1; --primary-ink:#ffffff; --accent:#38bdf8; --border:rgba(255,255,255,0.1); --font-heading:'Space Grotesk Variable', system-ui, sans-serif; --font-body:'Inter Variable', system-ui, sans-serif;"
>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      robots="index, follow"
      ogImage="/images/og/home.png"
      ogImageAlt="CronosStart — Sites com painel administrativo"
      siteName="CronosStart"
      themeColor="#070b16"
      structuredData={structuredData}
    />
    <Analytics />
  </head>
  <body class="min-h-screen bg-[var(--surface)] font-[var(--font-body)] text-[var(--ink)] antialiased">
    <SiteHeader />

    <main>
      <!-- Hero -->
      <section class="relative overflow-hidden border-b border-[var(--border)] px-6 py-16 sm:py-24">
        <div
          class="pointer-events-none absolute -left-32 -top-40 h-[24rem] w-[24rem] rounded-full opacity-25 blur-[100px]"
          style="background: var(--primary);"
          aria-hidden="true"
        ></div>

        <div class="relative mx-auto max-w-4xl text-center">
          <p class="mb-3 flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">
            <Icon name="settings" class="h-4 w-4" />
            Autonomia para atualizar seu site
          </p>
          <h1 class="text-balance text-4xl font-semibold leading-[1.1] tracking-tight text-white sm:text-5xl">
            Sites com painel administrativo para sua empresa
          </h1>
          <p class="text-balance mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[var(--ink-muted)]">
            Atualize produtos, imóveis, cardápios, serviços, preços e conteúdos do seu site sem depender do
            desenvolvedor a cada mudança.
          </p>

          <div class="mt-9 flex flex-wrap justify-center gap-4">
            <button
              type="button"
              data-open-contact-form
              data-contact-origin="painel-hero"
              class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
              style="background: linear-gradient(135deg, var(--primary) 0%, color-mix(in srgb, var(--accent) 45%, var(--primary)) 100%); box-shadow: 0 12px 30px -8px rgba(47,95,209,0.6), inset 0 1px 0 rgba(255,255,255,0.25);"
            >
              Solicitar proposta
            </button>
            <a
              href={whatsappPanel}
              target="_blank"
              rel="noopener noreferrer"
              data-ga-origin="painel-hero"
              class="inline-flex items-center gap-2 rounded-full border border-white/15 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)] active:translate-y-0 active:scale-[0.98]"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              Falar no WhatsApp
            </a>
          </div>
        </div>
      </section>

      <!-- O que é um painel administrativo -->
      <section class="border-b border-[var(--border)] bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-3xl text-center">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">O conceito</p>
          <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">O que é um painel administrativo</h2>
          <p class="mt-5 text-base leading-relaxed text-[var(--ink-muted)]">
            É uma área privada do site, acessível apenas por quem tem permissão, onde a própria empresa consegue
            atualizar informações — como produtos, imóveis, cardápio, preços ou conteúdo — sem precisar mexer em
            código nem depender de uma solicitação ao desenvolvedor a cada alteração.
          </p>
        </div>
      </section>

      <!-- Exemplos de atualização -->
      <section class="border-b border-[var(--border)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Na prática</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Exemplos de atualização por segmento</h2>
          </div>
          <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {
              examples.map((item) => (
                <div class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.02] p-6">
                  <span
                    class="flex h-11 w-11 items-center justify-center rounded-xl border text-[var(--accent)]"
                    style="background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, var(--border));"
                  >
                    <Icon name={item.icon} class="h-5 w-5" />
                  </span>
                  <h3 class="mt-4 text-base font-semibold text-white">{item.title}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--ink-muted)]">{item.description}</p>
                  {item.demoHref && (
                    <a
                      href={item.demoHref}
                      class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium text-[var(--accent)] transition-colors hover:text-white"
                    >
                      {item.demoLabel}
                      <Icon name="arrow-right" class="h-3 w-3" />
                    </a>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Para quais empresas é indicado -->
      <section class="border-b border-[var(--border)] bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-3xl">
          <div class="text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Para quem é indicado</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Empresas que se beneficiam de um painel</h2>
          </div>
          <ul class="mx-auto mt-10 max-w-xl space-y-3">
            {
              audiences.map((item) => (
                <li class="flex items-start gap-3 rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3 text-sm text-white/80">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--accent)]" />
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mx-auto mt-6 max-w-xl text-center text-sm leading-relaxed text-white/40">
            Se as informações do site mudam raramente, um site institucional ou uma landing page sem painel costuma
            ser suficiente — veja a página de{" "}
            <a href="/sites-para-pequenas-empresas" class="underline underline-offset-2 hover:text-white">sites para pequenas empresas</a>.
          </p>
        </div>
      </section>

      <!-- Funcionalidades possíveis -->
      <section class="border-b border-[var(--border)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-4xl">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Recursos possíveis</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Funcionalidades que o painel pode ter</h2>
          </div>
          <ul class="mx-auto mt-10 grid max-w-2xl gap-3 sm:grid-cols-2">
            {
              features.map((item) => (
                <li class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3 text-sm text-white/80">
                  <Icon name={item.icon} class="h-4 w-4 shrink-0 text-[var(--accent)]" />
                  {item.label}
                </li>
              ))
            }
          </ul>
          <p class="mx-auto mt-6 max-w-xl text-center text-sm leading-relaxed text-white/40">
            Nem todo painel tem exatamente as mesmas funcionalidades — as telas e recursos são definidos conforme a
            necessidade de cada projeto.
          </p>
        </div>
      </section>

      <!-- Segurança e permissões -->
      <section class="border-b border-[var(--border)] bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Confiança</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Segurança, permissões e suporte</h2>
          </div>
          <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
              security.map((item) => (
                <div class="rounded-2xl border border-white/10 p-6" style="background: linear-gradient(160deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.01) 100%);">
                  <span
                    class="flex h-11 w-11 items-center justify-center rounded-xl border text-[var(--accent)]"
                    style="background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, var(--border));"
                  >
                    <Icon name={item.icon} class="h-5 w-5" />
                  </span>
                  <h3 class="mt-4 text-base font-semibold text-white">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{item.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Como funciona o desenvolvimento -->
      <section class="border-b border-[var(--border)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-5xl">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Como funciona</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Como funciona o desenvolvimento do painel</h2>
          </div>
          <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {
              steps.map((step, index) => (
                <li class="rounded-2xl border border-white/10 p-6" style="background: linear-gradient(160deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.01) 100%);">
                  <span class="text-3xl font-bold text-white/10">0{index + 1}</span>
                  <h3 class="mt-2 text-base font-semibold text-white">{step.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{step.description}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- FAQ -->
      <FAQSection
        id="faq-painel-administrativo"
        eyebrow="Dúvidas"
        title="Perguntas frequentes sobre painel administrativo"
        description="Respostas diretas para quem está avaliando um site com painel administrativo."
        items={faqItems}
        groupName="painel-faq"
      />

      <!-- CTA final -->
      <section class="relative overflow-hidden px-6 py-16 sm:py-24">
        <div class="relative mx-auto max-w-4xl">
          <div
            class="relative overflow-hidden rounded-[2rem] border border-white/10 px-6 py-16 text-center sm:px-16 sm:py-20"
            style="background: linear-gradient(160deg, #0b1020 0%, #060911 55%, #0a0f1e 100%);"
          >
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">Vamos conversar?</p>
            <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Quer mais autonomia para atualizar seu site?
            </h2>
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-[var(--ink-muted)]">
              Conte o que sua empresa precisa atualizar e ajudamos a definir o painel administrativo ideal.
            </p>
            <div class="mt-9 flex flex-wrap justify-center gap-4">
              <button
                type="button"
                data-open-contact-form
                data-contact-origin="painel-cta-final"
                class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
                style="background: linear-gradient(135deg, var(--primary) 0%, color-mix(in srgb, var(--accent) 45%, var(--primary)) 100%); box-shadow: 0 12px 30px -8px rgba(47,95,209,0.6), inset 0 1px 0 rgba(255,255,255,0.25);"
              >
                Solicitar proposta
              </button>
              <a
                href={whatsappPanel}
                target="_blank"
                rel="noopener noreferrer"
                data-ga-origin="painel-cta-final"
                class="inline-flex items-center gap-2 rounded-full border border-white/15 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)] active:translate-y-0 active:scale-[0.98]"
              >
                <Icon name="whatsapp" class="h-4 w-4" />
                Falar no WhatsApp
              </a>
            </div>

            <p class="mx-auto mt-8 max-w-lg text-xs leading-relaxed text-white/40">
              Veja também nossos <a href="/#modelos" class="underline underline-offset-2 hover:text-white">modelos demonstrativos</a>,
              os <a href="/#planos" class="underline underline-offset-2 hover:text-white">planos disponíveis</a>,
              <a href="/#como-funciona" class="underline underline-offset-2 hover:text-white">como funciona o projeto</a> e as páginas de
              <a href="/sites-para-pequenas-empresas" class="underline underline-offset-2 hover:text-white">sites para pequenas empresas</a>,
              <a href="/sites-para-imobiliarias" class="underline underline-offset-2 hover:text-white">sites para imobiliárias</a> e
              <a href="/criacao-de-sites-blumenau" class="underline underline-offset-2 hover:text-white">criação de sites em Blumenau</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
    <ContactFormModal />
    <AstroAssistant />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll("[data-animate]").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
