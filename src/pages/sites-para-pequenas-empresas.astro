---
import LocaleSwitcher from "../components/i18n/LocaleSwitcher.astro";
import { getLocale, localizedPath, localizeDeep, t } from "../i18n/index";
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import SiteHeader from "../components/vitrine/SiteHeader.astro";
import SiteFooter from "../components/vitrine/SiteFooter.astro";
import ContactFormModal from "../components/vitrine/ContactFormModal.astro";
import AstroAssistant from "../components/vitrine/AstroAssistant.astro";
import FAQSection from "../components/vitrine/FAQSection.astro";
import ShowcaseCard from "../components/vitrine/ShowcaseCard.astro";
import SEOHead from "../components/seo/SEOHead.astro";
import Analytics from "../components/analytics/Analytics.astro";
import Icon from "../components/ui/Icon.astro";
import { showcaseRegistry } from "../config/showcases";
import { buildWhatsappLink, homeStructuredData, ORGANIZATION_ID, SITE_URL } from "../config/company";

const locale = getLocale(Astro.url);
const title = t(locale, "Sites para Pequenas Empresas | CronosStart");
const description =
  t(locale, "Criamos sites profissionais para pequenas empresas, com domínio, hospedagem, WhatsApp, personalização, suporte e estrutura preparada para gerar contatos.");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const whatsappSmallBiz = buildWhatsappLink(
  "Olá! Vi a página de sites para pequenas empresas da CronosStart e gostaria de saber mais sobre um site para o meu negócio."
);

const problems = localizeDeep([
  {
    icon: "briefcase" as const,
    title: "Empresa sem presença profissional",
    description: "O negócio existe, atende bem, mas não tem um espaço próprio na internet que transmita essa credibilidade.",
  },
  {
    icon: "search" as const,
    title: "Cliente não encontra informações facilmente",
    description: "Horário, serviços, contato e localização espalhados entre perfis diferentes, sem um lugar único e organizado.",
  },
  {
    icon: "instagram" as const,
    title: "Dependência exclusiva de redes sociais",
    description: "Instagram e Facebook ajudam, mas o algoritmo decide quem vê — e o perfil não é um endereço que a empresa controla.",
  },
  {
    icon: "layers" as const,
    title: "Dificuldade para apresentar serviços",
    description: "Sem um espaço estruturado, fica difícil mostrar tudo o que a empresa oferece de forma clara.",
  },
  {
    icon: "message-circle" as const,
    title: "Perda de contatos",
    description: "Sem um caminho claro até o WhatsApp ou um formulário, parte do interesse se perde no caminho.",
  },
  {
    icon: "refresh" as const,
    title: "Site antigo ou não adaptado ao celular",
    description: "Um site desatualizado ou que não funciona bem no celular pode afastar quem está pesquisando pela empresa.",
  },
], locale);

const siteTypes = localizeDeep([
  {
    icon: "sparkle" as const,
    title: "Site institucional",
    description: "Apresenta a empresa, os serviços e os diferenciais em um único lugar, sob seu próprio domínio.",
  },
  {
    icon: "arrow-right" as const,
    title: "Landing page",
    description: "Página única e direta, para divulgar um serviço, produto ou campanha específica.",
  },
  {
    icon: "file-check" as const,
    title: "Catálogo de produtos ou serviços",
    description: "Organiza o que a empresa vende ou oferece, com fotos, descrições e valores quando fizer sentido.",
  },
], locale);

const included = localizeDeep([
  { icon: "whatsapp" as const, label: "Integração com WhatsApp" },
  { icon: "message-circle" as const, label: "Formulário de contato" },
  { icon: "key" as const, label: "Domínio" },
  { icon: "layers" as const, label: "Hospedagem" },
  { icon: "shield-check" as const, label: "Certificado SSL" },
  { icon: "arrow-right" as const, label: "Publicação" },
  { icon: "phone" as const, label: "Suporte" },
  { icon: "sliders" as const, label: "Personalização de acordo com a marca" },
  { icon: "trending-up" as const, label: "Possibilidade de expansão futura" },
], locale);

const benefits = localizeDeep([
  { title: "Mais contatos qualificados", description: "Um caminho claro até o WhatsApp e o formulário facilita quem já quer falar com a empresa." },
  { title: "Credibilidade imediata", description: "Ter um domínio próprio e um site bem estruturado transmite mais confiança do que apenas um perfil em rede social." },
  { title: "Facilidade para ser encontrado", description: "Um site otimizado ajuda quem está pesquisando pela empresa a encontrar as informações certas." },
  { title: "Presença que a empresa controla", description: "Diferente de um perfil em rede social, o site é um espaço que pertence à empresa." },
], locale);

const steps = localizeDeep([
  { title: "Entendemos seu negócio", description: "Conversamos sobre o que sua empresa faz, quem é o público e o que precisa aparecer no site." },
  { title: "Definimos a estrutura ideal", description: "Escolhemos entre site institucional, landing page ou catálogo, conforme o objetivo." },
  { title: "Personalizamos para sua marca", description: "Cores, textos, imagens e funcionalidades adaptados à identidade da sua empresa." },
  { title: "Publicamos e acompanhamos", description: "Colocamos o site no ar, com domínio e hospedagem prontos, e seguimos disponíveis para suporte." },
], locale);

const faqItems = localizeDeep([
  {
    question: "Minha empresa é pequena, vale a pena ter um site?",
    answer:
      "Sim. Mesmo empresas pequenas se beneficiam de um espaço próprio que reúne informações, facilita o contato e passa mais credibilidade do que depender só de redes sociais.",
  },
  {
    question: "Já tenho Instagram, preciso de site mesmo assim?",
    answer:
      "O Instagram ajuda na divulgação, mas não substitui um site: o domínio é seu, o conteúdo não depende do algoritmo e as informações ficam organizadas em um só lugar.",
  },
  {
    question: "Posso começar com um site simples e expandir depois?",
    answer:
      "Sim. É comum começar com um site institucional ou uma landing page e, conforme a necessidade, evoluir para um catálogo ou um painel administrativo.",
  },
  {
    question: "O site funciona bem no celular?",
    answer:
      "Sim. Todos os sites são responsivos, ou seja, se adaptam para funcionar bem em celular, tablet e computador.",
  },
  {
    question: "O domínio fica em nome da minha empresa?",
    answer:
      "Sim. Sempre que possível, o domínio é registrado em nome do cliente ou da empresa, e a CronosStart cuida da configuração técnica.",
  },
  {
    question: "Quanto tempo leva para o site ficar pronto?",
    answer:
      "Depende do tamanho e das funcionalidades do projeto. Sites institucionais e landing pages costumam ter prazo menor do que projetos com catálogo ou painel administrativo.",
  },
], locale);

const structuredData = localizeDeep({
  "@context": "https://schema.org",
  "@graph": [
    ...homeStructuredData["@graph"],
    {
      "@type": "Service",
      "@id": `${canonicalURL}#service`,
      name: "Sites profissionais para pequenas empresas",
      serviceType: "Criação de sites para pequenas empresas",
      provider: { "@id": ORGANIZATION_ID },
      areaServed: [
        { "@type": "Country", name: "Brasil" },
        { "@type": "Place", name: "América Latina" },
      ],
      description,
      url: canonicalURL.toString(),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "CronosStart", item: SITE_URL },
        { "@type": "ListItem", position: 2, name: "Sites para Pequenas Empresas", item: canonicalURL.toString() },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
}, locale);
---

<html
  lang={locale}
  style="--surface:#070b16; --surface-alt:#0d1424; --ink:#f3f6fb; --ink-muted:rgba(243,246,251,0.62); --primary:#2f5fd1; --primary-ink:#ffffff; --accent:#38bdf8; --border:rgba(255,255,255,0.1); --font-heading:'Space Grotesk Variable', system-ui, sans-serif; --font-body:'Inter Variable', system-ui, sans-serif;"
>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      robots="index, follow"
      ogImage="/images/og/home.png"
      ogImageAlt="CronosStart — Sites profissionais para pequenas empresas"
      siteName="CronosStart"
      themeColor="#070b16"
      structuredData={structuredData}
    />
    <Analytics />
  </head>
  <body class="min-h-screen bg-[var(--surface)] font-[var(--font-body)] text-[var(--ink)] antialiased">
    <LocaleSwitcher />
    <SiteHeader />

    <main>
      
      <section class="relative overflow-hidden border-b border-[var(--border)] px-6 py-16 sm:py-24">
        <div
          class="pointer-events-none absolute -right-32 -top-40 h-[24rem] w-[24rem] rounded-full opacity-25 blur-[100px]"
          style="background: var(--accent);"
          aria-hidden="true"
        ></div>

        <div class="relative mx-auto max-w-4xl text-center">
          <p class="mb-3 flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">
            <Icon name="briefcase" class="h-4 w-4" />
            {t(locale, "Para pequenas empresas")}
          </p>
          <h1 class="text-balance text-4xl font-semibold leading-[1.1] tracking-tight text-white sm:text-5xl">
            {t(locale, "Sites profissionais para pequenas empresas")}
          </h1>
          <p class="text-balance mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[var(--ink-muted)]">
            {t(locale, "Ajudamos pequenas empresas a ter presença profissional na internet, apresentar seus serviços com\n            clareza e facilitar o contato com clientes — com domínio, hospedagem, WhatsApp e suporte.")}
          </p>

          <div class="mt-9 flex flex-wrap justify-center gap-4">
            <button
              type="button"
              data-open-contact-form
              data-contact-origin="pequenas-empresas-hero"
              class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
              style="background: linear-gradient(135deg, var(--primary) 0%, color-mix(in srgb, var(--accent) 45%, var(--primary)) 100%); box-shadow: 0 12px 30px -8px rgba(47,95,209,0.6), inset 0 1px 0 rgba(255,255,255,0.25);"
            >
              {t(locale, "Solicitar proposta")}
            </button>
            <a
              href={whatsappSmallBiz}
              target="_blank"
              rel="noopener noreferrer"
              data-ga-origin="pequenas-empresas-hero"
              class="inline-flex items-center gap-2 rounded-full border border-white/15 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)] active:translate-y-0 active:scale-[0.98]"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              {t(locale, "Falar no WhatsApp")}
            </a>
          </div>
        </div>
      </section>

      
      <section class="border-b border-[var(--border)] bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{t(locale, "Situações comuns")}</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{t(locale, "Problemas que resolvemos para pequenas empresas")}</h2>
          </div>
          <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {
              problems.map((item) => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6">
                  <span
                    class="flex h-11 w-11 items-center justify-center rounded-xl border text-[var(--accent)]"
                    style="background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, var(--border));"
                  >
                    <Icon name={item.icon} class="h-5 w-5" />
                  </span>
                  <h3 class="mt-4 text-base font-semibold text-white">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{item.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      
      <section class="border-b border-[var(--border)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-5xl">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{t(locale, "Tipos de projeto")}</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{t(locale, "Tipos de site indicados para pequenas empresas")}</h2>
          </div>
          <div class="mt-12 grid gap-6 sm:grid-cols-3">
            {
              siteTypes.map((item) => (
                <div class="rounded-2xl border border-white/10 p-7 text-center" style="background: linear-gradient(160deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.01) 100%);">
                  <span
                    class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl border text-[var(--accent)]"
                    style="background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, var(--border));"
                  >
                    <Icon name={item.icon} class="h-6 w-6" />
                  </span>
                  <h3 class="mt-4 text-base font-semibold text-white">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{item.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      
      <section class="border-b border-[var(--border)] bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-4xl">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{t(locale, "Serviço completo")}</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{t(locale, "O que a CronosStart entrega")}</h2>
          </div>
          <ul class="mx-auto mt-10 grid max-w-2xl gap-3 sm:grid-cols-2">
            {
              included.map((item) => (
                <li class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3 text-sm text-white/80">
                  <Icon name={item.icon} class="h-4 w-4 shrink-0 text-[var(--accent)]" />
                  {item.label}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      
      <section class="border-b border-[var(--border)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-5xl">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{t(locale, "Benefícios")}</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{t(locale, "O que muda no dia a dia da empresa")}</h2>
          </div>
          <div class="mt-12 grid gap-5 sm:grid-cols-2">
            {
              benefits.map((item) => (
                <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.02] p-6">
                  <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-[var(--accent)]" />
                  <div>
                    <h3 class="text-base font-semibold text-white">{item.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{item.description}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      
      <section class="border-b border-[var(--border)] bg-[var(--surface-alt)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-[92rem]">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{t(locale, "Portfólio de modelos")}</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{t(locale, "Modelos demonstrativos por segmento")}</h2>
            <p class="mt-4 text-base leading-relaxed text-[var(--ink-muted)]">
              {t(locale, "Diferentes propostas visuais que servem de ponto de partida e podem ser personalizadas para o seu negócio.")}
            </p>
          </div>
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {showcaseRegistry.map((item, index) => <ShowcaseCard item={item} index={index} />)}
          </div>
        </div>
      </section>

      
      <section class="border-b border-[var(--border)] px-6 py-16 sm:py-24">
        <div class="mx-auto max-w-5xl">
          <div class="mx-auto max-w-2xl text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{t(locale, "Como funciona")}</p>
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{t(locale, "Do primeiro contato ao site no ar")}</h2>
          </div>
          <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {
              steps.map((step, index) => (
                <li class="rounded-2xl border border-white/10 p-6" style="background: linear-gradient(160deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.01) 100%);">
                  <span class="text-3xl font-bold text-white/10">0{index + 1}</span>
                  <h3 class="mt-2 text-base font-semibold text-white">{step.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">{step.description}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      
      <FAQSection
        id="faq-pequenas-empresas"
        eyebrow="Dúvidas"
        title={t(locale, "Perguntas frequentes de pequenas empresas")}
        description="Respostas diretas para quem está avaliando ter um site profissional pela primeira vez."
        items={faqItems}
        groupName="pequenas-empresas-faq"
      />

      
      <section class="relative overflow-hidden px-6 py-16 sm:py-24">
        <div class="relative mx-auto max-w-4xl">
          <div
            class="relative overflow-hidden rounded-[2rem] border border-white/10 px-6 py-16 text-center sm:px-16 sm:py-20"
            style="background: linear-gradient(160deg, #0b1020 0%, #060911 55%, #0a0f1e 100%);"
          >
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">{t(locale, "Vamos conversar?")}</p>
            <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              {t(locale, "Sua empresa pronta para ter presença profissional")}
            </h2>
            <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-[var(--ink-muted)]">
              {t(locale, "Conte sua ideia e ajudamos a definir a melhor estrutura para o site do seu negócio.")}
            </p>
            <div class="mt-9 flex flex-wrap justify-center gap-4">
              <button
                type="button"
                data-open-contact-form
                data-contact-origin="pequenas-empresas-cta-final"
                class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
                style="background: linear-gradient(135deg, var(--primary) 0%, color-mix(in srgb, var(--accent) 45%, var(--primary)) 100%); box-shadow: 0 12px 30px -8px rgba(47,95,209,0.6), inset 0 1px 0 rgba(255,255,255,0.25);"
              >
                {t(locale, "Solicitar proposta")}
              </button>
              <a
                href={whatsappSmallBiz}
                target="_blank"
                rel="noopener noreferrer"
                data-ga-origin="pequenas-empresas-cta-final"
                class="inline-flex items-center gap-2 rounded-full border border-white/15 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)] active:translate-y-0 active:scale-[0.98]"
              >
                <Icon name="whatsapp" class="h-4 w-4" />
                {t(locale, "Falar no WhatsApp")}
              </a>
            </div>

            <p class="mx-auto mt-8 max-w-lg text-xs leading-relaxed text-white/40">
              {t(locale, "Veja também nossos")} <a href={localizedPath("/#modelos", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "modelos demonstrativos")}</a>{t(locale, ",\n              os")} <a href={localizedPath("/#planos", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "planos disponíveis")}</a>,
              <a href={localizedPath("/#como-funciona", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "como funciona o projeto")}</a> {t(locale, "e as páginas de")}
              <a href={localizedPath("/sites-com-painel-administrativo", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "sites com painel administrativo")}</a>,
              <a href={localizedPath("/sites-para-imobiliarias", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "sites para imobiliárias")}</a>,
              <a href={localizedPath("/sites-para-restaurantes", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "sites para restaurantes")}</a> {t(locale, "e")}
              <a href={localizedPath("/criacao-de-sites-blumenau", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "criação de sites em Blumenau")}</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
    <ContactFormModal />
    <AstroAssistant />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll("[data-animate]").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
