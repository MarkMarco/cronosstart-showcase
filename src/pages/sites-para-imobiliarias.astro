            </p>

            <p class="mx-auto mt-6 max-w-lg text-xs leading-relaxed text-white/40">
              {t(locale, "Veja também nossos")} <a href={localizedPath("/#modelos", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "modelos demonstrativos")}</a>{t(locale, ",\n              os")} <a href={localizedPath("/#planos", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "planos disponíveis")}</a>,
              <a href={localizedPath("/#como-funciona", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "como funciona o projeto")}</a> {t(locale, "e as páginas de")}
              <a href={localizedPath("/sites-com-painel-administrativo", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "painel administrativo")}</a>,
              <a href={localizedPath("/sites-para-pequenas-empresas", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "pequenas empresas")}</a> {t(locale, "e")}
              <a href={localizedPath("/criacao-de-sites-blumenau", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "criação de sites em Blumenau")}</a> {t(locale, "e a de")}
              <a href={localizedPath("/sites-para-restaurantes", locale)} class="underline underline-offset-2 hover:text-white">{t(locale, "sites para restaurantes")}</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
    <ContactFormModal />
    <AstroAssistant />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll("[data-animate]").forEach((el) => observer.observe(el));
    </script>
  </body>
