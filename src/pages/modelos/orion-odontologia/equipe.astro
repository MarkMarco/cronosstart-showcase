---
import "@fontsource-variable/newsreader";
import "@fontsource-variable/inter";
import ShowcaseLayout from "../../../layouts/ShowcaseLayout.astro";
import OrionLogo from "../../../components/logos/OrionLogo.astro";
import DentistTeamSection from "../../../components/showcase/DentistTeamSection.astro";
import { orionOdontologiaConfig as config } from "../../../config/showcases/orion-odontologia";

const seo = {
  title: "Equipe — Orion Odontologia (modelo demonstrativo)",
  description: "Conheça a equipe multiespecialista da Orion Odontologia.",
};
---

<ShowcaseLayout config={{ ...config, seo }}>
  <OrionLogo slot="header-logo" />
  <OrionLogo slot="footer-logo" />

  <section class="bg-[var(--surface)] px-6 pb-8 pt-14 sm:pt-20">
    <div class="mx-auto max-w-6xl">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--primary)]">Equipe</p>
      <h1 class="text-3xl font-semibold tracking-tight text-[var(--ink)] sm:text-4xl">Quem cuida de você</h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-[var(--ink-muted)]">
        Especialistas de diferentes áreas, reunidos em um único plano de tratamento coordenado.
      </p>
    </div>
  </section>

  {config.team && (
    <DentistTeamSection
      title="Nossos especialistas"
      description="Cada paciente é acompanhado pelo especialista mais adequado ao seu caso, com comunicação constante entre a equipe."
      items={config.team}
    />
  )}
</ShowcaseLayout>
