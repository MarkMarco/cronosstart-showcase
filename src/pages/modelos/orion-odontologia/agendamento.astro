---
import { getLocale, localizedPath, localizeDeep, t } from "../../../i18n/index";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/inter";
import ShowcaseLayout from "../../../layouts/ShowcaseLayout.astro";
import OrionLogo from "../../../components/logos/OrionLogo.astro";
import ScheduleFormSection from "../../../components/showcase/ScheduleFormSection.astro";
import LocationHoursSection from "../../../components/showcase/LocationHoursSection.astro";
import { orionOdontologiaConfig as config } from "../../../config/showcases/orion-odontologia";

const locale = getLocale(Astro.url);
const seo = localizeDeep({
  title: "Agendamento — Orion Odontologia (modelo demonstrativo)",
  description: "Agende sua avaliação na Orion Odontologia. Modelo demonstrativo da CronosStart.",
}, locale);
---

<ShowcaseLayout config={{ ...config, seo }}>
  <OrionLogo slot="header-logo" />
  <OrionLogo slot="footer-logo" />

  {config.scheduleForm && <ScheduleFormSection content={config.scheduleForm} />}

  {config.sections.location && config.location && (
    <LocationHoursSection content={config.location} contact={config.contact} company={config.company} />
  )}
</ShowcaseLayout>
