---
import { getLocale, localizedPath, localizeDeep, t } from "../../../i18n/index";
import ShowcaseLayout from "../../../layouts/ShowcaseLayout.astro";
import NexoraLogo from "../../../components/logos/NexoraLogo.astro";
import Icon from "../../../components/ui/Icon.astro";
import { nexoraTechConfig as config, categories, brands, products, kits } from "../../../config/showcases/nexora-tech";

const locale = getLocale(Astro.url);
const seo = localizeDeep({
  title: "Painel administrativo — Nexora Tech (modelo demonstrativo)",
  description: "Painel administrativo demonstrativo de catálogo, comparador, kits e ofertas da Nexora Tech.",
}, locale);

const seedProducts = localizeDeep(products.map((p) => ({ ...p, archived: false })), locale);
const seedCategories = localizeDeep(categories.map((c) => ({ ...c })), locale);
const seedBrands = localizeDeep(brands.map((b) => ({ ...b })), locale);
const seedKits = localizeDeep(kits.map((k) => ({ ...k })), locale);

const seedBanners = localizeDeep([
  {
    id: "banner-1",
    title: "Nexora Vision X1 chegou",
    subtitle: "Lançamento com três câmeras e tela AMOLED 120Hz.",
    ctaLabel: "Ver lançamento",
    ctaHref: "#lancamentos",
    active: true,
    order: 1,
    startDate: "2026-07-01",
    endDate: "",
  },
  {
    id: "banner-2",
    title: "Até 15% em produtos selecionados",
    subtitle: "Ofertas por tempo limitado no catálogo.",
    ctaLabel: "Ver ofertas",
    ctaHref: "#ofertas",
    active: false,
    order: 2,
    startDate: "",
    endDate: "",
  },
], locale);

const seedRequests = localizeDeep([
  {
    id: "req-1", name: "Marina Souza", phone: "(11) 98888-2345", email: "marina@exemplo.com",
    interest: "Nexora Vision X1", category: "Smartphones", usage: "Uso geral", budget: "R$ 3.000 a R$ 8.000",
    message: "Gostaria de saber se tem entrega expressa.", contactPreference: "WhatsApp",
    status: "novo", notes: "", createdAt: "2026-07-22",
  },
  {
    id: "req-2", name: "Eduardo Lima", phone: "(21) 97777-6789", email: "eduardo@exemplo.com",
    interest: "Kit Setup Gamer", category: "Gamer", usage: "Jogos", budget: "Acima de R$ 8.000",
    message: "Quero confirmar compatibilidade do monitor com o notebook.", contactPreference: "E-mail",
    status: "em atendimento", notes: "Catálogo técnico enviado em 23/07.", createdAt: "2026-07-19",
  },
  {
    id: "req-3", name: "Patrícia Nogueira", phone: "(31) 96666-5432", email: "patricia@exemplo.com",
    interest: "Nexora Studio 14", category: "Notebooks", usage: "Criação de conteúdo", budget: "R$ 3.000 a R$ 8.000",
    message: "Confirmar prazo de garantia estendida.", contactPreference: "Telefone",
    status: "orçamento enviado", notes: "", createdAt: "2026-07-12",
  },
  {
    id: "req-4", name: "Vinícius Prado", phone: "(41) 95555-8765", email: "vinicius@exemplo.com",
    interest: "Nexora Home Hub", category: "Casa inteligente", usage: "Casa inteligente", budget: "Até R$ 1.000",
    message: "Pedido finalizado na loja física.", contactPreference: "WhatsApp",
    status: "concluído", notes: "Cliente satisfeito.", createdAt: "2026-06-28",
  },
], locale);

const seedSettings = localizeDeep({
  companyName: config.company.name,
  whatsapp: config.contact.whatsappNumber,
  phone: config.contact.phone,
  email: config.contact.email,
  address: `${config.contact.city}/${config.contact.state}`,
  hours: config.contact.hours ?? "",
  instagram: config.contact.instagram ?? "",
  facebook: config.contact.facebook ?? "",
  deliveryInfo: "Prazo e frete calculados no orçamento, conforme a região.",
  warrantyInfo: "Garantia demonstrativa — termos completos variam por fabricante.",
  institutionalText: config.company.description,
  footerText: "Modelo demonstrativo desenvolvido pela CronosStart.",
  defaultWhatsappMessage: config.contact.whatsappMessage,
}, locale);

const iconOptions = localizeDeep(["smartphone", "laptop", "cpu", "monitor", "headphones", "package", "wifi", "gamepad", "zap", "sparkle"], locale);
const categoryOptions = categories.filter((c) => c.slug !== "ofertas");

const tabs = localizeDeep([
  { id: "dashboard", label: "Dashboard" },
  { id: "produtos", label: "Produtos" },
  { id: "categorias", label: "Categorias" },
  { id: "marcas", label: "Marcas" },
  { id: "kits", label: "Kits" },
  { id: "ofertas", label: "Ofertas" },
  { id: "banners", label: "Banners" },
  { id: "solicitacoes", label: "Solicitações" },
  { id: "config", label: "Configurações" },
], locale);
---

<ShowcaseLayout config={{ ...config, seo }}>
  <NexoraLogo slot="header-logo" />
  <NexoraLogo slot="footer-logo" />

  <section class="bg-[var(--surface)] px-6 pb-16 pt-14 sm:pt-20">
    <div class="mx-auto max-w-6xl">
      <div data-login-gate class="mx-auto max-w-sm py-16 text-center">
        <span class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--primary)]/15 text-[var(--accent)]">
          <Icon name="key" class="h-6 w-6" />
        </span>
        <h1 class="font-[var(--font-heading)] text-2xl font-semibold tracking-tight text-white">{t(locale, "Acesso restrito")}</h1>
        <p class="mt-2 text-sm text-[var(--ink-muted)]">{t(locale, "Painel administrativo demonstrativo — Nexora Tech")}</p>
        <form data-login-form class="mt-8 space-y-3 text-left">
          <label class="block text-sm font-medium text-white">
            {t(locale, "E-mail")}
            <input type="email" value="admin@nexoratech-demo.com.br" readonly class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-[var(--ink-muted)] outline-none" />
          </label>
          <label class="block text-sm font-medium text-white">
            {t(locale, "Senha")}
            <input type="password" value="demonstracao" readonly class="mt-1.5 w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-[var(--ink-muted)] outline-none" />
          </label>
          <button type="submit" class="!mt-6 w-full rounded-full px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5" style="background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);">
            {t(locale, "Entrar no painel")}
          </button>
          <p class="text-center text-xs text-[var(--ink-muted)]">{t(locale, "Acesso demonstrativo — campos pré-preenchidos, qualquer clique em \"Entrar\" libera o acesso.")}</p>
        </form>
      </div>

      <div data-admin-content class="hidden">
        <div class="rounded-2xl border border-[var(--accent)]/30 bg-[var(--accent)]/10 px-5 py-4 text-sm text-white">
          <strong class="font-semibold">{t(locale, "Ambiente de demonstração.")}</strong> {t(locale, "As alterações abaixo ficam salvas apenas neste navegador (localStorage) e se refletem no site público enquanto você navegar neste mesmo navegador e dispositivo.")}
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{t(locale, "Painel administrativo")}</p>
            <h1 class="mt-2 font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t(locale, "Nexora Tech")}</h1>
          </div>
          <button type="button" data-action="reset-all" class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]">
            <Icon name="refresh" class="h-4 w-4" />
            {t(locale, "Restaurar dados originais")}
          </button>
        </div>

        <div class="-mx-6 mt-6 flex gap-2 overflow-x-auto px-6 pb-1" role="tablist">
          {tabs.map((tab) => (
            <button type="button" role="tab" data-tab-button={tab.id} class="shrink-0 rounded-full border border-white/10 px-4 py-2 text-sm font-medium text-[var(--ink-muted)] transition-colors">
              {tab.label}
            </button>
          ))}
        </div>

        
        <div data-panel="dashboard" class="mt-6">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Total de produtos")}</p>
              <p data-stat="total-produtos" class="mt-1 text-2xl font-semibold text-white">0</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Produtos ativos")}</p>
              <p data-stat="produtos-ativos" class="mt-1 text-2xl font-semibold text-white">0</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Lançamentos")}</p>
              <p data-stat="lancamentos" class="mt-1 text-2xl font-semibold text-[var(--accent)]">0</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Em oferta")}</p>
              <p data-stat="em-oferta" class="mt-1 text-2xl font-semibold text-[#f59e0b]">0</p>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Indisponíveis")}</p>
              <p data-stat="indisponiveis" class="mt-1 text-2xl font-semibold text-white">0</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Categorias ativas")}</p>
              <p data-stat="categorias-ativas" class="mt-1 text-2xl font-semibold text-white">0</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Marcas ativas")}</p>
              <p data-stat="marcas-ativas" class="mt-1 text-2xl font-semibold text-white">0</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Kits ativos")}</p>
              <p data-stat="kits-ativos" class="mt-1 text-2xl font-semibold text-white">0</p>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Banners ativos")}</p>
              <p data-stat="banners-ativos" class="mt-1 text-2xl font-semibold text-white">0</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Solicitações novas")}</p>
              <p data-stat="solicitacoes-novas" class="mt-1 text-2xl font-semibold text-white">0</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
              <p class="text-xs text-[var(--ink-muted)]">{t(locale, "Comparações demonstrativas")}</p>
              <p class="mt-1 text-2xl font-semibold text-white">—</p>
            </div>
          </div>
          <div class="mt-4 rounded-2xl border border-dashed border-white/15 p-4 text-sm text-[var(--ink-muted)]">
            {t(locale, "Em um projeto real, esta área também mostraria produtos mais visualizados e carrinhos/contatos demonstrativos com base em tráfego real. Como este é um modelo demonstrativo sem tráfego real, esses indicadores não são simulados aqui para não apresentar números fictícios como se fossem reais.")}
          </div>
        </div>

        
        <div data-panel="produtos" class="mt-6 hidden">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-white">{t(locale, "Produtos")}</h2>
            <button type="button" data-action="toggle-product-form" class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5" style="background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);">
              <Icon name="check" class="h-4 w-4" />
              {t(locale, "Adicionar produto")}
            </button>
          </div>

          <div class="mt-4 grid gap-3 rounded-2xl border border-white/10 bg-white/[0.02] p-4 sm:grid-cols-[1.3fr_1fr_1fr_auto]">
            <label class="block text-xs font-medium text-[var(--ink-muted)]">
              {t(locale, "Buscar")}
              <input type="text" data-p-search placeholder={t(locale, "Nome ou SKU...")} class="mt-1 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-3.5 py-2 text-sm text-white outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-xs font-medium text-[var(--ink-muted)]">
              {t(locale, "Categoria")}
              <select data-p-filter-category class="mt-1 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-3.5 py-2 text-sm text-white outline-none focus:border-[var(--accent)]">
                <option value="">{t(locale, "Todas")}</option>
                {categoryOptions.map((c) => <option value={c.slug}>{c.name}</option>)}
              </select>
            </label>
            <label class="block text-xs font-medium text-[var(--ink-muted)]">
              {t(locale, "Status")}
              <select data-p-filter-status class="mt-1 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-3.5 py-2 text-sm text-white outline-none focus:border-[var(--accent)]">
                <option value="">{t(locale, "Todos")}</option>
                <option value="disponivel">{t(locale, "Disponível")}</option>
                <option value="indisponivel">{t(locale, "Indisponível")}</option>
              </select>
            </label>
            <label class="flex items-center gap-2 text-xs font-medium text-[var(--ink-muted)] sm:pt-4">
              <input type="checkbox" data-p-show-archived class="h-4 w-4 rounded accent-[var(--accent)]" />
              {t(locale, "Arquivados")}
            </label>
          </div>

          <form data-product-form class="mt-6 hidden grid-cols-1 gap-6 rounded-2xl border border-white/10 bg-white/[0.02] p-6 lg:grid-cols-[1.3fr_1fr]">
            <div>
              <h3 data-product-form-title class="text-base font-semibold text-white">{t(locale, "Novo produto")}</h3>
              <input type="hidden" name="id" />
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <label class="block text-sm font-medium text-white sm:col-span-2">
                  {t(locale, "Nome")}
                  <input type="text" name="name" data-pf="name" required class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "SKU")}
                  <input type="text" name="sku" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Marca")}
                  <select name="brand" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]">
                    {seedBrands.map((b) => <option value={b.slug}>{b.name}</option>)}
                  </select>
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Categoria")}
                  <select name="category" data-pf="category" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]">
                    {categoryOptions.map((c) => <option value={c.slug}>{c.name}</option>)}
                  </select>
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Subcategoria")}
                  <input type="text" name="subcategory" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Preço (R$)")}
                  <input type="number" name="price" data-pf="price" required min="0" step="1" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Preço anterior (oferta)")}
                  <input type="number" name="previousPrice" min="0" step="1" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="flex items-center gap-2 self-end pb-2.5 text-sm font-medium text-white">
                  <input type="checkbox" name="offerActive" class="h-4 w-4 rounded accent-[var(--accent)]" />
                  {t(locale, "Oferta ativa")}
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Oferta válida até")}
                  <input type="date" name="offerEndsAt" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Estoque demonstrativo")}
                  <input type="number" name="stockQty" min="0" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Garantia demonstrativa")}
                  <input type="text" name="warranty" placeholder={t(locale, "Ex.: 12 meses")} class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Ícone")}
                  <select name="icon" data-pf="icon" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]">
                    {iconOptions.map((i) => <option value={i}>{i}</option>)}
                  </select>
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Cores (separadas por vírgula)")}
                  <input type="text" name="colors" placeholder={t(locale, "Preto espacial, Prata")} class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Materiais (separados por vírgula)")}
                  <input type="text" name="materials" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Dimensões")}
                  <input type="text" name="dimensions" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Selo (opcional)")}
                  <input type="text" name="badge" placeholder={t(locale, "Ex.: Destaque")} class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-white">
                  {t(locale, "Ordem de exibição")}
                  <input type="number" name="displayOrder" min="1" class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]" />
                </label>
                <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
                  <label class="flex items-center gap-2 text-sm font-medium text-white">
                    <input type="checkbox" name="available" checked class="h-4 w-4 rounded accent-[var(--accent)]" />
                    {t(locale, "Disponível")}
                  </label>
                  <label class="flex items-center gap-2 text-sm font-medium text-white">
                    <input type="checkbox" name="featured" class="h-4 w-4 rounded accent-[var(--accent)]" />
                    {t(locale, "Destaque")}
                  </label>
                  <label class="flex items-center gap-2 text-sm font-medium text-white">
                    <input type="checkbox" name="isNew" class="h-4 w-4 rounded accent-[var(--accent)]" />
                    {t(locale, "Lançamento")}
                  </label>
                </div>
                <label class="block text-sm font-medium text-white sm:col-span-2">
                  {t(locale, "Especificações (uma por linha, \"chave: valor\")")}
                  <textarea name="specs" rows="4" placeholder={"processador: Nexora N3\nmemoria: 8GB RAM"} class="mt-1.5 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-4 py-2.5 text-sm text-white outline-none focus:border-[var(--accent)]"></textarea>
                  <span class="mt-1 block text-xs text-[var(--ink-muted)]">{t(locale, "Estrutura livre — categorias diferentes podem usar campos diferentes.")}</span>
                </label>
                <div class="sm:col-span-2">
                  <p class="text-sm font-medium text-white">{t(locale, "Imagens do produto (opcional)")}</p>
                  <p class="mt-1 text-xs text-[var(--ink-muted)]">{t(locale, "Cole a URL de uma foto real para cada campo. Campos vazios continuam usando o render vetorial premium da categoria — nada é obrigatório.")}</p>
                  <div class="mt-2 grid gap-3 sm:grid-cols-2">
                    <label class="block text-xs font-medium text-white">
                      {t(locale, "Imagem principal")}
                      <input type="url" name="imageMain" placeholder={t(locale, "https://…")} class="mt-1 w-full rounded-lg border border-white/10 bg-[var(--surface)] px-3 py-2 text-sm text-white outline-none focus:border-[var(--accent)]" />
                    </label>
                    <label class="block text-xs font-medium text-white">
                      {t(locale, "Fundo limpo")}
