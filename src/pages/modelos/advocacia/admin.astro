---
import ShowcaseLayout from "../../../layouts/ShowcaseLayout.astro";
import ValloraLogo from "../../../components/logos/ValloraLogo.astro";
import Icon from "../../../components/ui/Icon.astro";
import { valloraAdvocaciaConfig as config, practiceAreas, legalProfessionals, legalArticles } from "../../../config/showcases/advocacia";

const seo = {
  title: "Painel administrativo — Vallora Advocacia (modelo demonstrativo)",
  description: "Painel administrativo demonstrativo de áreas de atuação, profissionais, conteúdos e solicitações da Vallora Advocacia.",
};

const seedAreas = practiceAreas.map((a) => ({ ...a }));
const seedProfessionals = legalProfessionals.map((p) => ({ ...p }));
const seedArticles = legalArticles.map((a) => ({ ...a }));
const seedFaq = (config.faq ?? []).map((f, i) => ({ id: `faq-${i + 1}`, question: f.question, answer: f.answer, order: i + 1, active: true }));

const seedBanners = [
  {
    id: "banner-1",
    title: "Modelo demonstrativo — conteúdos jurídicos atualizados mensalmente",
    active: false,
    order: 1,
  },
  {
    id: "banner-2",
    title: "Atendimento online disponível para todo o Brasil (demonstrativo)",
    active: false,
    order: 2,
  },
];

const seedRequests = [
  {
    id: "req-1",
    name: "Camila Bezerra",
    phone: "(11) 98888-1234",
    email: "camila@exemplo.com",
    city: "São Paulo/SP",
    personType: "Pessoa jurídica",
    area: "Direito Empresarial",
    contactPreference: "E-mail",
    description: "Gostaria de entender melhor o processo de due diligence para uma aquisição.",
    status: "novo",
    notes: "",
    createdAt: "2026-07-20",
  },
  {
    id: "req-2",
    name: "Thiago Andrade",
    phone: "(21) 97777-5678",
    email: "thiago@exemplo.com",
    city: "Rio de Janeiro/RJ",
    personType: "Pessoa física",
    area: "Família e Sucessões",
    contactPreference: "WhatsApp",
    description: "Preciso de orientação sobre inventário extrajudicial.",
    status: "em análise",
    notes: "Aguardando retorno com mais detalhes do caso.",
    createdAt: "2026-07-15",
  },
  {
    id: "req-3",
    name: "Beatriz Older",
    phone: "(31) 96666-4321",
    email: "beatriz@exemplo.com",
    city: "Belo Horizonte/MG",
    personType: "Pessoa jurídica",
    area: "Proteção de Dados e Compliance",
    contactPreference: "Telefone",
    description: "Quero adequar minha empresa à LGPD, mas não sei por onde começar.",
    status: "retorno solicitado",
    notes: "",
    createdAt: "2026-07-10",
  },
  {
    id: "req-4",
    name: "Marcelo Vianna",
    phone: "(41) 95555-8765",
    email: "marcelo@exemplo.com",
    city: "Curitiba/PR",
    personType: "Pessoa física",
    area: "Direito Imobiliário",
    contactPreference: "E-mail",
    description: "Vou comprar uma sala comercial e quero uma verificação documental antes.",
    status: "concluído",
    notes: "Atendimento demonstrativo finalizado.",
    createdAt: "2026-06-25",
  },
  {
    id: "req-5",
    name: "Solicitação de teste",
    phone: "(00) 00000-0000",
    email: "teste@exemplo.com",
    city: "—",
    personType: "Pessoa física",
    area: "Direito Civil",
    contactPreference: "WhatsApp",
    description: "Registro de teste do formulário.",
    status: "arquivado",
    notes: "",
    createdAt: "2026-05-02",
  },
];

const seedSettings = {
  companyName: config.company.name,
  subtitle: config.company.segment,
  whatsapp: config.contact.whatsappNumber,
  phone: config.contact.phone,
  email: config.contact.email,
  address: `${config.contact.city}/${config.contact.state}`,
  hours: config.contact.hours ?? "",
  instagram: config.contact.instagram ?? "",
  linkedin: config.contact.linkedin ?? "",
  institutionalText: config.company.description,
  footerText: "Modelo demonstrativo desenvolvido pela CronosStart.",
  demonstrativeDisclaimer: config.demonstrativeDisclaimer ?? "",
  defaultWhatsappMessage: config.contact.whatsappMessage,
};

const iconOptions = ["briefcase", "scale", "users", "trending-up", "file-check", "heart", "shield-check", "home", "landmark", "book-open", "sparkle"];

const tabs = [
  { id: "dashboard", label: "Dashboard" },
  { id: "areas", label: "Áreas de atuação" },
  { id: "profissionais", label: "Profissionais" },
  { id: "conteudos", label: "Conteúdos" },
  { id: "solicitacoes", label: "Solicitações" },
  { id: "faq", label: "FAQ" },
  { id: "banners", label: "Banners e hero" },
  { id: "config", label: "Configurações" },
];
---

<ShowcaseLayout config={{ ...config, seo }}>
  <ValloraLogo slot="header-logo" />
  <ValloraLogo slot="footer-logo" />

  <section class="bg-[var(--surface)] px-6 pb-16 pt-14 sm:pt-20">
    <div class="mx-auto max-w-6xl">
      <div data-login-gate class="mx-auto max-w-sm py-16 text-center">
        <span class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--primary)]/10 text-[var(--primary)]">
          <Icon name="key" class="h-6 w-6" />
        </span>
        <h1 class="font-[var(--font-heading)] text-2xl font-semibold tracking-tight text-[var(--ink)]">Acesso restrito</h1>
        <p class="mt-2 text-sm text-[var(--ink-muted)]">Painel administrativo demonstrativo — Vallora Advocacia</p>
        <form data-login-form class="mt-8 space-y-3 text-left">
          <label class="block text-sm font-medium text-[var(--ink)]">
            E-mail
            <input type="email" value="admin@vallora-advocacia-demo.com.br" readonly class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink-muted)] outline-none" />
          </label>
          <label class="block text-sm font-medium text-[var(--ink)]">
            Senha
            <input type="password" value="demonstracao" readonly class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink-muted)] outline-none" />
          </label>
          <button type="submit" class="!mt-6 w-full rounded-full bg-[var(--primary)] px-6 py-3 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5">
            Entrar no painel
          </button>
          <p class="text-center text-xs text-[var(--ink-muted)]">Acesso demonstrativo — campos pré-preenchidos, qualquer clique em "Entrar" libera o acesso.</p>
        </form>
      </div>

      <div data-admin-content class="hidden">
        <div class="rounded-2xl border border-[var(--accent)]/30 bg-[var(--accent)]/10 px-5 py-4 text-sm text-[var(--ink)]">
          <strong class="font-semibold">Ambiente de demonstração.</strong> As alterações abaixo ficam salvas apenas neste navegador (localStorage) e se refletem no site público enquanto você navegar neste mesmo navegador e dispositivo.
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Painel administrativo</p>
            <h1 class="mt-2 font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-[var(--ink)] sm:text-4xl">Vallora Advocacia</h1>
          </div>
          <button type="button" data-action="reset-all" class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-5 py-2.5 text-sm font-semibold text-[var(--ink)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]">
            <Icon name="refresh" class="h-4 w-4" />
            Restaurar dados originais
          </button>
        </div>

        <div class="-mx-6 mt-6 flex gap-2 overflow-x-auto px-6 pb-1" role="tablist">
          {tabs.map((tab) => (
            <button type="button" role="tab" data-tab-button={tab.id} class="shrink-0 rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--ink-muted)] transition-colors">
              {tab.label}
            </button>
          ))}
        </div>

        <!-- DASHBOARD -->
        <div data-panel="dashboard" class="mt-6">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Áreas de atuação</p>
              <p data-stat="areas-total" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Áreas ativas</p>
              <p data-stat="areas-ativas" class="mt-1 text-2xl font-semibold text-[var(--accent)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Profissionais ativos</p>
              <p data-stat="profissionais-ativos" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Artigos publicados</p>
              <p data-stat="artigos-publicados" class="mt-1 text-2xl font-semibold text-[var(--accent)]">0</p>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Artigos em rascunho</p>
              <p data-stat="artigos-rascunho" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Solicitações novas</p>
              <p data-stat="solicitacoes-novas" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Perguntas no FAQ</p>
              <p data-stat="faq-total" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Conteúdo em destaque</p>
              <p data-stat="conteudo-destaque" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
          </div>
          <div class="mt-4 rounded-2xl border border-dashed border-[var(--border)] p-4 text-sm text-[var(--ink-muted)]">
            Em um projeto real, esta área também mostraria visualizações e solicitações com base em tráfego real. Como este é um modelo demonstrativo sem tráfego real, esse indicador não é simulado aqui para não apresentar números fictícios como se fossem reais.
          </div>
        </div>

        <!-- ÁREAS DE ATUAÇÃO -->
        <div data-panel="areas" class="mt-6 hidden">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-[var(--ink)]">Áreas de atuação</h2>
            <button type="button" data-action="toggle-area-form" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-5 py-2.5 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5">
              <Icon name="check" class="h-4 w-4" />
              Nova área
            </button>
          </div>

          <form data-area-form class="mt-4 hidden grid-cols-1 gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-6 sm:grid-cols-2">
            <input type="hidden" name="slug" />
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Título
              <input type="text" name="title" required class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Ícone
              <select name="icon" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]">
                {iconOptions.map((i) => <option value={i}>{i}</option>)}
              </select>
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Ordem
              <input type="number" name="order" min="1" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Descrição curta
              <input type="text" name="shortDescription" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Descrição completa
              <textarea name="description" rows="3" class="mt-1.5 w-full resize-none rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]"></textarea>
            </label>
            <div class="flex items-center gap-4 sm:col-span-2">
              <label class="flex items-center gap-2 text-sm font-medium text-[var(--ink)]">
                <input type="checkbox" name="active" checked class="h-4 w-4 rounded accent-[var(--accent)]" />
                Ativa
              </label>
              <label class="flex items-center gap-2 text-sm font-medium text-[var(--ink)]">
                <input type="checkbox" name="featured" class="h-4 w-4 rounded accent-[var(--accent)]" />
                Destacar na home
              </label>
            </div>
            <div class="sm:col-span-2">
              <p class="mb-1.5 text-sm font-medium text-[var(--ink)]">Profissionais associados</p>
              <div data-area-professional-checkboxes class="grid max-h-40 grid-cols-2 gap-1.5 overflow-y-auto rounded-lg border border-[var(--border)] bg-[var(--surface)] p-3"></div>
            </div>
            <div class="flex gap-3 sm:col-span-2">
              <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-5 py-2.5 text-sm font-semibold text-[var(--primary-ink)]">Salvar área</button>
              <button type="button" data-action="cancel-area-form" class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-5 py-2.5 text-sm font-semibold text-[var(--ink)]">Cancelar</button>
            </div>
          </form>

          <div class="mt-6 overflow-x-auto rounded-2xl border border-[var(--border)]">
            <table class="w-full min-w-[680px] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[var(--border)] bg-[var(--surface-alt)] text-xs uppercase tracking-wide text-[var(--ink-muted)]">
                  <th class="px-4 py-3 font-medium">Área</th>
                  <th class="px-4 py-3 font-medium">Ordem</th>
                  <th class="px-4 py-3 font-medium">Destaque</th>
                  <th class="px-4 py-3 font-medium">Status</th>
                  <th class="px-4 py-3 font-medium text-right">Ações</th>
                </tr>
              </thead>
              <tbody data-area-table-body class="text-[var(--ink)]"></tbody>
            </table>
          </div>
        </div>

        <!-- PROFISSIONAIS -->
        <div data-panel="profissionais" class="mt-6 hidden">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-[var(--ink)]">Profissionais</h2>
            <button type="button" data-action="toggle-professional-form" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-5 py-2.5 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5">
              <Icon name="check" class="h-4 w-4" />
              Novo profissional
            </button>
          </div>
          <p class="mt-1 text-xs text-[var(--ink-muted)]">Nomes, fotos e formações devem permanecer sempre fictícios e claramente demonstrativos — nunca dados de pessoas reais.</p>

          <form data-professional-form class="mt-4 hidden grid-cols-1 gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-6 sm:grid-cols-2">
            <input type="hidden" name="slug" />
            <label class="block text-sm font-medium text-[var(--ink)]">
              Nome
              <input type="text" name="name" required class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Cargo
              <input type="text" name="role" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Área principal
              <select name="mainArea" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]">
                {seedAreas.map((a) => <option value={a.slug}>{a.title}</option>)}
              </select>
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Ordem
              <input type="number" name="order" min="1" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Resumo profissional
              <textarea name="summary" rows="2" class="mt-1.5 w-full resize-none rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]"></textarea>
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Idiomas (separados por vírgula)
              <input type="text" name="languages" placeholder="Português, Inglês" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Formação demonstrativa (separada por vírgula)
              <input type="text" name="education" placeholder="Instituição fictícia — curso" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Nota de registro (sempre demonstrativa)
              <input type="text" name="registrationNote" placeholder="Registro profissional demonstrativo" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Foto (URL)
              <input type="url" name="photo" placeholder="https://…" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="flex items-center gap-2 text-sm font-medium text-[var(--ink)]">
              <input type="checkbox" name="active" checked class="h-4 w-4 rounded accent-[var(--accent)]" />
              Ativo (visível no site)
            </label>
            <div class="flex gap-3 sm:col-span-2">
              <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-5 py-2.5 text-sm font-semibold text-[var(--primary-ink)]">Salvar profissional</button>
              <button type="button" data-action="cancel-professional-form" class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-5 py-2.5 text-sm font-semibold text-[var(--ink)]">Cancelar</button>
            </div>
          </form>

          <div class="mt-6 overflow-x-auto rounded-2xl border border-[var(--border)]">
            <table class="w-full min-w-[680px] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[var(--border)] bg-[var(--surface-alt)] text-xs uppercase tracking-wide text-[var(--ink-muted)]">
                  <th class="px-4 py-3 font-medium">Profissional</th>
                  <th class="px-4 py-3 font-medium">Área principal</th>
                  <th class="px-4 py-3 font-medium">Status</th>
                  <th class="px-4 py-3 font-medium text-right">Ações</th>
                </tr>
              </thead>
              <tbody data-professional-table-body class="text-[var(--ink)]"></tbody>
            </table>
          </div>
        </div>

        <!-- CONTEÚDOS -->
        <div data-panel="conteudos" class="mt-6 hidden">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-[var(--ink)]">Conteúdos</h2>
            <button type="button" data-action="toggle-article-form" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-5 py-2.5 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5">
              <Icon name="check" class="h-4 w-4" />
              Novo conteúdo
            </button>
          </div>

          <form data-article-form class="mt-4 hidden grid-cols-1 gap-6 rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-6 lg:grid-cols-[1.3fr_1fr]">
            <div>
              <input type="hidden" name="slug" />
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
                  Título
                  <input type="text" name="title" required data-af="title" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Categoria
                  <input type="text" name="category" data-af="category" placeholder="Empresas, Contratos, Trabalho…" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Autor (fictício)
                  <input type="text" name="author" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Data (demonstrativa)
                  <input type="date" name="date" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Tempo de leitura (min)
                  <input type="number" name="readTimeMinutes" min="1" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Status
                  <select name="status" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]">
                    <option value="draft">Rascunho</option>
                    <option value="published">Publicado</option>
                  </select>
                </label>
                <label class="flex items-center gap-2 self-end pb-2.5 text-sm font-medium text-[var(--ink)]">
                  <input type="checkbox" name="featured" class="h-4 w-4 rounded accent-[var(--accent)]" />
                  Destacar
                </label>
                <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
                  Imagem (URL)
                  <input type="url" name="image" placeholder="https://…" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
                  Resumo
                  <textarea name="summary" rows="2" data-af="summary" class="mt-1.5 w-full resize-none rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]"></textarea>
                </label>
                <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
                  Conteúdo (um parágrafo por linha)
                  <textarea name="content" rows="6" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]"></textarea>
                </label>
              </div>
              <div class="mt-5 flex flex-wrap gap-3">
                <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-6 py-2.5 text-sm font-semibold text-[var(--primary-ink)]">Salvar conteúdo</button>
                <button type="button" data-action="cancel-article-form" class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-6 py-2.5 text-sm font-semibold text-[var(--ink)]">Cancelar</button>
              </div>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--ink-muted)]">Pré-visualização</p>
              <div class="mt-3 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5">
                <p data-preview="category" class="text-xs font-medium uppercase tracking-wide text-[var(--accent)]">Categoria</p>
                <h3 data-preview="title" class="mt-1 text-base font-semibold text-[var(--ink)]">Título do conteúdo</h3>
                <p data-preview="summary" class="mt-2 text-xs text-[var(--ink-muted)]"></p>
              </div>
              <p class="mt-2 text-xs text-[var(--ink-muted)]">Aviso fixo exibido junto ao conteúdo público: "{config.demonstrativeDisclaimer}"</p>
            </div>
          </form>

          <div class="mt-6 overflow-x-auto rounded-2xl border border-[var(--border)]">
            <table class="w-full min-w-[720px] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[var(--border)] bg-[var(--surface-alt)] text-xs uppercase tracking-wide text-[var(--ink-muted)]">
                  <th class="px-4 py-3 font-medium">Conteúdo</th>
                  <th class="px-4 py-3 font-medium">Categoria</th>
