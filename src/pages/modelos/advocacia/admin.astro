    }
    const edit = target.getAttribute("data-banner-edit");
    if (edit) {
      const b = state.banners.find((x) => x.id === edit);
      if (!b) return;
      bannerForm.querySelector('[name="id"]').value = b.id;
      bannerForm.querySelector('[name="title"]').value = b.title;
      bannerForm.querySelector('[name="order"]').value = String(b.order);
      bannerForm.querySelector('[name="active"]').checked = Boolean(b.active);
      bannerForm.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }
    const del = target.getAttribute("data-banner-delete");
    if (del) {
      const key = `banner-${del}`;
      if (!pendingDeletes.has(key)) {
        pendingDeletes.add(key); target.textContent = "Confirmar?"; target.classList.add("text-red-500");
        setTimeout(() => pendingDeletes.delete(key), 4000); return;
      }
      pendingDeletes.delete(key);
      state.banners = state.banners.filter((x) => x.id !== del);
      saveState(state); renderBanners();
    }
  });

  // ============ CONFIGURAÇÕES ============
  const settingsForm = document.querySelector("[data-settings-form]");
  function loadSettingsForm() {
    Object.entries(state.settings).forEach(([key, value]) => {
      const field = settingsForm.querySelector(`[name="${key}"]`);
      if (field) field.value = value;
    });
  }
  settingsForm.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(settingsForm);
    Object.keys(state.settings).forEach((key) => {
      state.settings[key] = String(data.get(key) || "");
    });
    saveState(state);
    settingsForm.querySelector("[data-settings-feedback]")?.classList.remove("hidden");
    window.setTimeout(() => settingsForm.querySelector("[data-settings-feedback]")?.classList.add("hidden"), 3000);
  });

  // ============ RESET ============
  document.querySelector('[data-action="reset-all"]').addEventListener("click", () => {
    if (!confirm("Restaurar todos os dados originais? Isso apaga as alterações feitas neste navegador.")) return;
    try { window.localStorage.removeItem(STORAGE_KEY); } catch {}
    window.location.reload();
  });

  // --- Init ---
  renderDashboard();
  renderAreas();
  renderProfessionals();
  renderArticles();
  renderRequests();
  renderFaq();
  renderBanners();
  loadSettingsForm();
</script>
