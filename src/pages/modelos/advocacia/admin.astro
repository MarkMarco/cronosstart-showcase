                <input type="number" name="order" min="1" class="mt-1.5 w-24 rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 py-2 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
              </label>
              <label class="flex items-center gap-2 self-end pb-2.5 text-sm font-medium text-[var(--ink)]">
