          <div class="mt-6 overflow-x-auto rounded-2xl border border-[var(--border)]">
            <table class="w-full min-w-[560px] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[var(--border)] bg-[var(--surface-alt)] text-xs uppercase tracking-wide text-[var(--ink-muted)]">
                  <th class="px-4 py-3 font-medium">Pergunta</th>
                  <th class="px-4 py-3 font-medium">Ordem</th>
                  <th class="px-4 py-3 font-medium">Status</th>
                  <th class="px-4 py-3 font-medium text-right">Ações</th>
