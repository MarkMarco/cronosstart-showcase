              <tbody data-faq-table-body class="text-[var(--ink)]"></tbody>
            </table>
          </div>
        </div>

        <!-- BANNERS -->
        <div data-panel="banners" class="mt-6 hidden">
          <h2 class="text-lg font-semibold text-[var(--ink)]">Banners e hero</h2>
          <p class="mt-1 text-xs text-[var(--ink-muted)]">Uma faixa de aviso opcional exibida no topo do site público, abaixo do menu. Apenas um banner ativo por vez (o de menor ordem).</p>
          <form data-banner-form class="mt-4 grid gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-6 sm:grid-cols-2">
            <input type="hidden" name="id" />
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Texto do banner
              <input type="text" name="title" required class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Ordem
              <input type="number" name="order" min="1" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="flex items-center gap-2 self-end pb-2.5 text-sm font-medium text-[var(--ink)]">
              <input type="checkbox" name="active" class="h-4 w-4 rounded accent-[var(--accent)]" />
