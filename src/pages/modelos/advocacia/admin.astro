              Mensagem padrão do WhatsApp
              <textarea name="defaultWhatsappMessage" rows="2" class="mt-1.5 w-full resize-none rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]"></textarea>
            </label>
            <div class="sm:col-span-2">
              <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-6 py-2.5 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5">
                Salvar configurações
              </button>
              <p data-settings-feedback role="status" class="mt-2 hidden text-sm font-medium text-[var(--accent)]">Configurações salvas neste navegador.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</ShowcaseLayout>

<script define:vars={{ seedAreas, seedProfessionals, seedArticles, seedFaq, seedBanners, seedRequests, seedSettings }}>
  const STORAGE_KEY = "vallora-advocacia-admin-v1";
  const AUTH_KEY = "vallora-advocacia-admin-authed";

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch]));
  }
  function slugify(text) {
    return text.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  }

  function loadState() {
    const seed = {
      areas: seedAreas,
      professionals: seedProfessionals,
      articles: seedArticles,
      faq: seedFaq,
      banners: seedBanners,
      requests: seedRequests,
      settings: seedSettings,
    };
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      if (raw) return { ...seed, ...JSON.parse(raw) };
    } catch {}
    saveState(seed);
    return seed;
  }
  function saveState(next) {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
    } catch {}
  }

  let state = loadState();
  const pendingDeletes = new Set();

  // --- Login ---
  const loginGate = document.querySelector("[data-login-gate]");
  const adminContent = document.querySelector("[data-admin-content]");
  const loginForm = document.querySelector("[data-login-form]");
  function unlock() {
    loginGate.classList.add("hidden");
    adminContent.classList.remove("hidden");
    try { window.sessionStorage.setItem(AUTH_KEY, "1"); } catch {}
  }
  loginForm.addEventListener("submit", (e) => { e.preventDefault(); unlock(); });
  try { if (window.sessionStorage.getItem(AUTH_KEY) === "1") unlock(); } catch {}

  // --- Tabs ---
  const tabButtons = Array.from(document.querySelectorAll("[data-tab-button]"));
  const panels = Array.from(document.querySelectorAll("[data-panel]"));
  function activateTab(id) {
    tabButtons.forEach((btn) => {
      const active = btn.dataset.tabButton === id;
      btn.classList.toggle("bg-[var(--primary)]", active);
      btn.classList.toggle("text-[var(--primary-ink)]", active);
      btn.classList.toggle("border-transparent", active);
      btn.classList.toggle("text-[var(--ink-muted)]", !active);
    });
    panels.forEach((panel) => panel.classList.toggle("hidden", panel.dataset.panel !== id));
  }
  tabButtons.forEach((btn) => btn.addEventListener("click", () => activateTab(btn.dataset.tabButton)));
  activateTab("dashboard");

  // --- Dashboard ---
  function renderDashboard() {
    document.querySelector('[data-stat="areas-total"]').textContent = String(state.areas.length);
    document.querySelector('[data-stat="areas-ativas"]').textContent = String(state.areas.filter((a) => a.active).length);
    document.querySelector('[data-stat="profissionais-ativos"]').textContent = String(state.professionals.filter((p) => p.active).length);
    document.querySelector('[data-stat="artigos-publicados"]').textContent = String(state.articles.filter((a) => a.status === "published").length);
    document.querySelector('[data-stat="artigos-rascunho"]').textContent = String(state.articles.filter((a) => a.status === "draft").length);
    document.querySelector('[data-stat="solicitacoes-novas"]').textContent = String(state.requests.filter((r) => r.status === "novo").length);
    document.querySelector('[data-stat="faq-total"]').textContent = String(state.faq.length);
    document.querySelector('[data-stat="conteudo-destaque"]').textContent = String(state.articles.filter((a) => a.featured).length + state.areas.filter((a) => a.featured).length);
  }

  function areaTitle(slug) {
    return state.areas.find((a) => a.slug === slug)?.title ?? slug;
  }

  // ============ ÁREAS ============
  const areaForm = document.querySelector("[data-area-form]");
  const areaTableBody = document.querySelector("[data-area-table-body]");
  const areaProfessionalCheckboxes = document.querySelector("[data-area-professional-checkboxes]");

  function renderAreaProfessionalCheckboxes(checkedSlugs) {
    const checked = new Set(checkedSlugs || []);
    areaProfessionalCheckboxes.innerHTML = "";
    state.professionals.forEach((p) => {
      const label = document.createElement("label");
      label.className = "flex items-center gap-1.5 text-xs text-[var(--ink)]";
      label.innerHTML = `<input type="checkbox" value="${p.slug}" ${checked.has(p.slug) ? "checked" : ""} class="h-3.5 w-3.5 rounded accent-[var(--accent)]" /> ${escapeHtml(p.name)}`;
      areaProfessionalCheckboxes.appendChild(label);
    });
  }
  function showAreaForm() {
    areaForm.classList.remove("hidden");
    areaForm.classList.add("grid");
    areaForm.scrollIntoView({ behavior: "smooth", block: "center" });
  }
  function hideAreaForm() {
    areaForm.classList.add("hidden");
    areaForm.classList.remove("grid");
    areaForm.reset();
    areaForm.querySelector('[name="slug"]').value = "";
  }
  document.querySelector('[data-action="toggle-area-form"]').addEventListener("click", () => {
    areaForm.reset();
    areaForm.querySelector('[name="slug"]').value = "";
    renderAreaProfessionalCheckboxes([]);
    showAreaForm();
  });
  document.querySelector('[data-action="cancel-area-form"]').addEventListener("click", hideAreaForm);

  function renderAreas() {
    const list = [...state.areas].sort((a, b) => a.order - b.order);
    areaTableBody.innerHTML = "";
    list.forEach((area) => {
      const row = document.createElement("tr");
      row.className = "border-b border-[var(--border)] last:border-0";
      row.innerHTML = `
        <td class="px-4 py-3"><p class="font-semibold text-[var(--ink)]">${escapeHtml(area.title)}</p><p class="text-xs text-[var(--ink-muted)]">${escapeHtml(area.shortDescription || "")}</p></td>
        <td class="px-4 py-3 text-[var(--ink-muted)]">${area.order}</td>
        <td class="px-4 py-3">
          <button type="button" data-area-toggle-featured="${area.slug}" class="rounded-full px-3 py-1 text-xs font-semibold ${area.featured ? "bg-[var(--accent)]/20 text-[var(--accent)]" : "border border-[var(--border)] text-[var(--ink-muted)]"}">${area.featured ? "Em destaque" : "Padrão"}</button>
        </td>
        <td class="px-4 py-3">
          <button type="button" data-area-toggle="${area.slug}" class="rounded-full px-3 py-1 text-xs font-semibold ${area.active ? "bg-[var(--accent)]/20 text-[var(--accent)]" : "border border-[var(--border)] text-[var(--ink-muted)]"}">${area.active ? "Ativa" : "Oculta"}</button>
        </td>
        <td class="px-4 py-3 text-right">
          <button type="button" data-area-edit="${area.slug}" class="mr-2 text-xs font-semibold text-[var(--primary)] hover:underline">Editar</button>
          <button type="button" data-area-delete="${area.slug}" class="text-xs font-semibold text-[var(--ink-muted)] hover:text-red-500">Remover</button>
        </td>`;
      areaTableBody.appendChild(row);
    });
  }
  areaForm.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(areaForm);
    const existingSlug = String(data.get("slug") || "");
    const title = String(data.get("title") || "").trim();
    const relatedProfessionalSlugs = Array.from(areaProfessionalCheckboxes.querySelectorAll('input[type="checkbox"]:checked')).map((el) => el.value);
    const payload = {
      title,
      shortDescription: String(data.get("shortDescription") || ""),
