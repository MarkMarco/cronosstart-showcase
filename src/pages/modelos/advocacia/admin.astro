            </label>
            <div class="flex gap-3 sm:col-span-2">
              <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-5 py-2.5 text-sm font-semibold text-[var(--primary-ink)]">Salvar banner</button>
              <button type="button" data-action="cancel-banner-form" class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-5 py-2.5 text-sm font-semibold text-[var(--ink)]">Cancelar</button>
            </div>
          </form>
          <div class="mt-6 overflow-x-auto rounded-2xl border border-[var(--border)]">
            <table class="w-full min-w-[560px] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[var(--border)] bg-[var(--surface-alt)] text-xs uppercase tracking-wide text-[var(--ink-muted)]">
                  <th class="px-4 py-3 font-medium">Banner</th>
                  <th class="px-4 py-3 font-medium">Ordem</th>
                  <th class="px-4 py-3 font-medium">Status</th>
                  <th class="px-4 py-3 font-medium text-right">Ações</th>
                </tr>
              </thead>
              <tbody data-banner-table-body class="text-[var(--ink)]"></tbody>
            </table>
          </div>
        </div>

        <!-- CONFIGURAÇÕES -->
        <div data-panel="config" class="mt-6 hidden">
          <h2 class="text-lg font-semibold text-[var(--ink)]">Configurações</h2>
          <form data-settings-form class="mt-4 grid gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-6 sm:grid-cols-2">
            <label class="block text-sm font-medium text-[var(--ink)]">
              Nome do escritório
              <input type="text" name="companyName" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Subtítulo
              <input type="text" name="subtitle" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              WhatsApp (demonstrativo)
              <input type="text" name="whatsapp" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Telefone
              <input type="text" name="phone" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              E-mail
              <input type="email" name="email" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Endereço
              <input type="text" name="address" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Horário de atendimento
              <input type="text" name="hours" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              Instagram (URL)
              <input type="text" name="instagram" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)]">
              LinkedIn (URL)
              <input type="text" name="linkedin" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Texto institucional
              <textarea name="institutionalText" rows="2" class="mt-1.5 w-full resize-none rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]"></textarea>
            </label>
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Aviso demonstrativo (rodapé e conteúdos)
              <textarea name="demonstrativeDisclaimer" rows="2" class="mt-1.5 w-full resize-none rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]"></textarea>
            </label>
            <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
              Texto do rodapé
              <input type="text" name="footerText" class="mt-1.5 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--accent)]" />
            </label>
