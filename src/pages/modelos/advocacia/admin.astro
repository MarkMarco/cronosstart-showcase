        <!-- SOLICITAÇÕES -->
        <div data-panel="solicitacoes" class="mt-6 hidden">
          <h2 class="text-lg font-semibold text-[var(--ink)]">Solicitações demonstrativas</h2>
          <p class="mt-1 text-xs text-[var(--ink-muted)]">Nenhum dado real ou sensível — apenas registros fictícios para demonstrar o fluxo de atendimento.</p>
          <div class="mt-4 space-y-3" data-requests-list></div>
        </div>

        <!-- FAQ -->
        <div data-panel="faq" class="mt-6 hidden">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-[var(--ink)]">Perguntas frequentes</h2>
            <button type="button" data-action="toggle-faq-form" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-5 py-2.5 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5">
