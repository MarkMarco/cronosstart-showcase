---
import { getLocale, localizedPath, localizeDeep, t } from "../../../i18n/index";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/inter";
import ShowcaseLayout from "../../../layouts/ShowcaseLayout.astro";
import AurumLogo from "../../../components/logos/AurumLogo.astro";
import VehicleCard from "../../../components/showcase/VehicleCard.astro";
import { aurumMotorsConfig as config } from "../../../config/showcases/aurum-motors";

const locale = getLocale(Astro.url);
const vehicles = config.vehicles ?? [];

const priceBucket = (price: string) => {
  const value = Number(price.replace(/[^\d]/g, ""));
  if (value <= 300000) return "Até R$ 300 mil";
  if (value <= 400000) return "R$ 300 a 400 mil";
  return "Acima de R$ 400 mil";
};

const seo = localizeDeep({
  title: "Estoque — Aurum Motors (modelo demonstrativo)",
  description: "Estoque completo de veículos seminovos selecionados da Aurum Motors, com filtro demonstrativo por categoria, faixa de preço e marca.",
}, locale);
---

<ShowcaseLayout config={{ ...config, seo }}>
  <AurumLogo slot="header-logo" />
  <AurumLogo slot="footer-logo" />

  <section class="bg-[var(--surface)] px-6 pb-8 pt-14 sm:pt-20">
    <div class="mx-auto max-w-6xl">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{t(locale, "Estoque")}</p>
      <h1 class="text-3xl font-semibold tracking-tight text-[var(--ink)] sm:text-4xl">{t(locale, "Estoque completo")}</h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-[var(--ink-muted)]">
        {vehicles.length} {t(locale, "veículos selecionados. Use os filtros abaixo para encontrar o seu.")}
      </p>
    </div>
  </section>

  <section class="bg-[var(--surface)] px-6 pb-16 sm:pb-20">
    <div class="mx-auto max-w-6xl">
      <form
        data-stock-filters
        class="grid gap-3 rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-5 sm:grid-cols-3 sm:p-6"
      >
        <label class="block text-left text-xs font-medium text-[var(--ink-muted)]">
          {t(locale, "Categoria")}
          <select
            name="category"
            data-filter="category"
            class="mt-1 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"
          >
            {config.vehicleSearch?.categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </label>
        <label class="block text-left text-xs font-medium text-[var(--ink-muted)]">
          {t(locale, "Faixa de preço")}
          <select
            name="price"
            data-filter="price"
            class="mt-1 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"
          >
            {config.vehicleSearch?.priceRanges.map((range) => <option value={range}>{range}</option>)}
          </select>
        </label>
        <label class="block text-left text-xs font-medium text-[var(--ink-muted)]">
          {t(locale, "Marca")}
          <select
            name="brand"
            data-filter="brand"
            class="mt-1 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"
          >
            {config.vehicleSearch?.brands.map((brand) => <option value={brand}>{brand}</option>)}
          </select>
        </label>
      </form>

      <p data-stock-empty class="mt-8 hidden text-center text-sm text-[var(--ink-muted)]">
        {t(locale, "Nenhum veículo encontrado para esses filtros.")}
      </p>

      <div data-stock-grid class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          vehicles.map((vehicle) => (
            <div
              data-stock-item
              data-vehicle-slug={vehicle.slug}
              data-category={vehicle.category}
              data-brand={vehicle.brand}
              data-price-bucket={priceBucket(vehicle.price)}
              class="group flex h-full flex-col overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] transition-all hover:-translate-y-1 hover:border-[var(--accent)]/40"
            >
              <VehicleCard vehicle={vehicle} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</ShowcaseLayout>

<script>
  const STORAGE_KEY = "aurum-motors-inventory-v2";

  function formatBRL(value: number) {
    return value.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
  }

  const VALID_STATUSES = ["ativo", "reservado", "vendido"];
  function normalizeStatus(status: unknown): string {
    return typeof status === "string" && VALID_STATUSES.includes(status) ? status : "ativo";
  }

  function loadStoredInventory(): any[] | null {
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      return parsed.map((v: any) => ({ ...v, status: normalizeStatus(v.status), archived: Boolean(v.archived) }));
    } catch {
      return null;
    }
  }

  function buildCardElement(vehicle: any): HTMLElement {
    const wrapper = document.createElement("div");
    wrapper.dataset.stockItem = "";
    wrapper.dataset.vehicleSlug = vehicle.slug;
    wrapper.dataset.category = vehicle.category;
    wrapper.dataset.brand = vehicle.brand;
    const value = Number(vehicle.price) || 0;
    wrapper.dataset.priceBucket = value <= 300000 ? "Até R$ 300 mil" : value <= 400000 ? "R$ 300 a 400 mil" : "Acima de R$ 400 mil";
    wrapper.className = "group flex h-full flex-col overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] transition-all hover:-translate-y-1 hover:border-[var(--accent)]/40";
    wrapper.innerHTML = `
      <div class="relative aspect-[4/3] overflow-hidden">
        <img src="${vehicle.image}" alt="${vehicle.imageAlt || vehicle.name}" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        ${vehicle.tag ? `<span class="absolute left-3 top-3 rounded-full bg-[var(--primary)] px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-[var(--primary-ink)]">${vehicle.tag}</span>` : ""}
        <span class="pointer-events-none absolute inset-0 ${vehicle.status !== "ativo" ? "flex" : "hidden"} items-center justify-center bg-[var(--surface)]/80 text-sm font-semibold uppercase tracking-widest text-[var(--ink)]">${vehicle.status === "reservado" ? "Reservado" : "Vendido"}</span>
      </div>
      <div class="flex flex-1 flex-col p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-[var(--ink-muted)]">${vehicle.brand}</p>
        <h3 class="mt-1 text-base font-semibold text-[var(--ink)]">${vehicle.name}</h3>
        <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5 text-xs text-[var(--ink-muted)]">
          <span>${vehicle.year}</span>
          <span>${Number(vehicle.mileageKm || 0).toLocaleString("pt-BR")} km</span>
          <span>${vehicle.fuel}</span>
        </div>
        <p class="mt-4 font-[var(--font-heading)] text-xl font-semibold text-[var(--ink)]">${formatBRL(value)}</p>
        <a href="/modelos/aurum-motors/veiculos/${vehicle.slug}" class="mt-4 inline-flex items-center justify-center gap-2 rounded-[var(--radius-control)] border border-[var(--border)] px-4 py-2.5 text-sm font-semibold text-[var(--ink)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]">Ver detalhes</a>
      </div>
    `;
    return wrapper;
  }

  function reconcileInventory() {
    const stored = loadStoredInventory();
    if (!stored) return;

    const grid = document.querySelector("[data-stock-grid]");
    const existingItems = Array.from(document.querySelectorAll<HTMLElement>("[data-stock-item]"));
    const existingSlugs = new Set(existingItems.map((el) => el.dataset.vehicleSlug));

    existingItems.forEach((item) => {
      const slug = item.dataset.vehicleSlug;
      const stock = stored.find((v) => v.slug === slug);
      if (!stock || stock.archived) {
        item.remove();
        return;
      }
      const priceEl = item.querySelector<HTMLElement>('[data-field="price"]');
      if (priceEl) priceEl.textContent = formatBRL(Number(stock.price) || 0);
      const ribbon = item.querySelector<HTMLElement>('[data-field="status-ribbon"]');
      if (ribbon) {
        const notAvailable = stock.status !== "ativo";
        ribbon.textContent = stock.status === "reservado" ? "Reservado" : "Vendido";
        ribbon.classList.toggle("hidden", !notAvailable);
        ribbon.classList.toggle("flex", notAvailable);
      }
    });

    stored
      .filter((v) => !existingSlugs.has(v.slug) && !v.archived)
      .forEach((v) => grid?.appendChild(buildCardElement(v)));
  }

  reconcileInventory();

  const params = new URLSearchParams(window.location.search);
  const form = document.querySelector<HTMLFormElement>("[data-stock-filters]");
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-stock-item]"));
  const emptyState = document.querySelector<HTMLElement>("[data-stock-empty]");

  const selects = {
    category: form?.querySelector<HTMLSelectElement>('[data-filter="category"]'),
    price: form?.querySelector<HTMLSelectElement>('[data-filter="price"]'),
    brand: form?.querySelector<HTMLSelectElement>('[data-filter="brand"]'),
  };

  for (const key of Object.keys(selects) as (keyof typeof selects)[]) {
    const value = params.get(key);
    const select = selects[key];
    if (value && select && Array.from(select.options).some((opt) => opt.value === value)) {
      select.value = value;
    }
  }

  const applyFilters = () => {
    const category = selects.category?.value ?? "";
    const price = selects.price?.value ?? "";
    const brand = selects.brand?.value ?? "";

    let visibleCount = 0;
    items.forEach((item) => {
      const matchesCategory = !category || category.startsWith("Todas") || item.dataset.category === category;
      const matchesPrice = !price || price.startsWith("Qualquer") || item.dataset.priceBucket === price;
      const matchesBrand = !brand || brand.startsWith("Todas") || item.dataset.brand === brand;
      const visible = matchesCategory && matchesPrice && matchesBrand;
      item.classList.toggle("hidden", !visible);
      if (visible) visibleCount += 1;
    });

    emptyState?.classList.toggle("hidden", visibleCount > 0);
  };

  form?.addEventListener("change", applyFilters);
  applyFilters();
</script>
