---
import { getLocale, localizedPath, localizeDeep, t } from "../../../i18n/index";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import ShowcaseLayout from "../../../layouts/ShowcaseLayout.astro";
import MaisonLumeLogo from "../../../components/logos/MaisonLumeLogo.astro";
import MaisonLumeHeader from "../../../components/showcase/MaisonLumeHeader.astro";
import MaisonLumeFooter from "../../../components/showcase/MaisonLumeFooter.astro";
import MaisonLumeHero from "../../../components/showcase/MaisonLumeHero.astro";
import ShoppingDrawer from "../../../components/showcase/ShoppingDrawer.astro";
import RoomInspirationSection from "../../../components/showcase/RoomInspirationSection.astro";
import CollectionsSection from "../../../components/showcase/CollectionsSection.astro";
import FeaturedProductsSection from "../../../components/showcase/FeaturedProductsSection.astro";
import OffersSection from "../../../components/showcase/OffersSection.astro";
import CatalogSection from "../../../components/showcase/CatalogSection.astro";
import ShopTheRoomSection from "../../../components/showcase/ShopTheRoomSection.astro";
import AboutSection from "../../../components/showcase/AboutSection.astro";
import FurnitureQuoteFormSection from "../../../components/showcase/FurnitureQuoteFormSection.astro";
import FAQSection from "../../../components/showcase/FAQSection.astro";
import ProductModal from "../../../components/showcase/ProductModal.astro";
import { maisonLumeConfig as config, categories, collections, ambientes, products } from "../../../config/showcases/moveis-decoracao";

const locale = getLocale(Astro.url);
const featuredProducts = products.filter((p) => p.featured);
const offerProducts = products.filter((p) => p.offerActive);
const heroProduct = products.find((p) => p.slug === "sofa-modular-aurora")!;
const heroCollection = collections.find((c) => c.slug === "aurora")!;

function formatBRL(value: number) {
  return value.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}
---

<ShowcaseLayout config={config}>
  <MaisonLumeHeader slot="header-override" nav={config.nav} ctaLabel={config.hero.ctaPrimaryLabel} ctaHref={config.primaryCtaHref ?? "#catalogo"}>
    <MaisonLumeLogo slot="logo" />
  </MaisonLumeHeader>
  <MaisonLumeFooter slot="footer-override" nav={config.nav} contact={config.contact} categories={categories} collections={collections} />

  <MaisonLumeHero
    eyebrow={config.hero.eyebrow}
    headline={config.hero.headline}
    highlight={config.hero.highlight}
    subheadline={config.hero.subheadline}
    ctaPrimaryLabel={config.hero.ctaPrimaryLabel}
    ctaPrimaryHref="#catalogo"
    ctaSecondaryLabel={config.hero.ctaSecondaryLabel}
    ctaSecondaryHref="#ambientes"
    chips={config.hero.chips}
    heroImage="/images/showcases/moveis-decoracao/hero-main.jpg"
    detailImage="/images/showcases/moveis-decoracao/hero-detail.jpg"
    featuredProductSlug={heroProduct.slug}
    featuredProductName={heroProduct.name}
    featuredProductPrice={formatBRL(heroProduct.price)}
    featuredProductImage={heroProduct.image!}
    collectionName={heroCollection.name}
  />

  <div data-banner-slot class="hidden border-b border-[var(--border)] bg-[var(--primary)] px-6 py-3">
    <div class="mx-auto flex max-w-[1400px] flex-wrap items-center justify-between gap-3">
      <div>
        <p data-banner-title class="text-sm font-semibold text-[var(--primary-ink)]"></p>
        <p data-banner-subtitle class="text-xs text-[var(--primary-ink)]/80"></p>
      </div>
      <a data-banner-cta class="shrink-0 rounded-full border border-[var(--primary-ink)]/30 px-4 py-1.5 text-xs font-semibold text-[var(--primary-ink)] transition-colors hover:border-[var(--primary-ink)]"></a>
    </div>
  </div>

  <RoomInspirationSection id="ambientes" ambientes={ambientes} products={products} />

  <CollectionsSection id="colecoes" collections={collections} />

  <FeaturedProductsSection
    id="destaques"
    eyebrow="Selecionados para você"
    title={t(locale, "Produtos em destaque")}
    description="Uma curadoria de peças que resumem o espírito da Maison Lume — do sofá ao objeto de decoração."
    products={featuredProducts}
    categories={categories}
    collections={collections}
    ambientes={ambientes}
  />

  {offerProducts.length > 0 && <OffersSection id="ofertas" products={offerProducts} categories={categories} />}

  <CatalogSection id="catalogo" products={products} categories={categories} collections={collections} ambientes={ambientes} whatsappNumber={config.contact.whatsappNumber} />

  <ShopTheRoomSection id="compre-o-ambiente" ambientes={ambientes} products={products} />

  {config.about && <AboutSection id="sobre" content={config.about} />}

  <FurnitureQuoteFormSection id="orcamento" cta={config.contactCta} contact={config.contact} />

  {config.faq && (
    <FAQSection
      id="faq"
      eyebrow="Dúvidas frequentes"
      title={t(locale, "Perguntas frequentes")}
      description="Tudo o que costuma ser perguntado antes de fechar um pedido."
      items={config.faq}
      elevated
    />
  )}

  <ProductModal
    products={products}
    categories={categories}
    collections={collections}
    ambientes={ambientes}
    whatsappNumber={config.contact.whatsappNumber}
  />

  <ShoppingDrawer whatsappNumber={config.contact.whatsappNumber} />
</ShowcaseLayout>

<style>
  :global(section[id]) {
    scroll-margin-top: 88px;
  }
</style>

<script>
  const STORAGE_KEY = "maison-lume-admin-v1";

  function formatBRL(value: number) {
    return Number(value || 0).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
  }

  function todayISO() {
    return new Date().toISOString().slice(0, 10);
  }

  try {
    const raw = window.localStorage.getItem(STORAGE_KEY);
    if (raw) {
      const state = JSON.parse(raw);

      if (Array.isArray(state.products)) {
        document.querySelectorAll<HTMLElement>("[data-product-card]").forEach((card) => {
          const slug = card.dataset.slug;
          const override = state.products.find((p: any) => p.slug === slug);
          if (!override || override.archived) {
            card.remove();
            return;
          }
          const priceEl = card.querySelector<HTMLElement>('[data-field="price"]');
          if (priceEl) priceEl.textContent = formatBRL(override.price);
          card.dataset.available = String(Boolean(override.available));
          card.dataset.offer = String(Boolean(override.offerActive));
          card.dataset.price = String(override.price);
        });
      }

      if (Array.isArray(state.banners)) {
        const today = todayISO();
        const active = state.banners
          .filter((b: any) => b.active && (!b.startDate || b.startDate <= today) && (!b.endDate || b.endDate >= today))
          .sort((a: any, b: any) => (a.order ?? 0) - (b.order ?? 0))[0];
        const slot = document.querySelector<HTMLElement>("[data-banner-slot]");
        if (active && slot) {
          slot.classList.remove("hidden");
          const titleEl = slot.querySelector<HTMLElement>("[data-banner-title]")!;
          const subtitleEl = slot.querySelector<HTMLElement>("[data-banner-subtitle]")!;
          const ctaEl = slot.querySelector<HTMLAnchorElement>("[data-banner-cta]")!;
          titleEl.textContent = active.title;
          subtitleEl.textContent = active.subtitle || "";
          if (active.ctaLabel) {
            ctaEl.textContent = active.ctaLabel;
            ctaEl.href = active.ctaHref || "#catalogo";
            ctaEl.classList.remove("hidden");
          } else {
            ctaEl.classList.add("hidden");
          }
        }
      }
    }
  } catch {
    // localStorage indisponível — mantém o conteúdo estático padrão
  }
</script>
