            <div class="sm:col-span-2">
              <button type="submit" class="inline-flex items-center gap-2 rounded-[var(--radius-control)] bg-[var(--primary)] px-6 py-2.5 text-sm font-semibold text-[var(--primary-ink)]">Salvar configurações</button>
              <p data-settings-feedback role="status" class="mt-2 hidden text-sm font-medium text-[var(--accent)]">Configurações salvas neste navegador.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</ShowcaseLayout>

<script define:vars={{ seedProducts, seedCategories, seedCollections, seedAmbientes, seedBanners, seedQuoteRequests, seedSettings }}>
  const STORAGE_KEY = "maison-lume-admin-v1";
  const AUTH_KEY = "maison-lume-admin-authed";

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch]));
  }
  function slugify(text) {
    return text.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  }
  function formatBRL(value) {
    return Number(value || 0).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
  }
  function todayISO() {
    return new Date().toISOString().slice(0, 10);
  }

  function loadState() {
    const seed = {
      products: seedProducts,
      categories: seedCategories,
      collections: seedCollections,
      ambientes: seedAmbientes,
      banners: seedBanners,
      quoteRequests: seedQuoteRequests,
      settings: seedSettings,
    };
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        return { ...seed, ...parsed };
      }
    } catch {}
    saveState(seed);
    return seed;
  }
  function saveState(next) {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
    } catch {}
  }

  let state = loadState();
  const pendingDeletes = new Set();

  // --- Login demonstrativo ---
  const loginGate = document.querySelector("[data-login-gate]");
  const adminContent = document.querySelector("[data-admin-content]");
  const loginForm = document.querySelector("[data-login-form]");
  function unlock() {
    loginGate.classList.add("hidden");
    adminContent.classList.remove("hidden");
    try {
      window.sessionStorage.setItem(AUTH_KEY, "1");
    } catch {}
  }
  loginForm.addEventListener("submit", (event) => {
    event.preventDefault();
    unlock();
  });
  try {
    if (window.sessionStorage.getItem(AUTH_KEY) === "1") unlock();
  } catch {}

  // --- Tabs ---
  const tabButtons = Array.from(document.querySelectorAll("[data-tab-button]"));
  const panels = Array.from(document.querySelectorAll("[data-panel]"));
  function activateTab(id) {
    tabButtons.forEach((btn) => {
      const active = btn.dataset.tabButton === id;
      btn.classList.toggle("border-[var(--primary)]", active);
      btn.classList.toggle("bg-[var(--primary)]", active);
      btn.classList.toggle("text-[var(--primary-ink)]", active);
      btn.classList.toggle("text-[var(--ink-muted)]", !active);
    });
    panels.forEach((panel) => panel.classList.toggle("hidden", panel.dataset.panel !== id));
  }
  tabButtons.forEach((btn) => btn.addEventListener("click", () => activateTab(btn.dataset.tabButton)));
  activateTab("dashboard");

  // --- Dashboard ---
  function renderDashboard() {
    const activeProducts = state.products.filter((p) => !p.archived);
    document.querySelector('[data-stat="produtos-ativos"]').textContent = String(activeProducts.length);
    document.querySelector('[data-stat="em-oferta"]').textContent = String(activeProducts.filter((p) => p.offerActive).length);
    document.querySelector('[data-stat="categorias-ativas"]').textContent = String(state.categories.filter((c) => c.active).length);
    document.querySelector('[data-stat="colecoes-ativas"]').textContent = String(state.collections.filter((c) => c.active).length);
    document.querySelector('[data-stat="ambientes-ativos"]').textContent = String(state.ambientes.filter((a) => a.active).length);
    document.querySelector('[data-stat="banners-ativos"]').textContent = String(state.banners.filter((b) => b.active).length);
    document.querySelector('[data-stat="solicitacoes-novas"]').textContent = String(state.quoteRequests.filter((q) => q.status === "novo").length);
  }

  // ============ PRODUTOS ============
  const toneGradient = {
    sand: "linear-gradient(145deg, #efe4d2 0%, #e2cfae 100%)",
    linen: "linear-gradient(145deg, #f4efe6 0%, #e6dccb 100%)",
    walnut: "linear-gradient(145deg, #cbb08c 0%, #8a6a49 100%)",
    graphite: "linear-gradient(145deg, #4b4741 0%, #2b2621 100%)",
    stone: "linear-gradient(145deg, #d8d2c6 0%, #b6ac9a 100%)",
    clay: "linear-gradient(145deg, #d1a37e 0%, #a9784f 100%)",
    sage: "linear-gradient(145deg, #cbd3bf 0%, #a7b190 100%)",
  };

  const productForm = document.querySelector("[data-product-form]");
  const productFormTitle = document.querySelector("[data-product-form-title]");
  const productTableBody = document.querySelector("[data-product-table-body]");
  const productEmpty = document.querySelector("[data-product-empty]");
  const pSearch = document.querySelector("[data-p-search]");
  const pFilterCategory = document.querySelector("[data-p-filter-category]");
  const pFilterStatus = document.querySelector("[data-p-filter-status]");
  const pSort = document.querySelector("[data-p-sort]");
  const pShowArchived = document.querySelector("[data-p-show-archived]");

  function categoryName(slug) {
    return state.categories.find((c) => c.slug === slug)?.name ?? slug;
  }

  function showProductForm(editing) {
    productForm.classList.remove("hidden");
    productForm.classList.add("grid");
    productFormTitle.textContent = editing ? "Editar produto" : "Novo produto";
    updateProductPreview();
    productForm.scrollIntoView({ behavior: "smooth", block: "center" });
  }
  function hideProductForm() {
    productForm.classList.add("hidden");
    productForm.classList.remove("grid");
    productForm.reset();
    productForm.querySelector('[name="id"]').value = "";
  }

  function updateProductPreview() {
    const get = (name) => productForm.querySelector(`[name="${name}"]`)?.value || "";
    document.querySelector('[data-preview="name"]').textContent = get("name") || "Nome do produto";
    document.querySelector('[data-preview="taxonomy"]').textContent = categoryName(productForm.querySelector('[name="category"]').value);
    document.querySelector('[data-preview="price"]').textContent = formatBRL(get("price"));
    document.querySelector('[data-preview="description"]').textContent = get("description");
    const tone = get("tone") || "sand";
    document.querySelector('[data-preview="visual"]').style.background = toneGradient[tone] ?? toneGradient.sand;
    const image = get("image");
    const imgEl = document.querySelector('[data-preview="image"]');
    const visualEl = document.querySelector('[data-preview="visual"]');
    if (image) {
      imgEl.src = image;
      imgEl.classList.remove("hidden");
      visualEl.classList.add("hidden");
    } else {
      imgEl.classList.add("hidden");
      visualEl.classList.remove("hidden");
    }
  }
  ["name", "price", "category", "description", "tone", "image"].forEach((field) => {
    productForm.querySelector(`[name="${field}"]`)?.addEventListener("input", updateProductPreview);
  });

  document.querySelector('[data-action="toggle-product-form"]').addEventListener("click", () => {
    productForm.reset();
    productForm.querySelector('[name="id"]').value = "";
    showProductForm(false);
  });
  document.querySelector('[data-action="cancel-product-form"]').addEventListener("click", hideProductForm);

  document.querySelector('[data-action="duplicate-current"]').addEventListener("click", () => {
    const id = productForm.querySelector('[name="id"]').value;
    const original = state.products.find((p) => p.id === id);
    if (!original) return;
    const copy = { ...original, id: `${original.id}-copia-${Date.now()}`, name: `${original.name} (cópia)`, slug: `${original.slug}-copia-${Date.now()}` };
    state.products.push(copy);
    saveState(state);
    renderProducts();
    renderDashboard();
    hideProductForm();
  });

  function getFilteredProducts() {
    const search = (pSearch.value || "").trim().toLowerCase();
    const category = pFilterCategory.value;
    const status = pFilterStatus.value;
    const showArchived = pShowArchived.checked;
    const sort = pSort.value;

    let list = state.products.filter((p) => {
      if (!showArchived && p.archived) return false;
      if (showArchived && !p.archived) return false;
      if (search && !`${p.name} ${p.sku}`.toLowerCase().includes(search)) return false;
      if (category && p.category !== category) return false;
      if (status === "disponivel" && !p.available) return false;
      if (status === "indisponivel" && p.available) return false;
      return true;
    });

    list = [...list].sort((a, b) => {
      if (sort === "name") return a.name.localeCompare(b.name);
      if (sort === "price-asc") return a.price - b.price;
      if (sort === "price-desc") return b.price - a.price;
      return a.displayOrder - b.displayOrder;
    });
    return list;
  }

  function renderProducts() {
    renderProductFilters();
    const list = getFilteredProducts();
    productTableBody.innerHTML = "";
    productEmpty.classList.toggle("hidden", list.length > 0);

    list.forEach((product) => {
      const row = document.createElement("tr");
      row.className = "border-b border-[var(--border)] last:border-0";
      const actions = product.archived
        ? `<button type="button" data-p-reactivate="${product.id}" class="mr-2 text-xs font-semibold text-[var(--ink)] hover:text-[var(--accent)]">Reativar</button>
           <button type="button" data-p-delete="${product.id}" class="text-xs font-semibold text-[var(--ink-muted)] hover:text-red-500">Remover</button>`
        : `<button type="button" data-p-edit="${product.id}" class="mr-2 text-xs font-semibold text-[var(--ink)] hover:text-[var(--accent)]">Editar</button>
           <button type="button" data-p-archive="${product.id}" class="mr-2 text-xs font-semibold text-[var(--ink-muted)] hover:text-[var(--accent)]">Arquivar</button>
           <button type="button" data-p-delete="${product.id}" class="text-xs font-semibold text-[var(--ink-muted)] hover:text-red-500">Remover</button>`;
      row.innerHTML = `
        <td class="px-4 py-3">
          <div class="flex items-center gap-3">
            ${product.image ? `<img src="${escapeHtml(product.image)}" alt="" class="h-10 w-10 shrink-0 rounded-lg object-cover" />` : ""}
            <div>
              <p class="font-semibold text-[var(--ink)]">${escapeHtml(product.name)}</p>
              <p class="text-xs text-[var(--ink-muted)]">${escapeHtml(product.sku)}</p>
            </div>
          </div>
        </td>
        <td class="px-4 py-3 text-[var(--ink-muted)]">${escapeHtml(categoryName(product.category))}</td>
        <td class="px-4 py-3 font-semibold text-[var(--ink)]">${formatBRL(product.price)}</td>
        <td class="px-4 py-3">
          <button type="button" data-p-toggle-available="${product.id}" class="rounded-full px-3 py-1 text-xs font-semibold ${product.available ? "bg-[var(--primary)]/15 text-[var(--primary)]" : "border border-[var(--border)] text-[var(--ink-muted)]"}">
            ${product.available ? "Disponível" : "Indisponível"}
          </button>
        </td>
        <td class="px-4 py-3">
          <button type="button" data-p-toggle-featured="${product.id}" class="rounded-full px-3 py-1 text-xs font-semibold ${product.featured ? "bg-[var(--accent)]/20 text-[var(--accent)]" : "border border-[var(--border)] text-[var(--ink-muted)]"}">
            ${product.featured ? "Em destaque" : "Padrão"}
          </button>
        </td>
        <td class="px-4 py-3 text-right">${actions}</td>
      `;
      productTableBody.appendChild(row);
    });
  }

  function renderProductFilters() {
    if (pFilterCategory.dataset.rendered) return;
    pFilterCategory.dataset.rendered = "1";
  }

  productTableBody.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    const toggleAvail = target.getAttribute("data-p-toggle-available");
    if (toggleAvail) {
      const product = state.products.find((p) => p.id === toggleAvail);
      if (product) product.available = !product.available;
      saveState(state);
      renderProducts();
      return;
    }
    const toggleFeatured = target.getAttribute("data-p-toggle-featured");
    if (toggleFeatured) {
      const product = state.products.find((p) => p.id === toggleFeatured);
      if (product) product.featured = !product.featured;
      saveState(state);
      renderProducts();
      return;
    }
    const editId = target.getAttribute("data-p-edit");
    if (editId) {
      const product = state.products.find((p) => p.id === editId);
      if (!product) return;
      productForm.querySelector('[name="id"]').value = product.id;
      productForm.querySelector('[name="name"]').value = product.name;
      productForm.querySelector('[name="sku"]').value = product.sku;
      productForm.querySelector('[name="category"]').value = product.category;
      productForm.querySelector('[name="collection"]').value = product.collection || "";
      productForm.querySelector('[name="ambiente"]').value = product.ambiente || "";
      productForm.querySelector('[name="price"]').value = String(product.price);
      productForm.querySelector('[name="previousPrice"]').value = product.previousPrice ? String(product.previousPrice) : "";
      productForm.querySelector('[name="offerActive"]').checked = Boolean(product.offerActive);
      productForm.querySelector('[name="offerEndsAt"]').value = product.offerEndsAt || "";
      productForm.querySelector('[name="tone"]').value = product.tone;
      productForm.querySelector('[name="icon"]').value = product.icon;
      productForm.querySelector('[name="materials"]').value = (product.materials || []).join(", ");
      productForm.querySelector('[name="dimensions"]').value = product.dimensions || "";
      productForm.querySelector('[name="colors"]').value = (product.colors || []).join(", ");
      productForm.querySelector('[name="badge"]').value = product.badge || "";
      productForm.querySelector('[name="displayOrder"]').value = String(product.displayOrder);
      productForm.querySelector('[name="available"]').checked = Boolean(product.available);
      productForm.querySelector('[name="featured"]').checked = Boolean(product.featured);
      productForm.querySelector('[name="isNew"]').checked = Boolean(product.isNew);
      productForm.querySelector('[name="description"]').value = product.description || "";
      productForm.querySelector('[name="image"]').value = product.image || "";
      showProductForm(true);
      return;
    }
    const archiveId = target.getAttribute("data-p-archive");
    if (archiveId) {
      const product = state.products.find((p) => p.id === archiveId);
      if (product) product.archived = true;
      saveState(state);
      renderProducts();
      renderDashboard();
      return;
    }
    const reactivateId = target.getAttribute("data-p-reactivate");
    if (reactivateId) {
      const product = state.products.find((p) => p.id === reactivateId);
      if (product) product.archived = false;
      saveState(state);
      renderProducts();
      renderDashboard();
      return;
    }
    const deleteId = target.getAttribute("data-p-delete");
    if (deleteId) {
      if (!pendingDeletes.has(deleteId)) {
        pendingDeletes.add(deleteId);
        target.textContent = "Confirmar remoção?";
        target.classList.add("text-red-500");
        setTimeout(() => {
          pendingDeletes.delete(deleteId);
        }, 4000);
        return;
      }
      pendingDeletes.delete(deleteId);
      state.products = state.products.filter((p) => p.id !== deleteId);
      saveState(state);
      renderProducts();
      renderDashboard();
    }
  });

  [pSearch].forEach((el) => el.addEventListener("input", renderProducts));
  [pFilterCategory, pFilterStatus, pSort, pShowArchived].forEach((el) => el.addEventListener("change", renderProducts));

  productForm.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(productForm);
    const existingId = String(data.get("id") || "");
    const name = String(data.get("name") || "").trim();
    const payload = {
      name,
      sku: String(data.get("sku") || "").trim(),
      category: String(data.get("category") || ""),
      collection: String(data.get("collection") || "") || undefined,
      ambiente: String(data.get("ambiente") || "") || undefined,
      price: Number(data.get("price") || 0),
      previousPrice: data.get("previousPrice") ? Number(data.get("previousPrice")) : undefined,
      offerActive: data.get("offerActive") === "on",
      offerEndsAt: String(data.get("offerEndsAt") || "") || undefined,
      materials: String(data.get("materials") || "").split(",").map((m) => m.trim()).filter(Boolean),
      dimensions: String(data.get("dimensions") || ""),
      colors: String(data.get("colors") || "").split(",").map((c) => c.trim()).filter(Boolean),
      tone: String(data.get("tone") || "sand"),
      icon: String(data.get("icon") || "sofa"),
      badge: String(data.get("badge") || "") || undefined,
      displayOrder: Number(data.get("displayOrder") || state.products.length + 1),
      available: data.get("available") === "on",
      featured: data.get("featured") === "on",
      isNew: data.get("isNew") === "on",
      description: String(data.get("description") || ""),
      image: String(data.get("image") || "") || undefined,
      updatedAt: todayISO(),
    };

    if (existingId) {
      const index = state.products.findIndex((p) => p.id === existingId);
      if (index >= 0) state.products[index] = { ...state.products[index], ...payload, id: existingId };
    } else {
      let slug = slugify(name);
      let suffix = 2;
      while (state.products.some((p) => p.slug === slug)) {
        slug = `${slugify(name)}-${suffix}`;
        suffix += 1;
      }
      state.products.push({ ...payload, id: `prod-${Date.now()}`, slug, sku: payload.sku || slug.toUpperCase(), archived: false, createdAt: todayISO() });
    }
    saveState(state);
    renderProducts();
    renderDashboard();
    renderOffers();
    hideProductForm();
  });

  // ============ CATEGORIAS / COLEÇÕES / AMBIENTES (genérico) ============
  const taxonomyConfig = {
    categorias: { stateKey: "categories", extraFields: ["icon"] },
    colecoes: { stateKey: "collections", extraFields: ["tone", "featured", "image"] },
    ambientes: { stateKey: "ambientes", extraFields: ["tone", "shoppable", "image"] },
  };

  function productCountFor(target, slug) {
    const field = target === "categorias" ? "category" : target === "colecoes" ? "collection" : "ambiente";
    return state.products.filter((p) => p[field] === slug && !p.archived).length;
  }

  function renderTaxonomy(target) {
    const cfg = taxonomyConfig[target];
    const list = [...state[cfg.stateKey]].sort((a, b) => a.order - b.order);
    const tbody = document.querySelector(`[data-taxonomy-table-body="${target}"]`);
    tbody.innerHTML = "";
    list.forEach((item, index) => {
      const row = document.createElement("tr");
      row.className = "border-b border-[var(--border)] last:border-0";
      row.innerHTML = `
        <td class="px-4 py-3">
          <p class="font-semibold text-[var(--ink)]">${escapeHtml(item.name)}</p>
          <p class="text-xs text-[var(--ink-muted)]">${escapeHtml(item.description || "")}</p>
        </td>
        <td class="px-4 py-3 text-[var(--ink-muted)]">${productCountFor(target, item.slug)}</td>
        <td class="px-4 py-3">
          <button type="button" data-tx-toggle="${target}:${item.slug}" class="rounded-full px-3 py-1 text-xs font-semibold ${item.active ? "bg-[var(--primary)]/15 text-[var(--primary)]" : "border border-[var(--border)] text-[var(--ink-muted)]"}">
            ${item.active ? "Ativa" : "Oculta"}
          </button>
        </td>
        <td class="px-4 py-3">
          <div class="flex items-center gap-1">
            <button type="button" data-tx-up="${target}:${item.slug}" ${index === 0 ? "disabled" : ""} class="rounded border border-[var(--border)] px-2 py-1 text-xs disabled:opacity-30">↑</button>
            <button type="button" data-tx-down="${target}:${item.slug}" ${index === list.length - 1 ? "disabled" : ""} class="rounded border border-[var(--border)] px-2 py-1 text-xs disabled:opacity-30">↓</button>
          </div>
        </td>
        <td class="px-4 py-3 text-right">
          <button type="button" data-tx-edit="${target}:${item.slug}" class="mr-2 text-xs font-semibold text-[var(--ink)] hover:text-[var(--accent)]">Editar</button>
          <button type="button" data-tx-delete="${target}:${item.slug}" class="text-xs font-semibold text-[var(--ink-muted)] hover:text-red-500">Remover</button>
        </td>
      `;
      tbody.appendChild(row);
    });
    renderMoveSelects(target, list);
  }

  function renderMoveSelects(target, list) {
    const from = document.querySelector(`[data-move-from="${target}"]`);
    const to = document.querySelector(`[data-move-to="${target}"]`);
    const options = list.map((item) => `<option value="${item.slug}">${escapeHtml(item.name)}</option>`).join("");
    from.innerHTML = options;
    to.innerHTML = options;
  }

  Object.keys(taxonomyConfig).forEach((target) => {
    const form = document.querySelector(`[data-taxonomy-form="${target}"]`);
    const cfg = taxonomyConfig[target];

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const existingSlug = String(data.get("slug") || "");
      const name = String(data.get("name") || "").trim();
      const payload = { name, description: String(data.get("description") || "") };
      if (cfg.extraFields.includes("icon")) payload.icon = String(data.get("icon") || "sparkle");
      if (cfg.extraFields.includes("tone")) payload.tone = String(data.get("tone") || "sand");
      if (cfg.extraFields.includes("featured")) payload.featured = data.get("featured") === "on";
      if (cfg.extraFields.includes("shoppable")) payload.shoppable = data.get("shoppable") === "on";
      if (cfg.extraFields.includes("image")) payload.image = String(data.get("image") || "") || undefined;

      const list = state[cfg.stateKey];
      if (existingSlug) {
        const index = list.findIndex((i) => i.slug === existingSlug);
        if (index >= 0) list[index] = { ...list[index], ...payload };
      } else {
        let slug = slugify(name);
        let suffix = 2;
        while (list.some((i) => i.slug === slug)) {
          slug = `${slugify(name)}-${suffix}`;
          suffix += 1;
        }
        list.push({ ...payload, slug, order: list.length + 1, active: true });
      }
      saveState(state);
      renderTaxonomy(target);
      renderDashboard();
      form.reset();
      form.querySelector('[name="slug"]').value = "";
    });

    document.querySelectorAll(`[data-action="cancel-taxonomy-form"][data-target="${target}"]`).forEach((btn) => {
      btn.addEventListener("click", () => {
        form.reset();
        form.querySelector('[name="slug"]').value = "";
      });
    });

    document.querySelector(`[data-taxonomy-table-body="${target}"]`).addEventListener("click", (event) => {
      const el = event.target;
      if (!(el instanceof HTMLElement)) return;
      const list = state[cfg.stateKey];

      const toggleKey = el.getAttribute("data-tx-toggle");
      if (toggleKey) {
        const slug = toggleKey.split(":")[1];
        const item = list.find((i) => i.slug === slug);
        if (item) item.active = !item.active;
        saveState(state);
        renderTaxonomy(target);
        renderDashboard();
        return;
      }
      const upKey = el.getAttribute("data-tx-up");
      const downKey = el.getAttribute("data-tx-down");
      if (upKey || downKey) {
        const slug = (upKey || downKey).split(":")[1];
        const sorted = [...list].sort((a, b) => a.order - b.order);
        const idx = sorted.findIndex((i) => i.slug === slug);
        const swapIdx = upKey ? idx - 1 : idx + 1;
        if (swapIdx < 0 || swapIdx >= sorted.length) return;
        const a = sorted[idx];
        const b = sorted[swapIdx];
        const tmp = a.order;
        a.order = b.order;
        b.order = tmp;
        saveState(state);
        renderTaxonomy(target);
        return;
      }
      const editKey = el.getAttribute("data-tx-edit");
      if (editKey) {
        const slug = editKey.split(":")[1];
        const item = list.find((i) => i.slug === slug);
        if (!item) return;
        form.querySelector('[name="slug"]').value = item.slug;
        form.querySelector('[name="name"]').value = item.name;
        form.querySelector('[name="description"]').value = item.description || "";
        if (cfg.extraFields.includes("icon")) form.querySelector('[name="icon"]').value = item.icon;
        if (cfg.extraFields.includes("tone")) form.querySelector('[name="tone"]').value = item.tone;
        if (cfg.extraFields.includes("featured")) form.querySelector('[name="featured"]').checked = Boolean(item.featured);
        if (cfg.extraFields.includes("shoppable")) form.querySelector('[name="shoppable"]').checked = Boolean(item.shoppable);
        if (cfg.extraFields.includes("image")) form.querySelector('[name="image"]').value = item.image || "";
        form.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }
      const deleteKey = el.getAttribute("data-tx-delete");
      if (deleteKey) {
        const pendingId = `tx-${deleteKey}`;
        if (!pendingDeletes.has(pendingId)) {
          pendingDeletes.add(pendingId);
          el.textContent = "Confirmar remoção?";
          el.classList.add("text-red-500");
          setTimeout(() => pendingDeletes.delete(pendingId), 4000);
          return;
        }
        pendingDeletes.delete(pendingId);
        const slug = deleteKey.split(":")[1];
        state[cfg.stateKey] = list.filter((i) => i.slug !== slug);
        saveState(state);
        renderTaxonomy(target);
        renderDashboard();
      }
    });

    document.querySelector(`[data-action="move-products"][data-target="${target}"]`).addEventListener("click", () => {
      const from = document.querySelector(`[data-move-from="${target}"]`).value;
      const to = document.querySelector(`[data-move-to="${target}"]`).value;
      if (!from || !to || from === to) return;
      const field = target === "categorias" ? "category" : target === "colecoes" ? "collection" : "ambiente";
      let moved = 0;
      state.products.forEach((p) => {
        if (p[field] === from) {
          p[field] = to;
          moved += 1;
        }
      });
      saveState(state);
      renderTaxonomy(target);
      renderProducts();
      alert(moved > 0 ? `${moved} produto(s) movido(s).` : "Nenhum produto encontrado nesta origem.");
    });
  });

  // ============ OFERTAS ============
  const offersTableBody = document.querySelector("[data-offers-table-body]");
  const offersShowExpired = document.querySelector("[data-offers-show-expired]");

  function isExpired(product) {
    return Boolean(product.offerEndsAt) && product.offerEndsAt < todayISO();
  }

  function renderOffers() {
    const showExpired = offersShowExpired.checked;
    const list = state.products.filter((p) => p.offerActive || (showExpired && p.previousPrice));
    offersTableBody.innerHTML = "";
    list.forEach((product) => {
      const expired = isExpired(product);
      const row = document.createElement("tr");
      row.className = "border-b border-[var(--border)] last:border-0";
      row.innerHTML = `
        <td class="px-4 py-3 font-semibold text-[var(--ink)]">${escapeHtml(product.name)}</td>
        <td class="px-4 py-3">${formatBRL(product.price)}</td>
        <td class="px-4 py-3 text-[var(--ink-muted)] line-through">${product.previousPrice ? formatBRL(product.previousPrice) : "—"}</td>
        <td class="px-4 py-3">${product.offerEndsAt || "—"}</td>
        <td class="px-4 py-3">
          <span class="rounded-full px-3 py-1 text-xs font-semibold ${expired ? "bg-red-500/10 text-red-500" : product.offerActive ? "bg-[var(--accent)]/20 text-[var(--accent)]" : "border border-[var(--border)] text-[var(--ink-muted)]"}">
            ${expired ? "Expirada" : product.offerActive ? "Ativa" : "Pausada"}
          </span>
        </td>
        <td class="px-4 py-3">
          <button type="button" data-o-toggle-featured="${product.id}" class="rounded-full px-3 py-1 text-xs font-semibold ${product.featured ? "bg-[var(--accent)]/20 text-[var(--accent)]" : "border border-[var(--border)] text-[var(--ink-muted)]"}">
            ${product.featured ? "Na home" : "Padrão"}
          </button>
        </td>
        <td class="px-4 py-3 text-right">
          <button type="button" data-o-pause="${product.id}" class="mr-2 text-xs font-semibold text-[var(--ink)] hover:text-[var(--accent)]">${product.offerActive ? "Pausar" : "Ativar"}</button>
          <button type="button" data-o-end="${product.id}" class="text-xs font-semibold text-[var(--ink-muted)] hover:text-red-500">Encerrar</button>
        </td>
      `;
      offersTableBody.appendChild(row);
    });
  }

  offersShowExpired.addEventListener("change", renderOffers);
  offersTableBody.addEventListener("click", (event) => {
    const el = event.target;
    if (!(el instanceof HTMLElement)) return;
    const toggleId = el.getAttribute("data-o-toggle-featured");
    if (toggleId) {
      const product = state.products.find((p) => p.id === toggleId);
      if (product) product.featured = !product.featured;
      saveState(state);
      renderOffers();
      renderProducts();
      return;
    }
    const pauseId = el.getAttribute("data-o-pause");
    if (pauseId) {
      const product = state.products.find((p) => p.id === pauseId);
      if (product) product.offerActive = !product.offerActive;
      saveState(state);
      renderOffers();
      renderDashboard();
      return;
    }
    const endId = el.getAttribute("data-o-end");
    if (endId) {
      const product = state.products.find((p) => p.id === endId);
      if (product) {
        product.offerActive = false;
        product.previousPrice = undefined;
        product.offerEndsAt = undefined;
      }
      saveState(state);
      renderOffers();
      renderDashboard();
    }
  });

  // ============ BANNERS ============
  const bannerForm = document.querySelector("[data-banner-form]");
  const bannerTableBody = document.querySelector("[data-banner-table-body]");

  function renderBanners() {
    const list = [...state.banners].sort((a, b) => a.order - b.order);
    bannerTableBody.innerHTML = "";
    list.forEach((banner) => {
      const row = document.createElement("tr");
      row.className = "border-b border-[var(--border)] last:border-0";
      row.innerHTML = `
        <td class="px-4 py-3">
          <p class="font-semibold text-[var(--ink)]">${escapeHtml(banner.title)}</p>
          <p class="text-xs text-[var(--ink-muted)]">${escapeHtml(banner.subtitle || "")}</p>
        </td>
        <td class="px-4 py-3 text-[var(--ink-muted)]">${banner.startDate || "—"} a ${banner.endDate || "—"}</td>
        <td class="px-4 py-3">
          <button type="button" data-b-toggle="${banner.id}" class="rounded-full px-3 py-1 text-xs font-semibold ${banner.active ? "bg-[var(--primary)]/15 text-[var(--primary)]" : "border border-[var(--border)] text-[var(--ink-muted)]"}">
            ${banner.active ? "Ativo" : "Inativo"}
          </button>
        </td>
        <td class="px-4 py-3 text-right">
          <button type="button" data-b-edit="${banner.id}" class="mr-2 text-xs font-semibold text-[var(--ink)] hover:text-[var(--accent)]">Editar</button>
          <button type="button" data-b-delete="${banner.id}" class="text-xs font-semibold text-[var(--ink-muted)] hover:text-red-500">Remover</button>
        </td>
      `;
      bannerTableBody.appendChild(row);
    });
  }

  bannerForm.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(bannerForm);
    const existingId = String(data.get("id") || "");
    const payload = {
      title: String(data.get("title") || "").trim(),
      subtitle: String(data.get("subtitle") || ""),
      ctaLabel: String(data.get("ctaLabel") || ""),
      ctaHref: String(data.get("ctaHref") || "#catalogo"),
      startDate: String(data.get("startDate") || ""),
      endDate: String(data.get("endDate") || ""),
      active: data.get("active") === "on",
    };
    if (existingId) {
      const idx = state.banners.findIndex((b) => b.id === existingId);
      if (idx >= 0) state.banners[idx] = { ...state.banners[idx], ...payload };
    } else {
      state.banners.push({ ...payload, id: `banner-${Date.now()}`, order: state.banners.length + 1 });
    }
    saveState(state);
    renderBanners();
    renderDashboard();
    bannerForm.reset();
    bannerForm.querySelector('[name="id"]').value = "";
  });

  document.querySelector('[data-action="cancel-banner-form"]').addEventListener("click", () => {
    bannerForm.reset();
    bannerForm.querySelector('[name="id"]').value = "";
  });

  bannerTableBody.addEventListener("click", (event) => {
    const el = event.target;
    if (!(el instanceof HTMLElement)) return;
    const toggleId = el.getAttribute("data-b-toggle");
    if (toggleId) {
      const banner = state.banners.find((b) => b.id === toggleId);
      if (banner) banner.active = !banner.active;
      saveState(state);
      renderBanners();
      renderDashboard();
      return;
    }
    const editId = el.getAttribute("data-b-edit");
    if (editId) {
      const banner = state.banners.find((b) => b.id === editId);
      if (!banner) return;
      bannerForm.querySelector('[name="id"]').value = banner.id;
      bannerForm.querySelector('[name="title"]').value = banner.title;
      bannerForm.querySelector('[name="subtitle"]').value = banner.subtitle || "";
      bannerForm.querySelector('[name="ctaLabel"]').value = banner.ctaLabel || "";
      bannerForm.querySelector('[name="ctaHref"]').value = banner.ctaHref || "";
      bannerForm.querySelector('[name="startDate"]').value = banner.startDate || "";
      bannerForm.querySelector('[name="endDate"]').value = banner.endDate || "";
      bannerForm.querySelector('[name="active"]').checked = Boolean(banner.active);
      bannerForm.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }
    const deleteId = el.getAttribute("data-b-delete");
    if (deleteId) {
      const pendingId = `banner-${deleteId}`;
      if (!pendingDeletes.has(pendingId)) {
        pendingDeletes.add(pendingId);
        el.textContent = "Confirmar remoção?";
        el.classList.add("text-red-500");
        setTimeout(() => pendingDeletes.delete(pendingId), 4000);
        return;
      }
      pendingDeletes.delete(pendingId);
      state.banners = state.banners.filter((b) => b.id !== deleteId);
      saveState(state);
      renderBanners();
      renderDashboard();
    }
  });

  // ============ SOLICITAÇÕES ============
  const quoteList = document.querySelector("[data-quote-list]");
  const statusOptions = ["novo", "em atendimento", "orçamento enviado", "concluído", "arquivado"];

  function renderQuoteRequests() {
    quoteList.innerHTML = "";
    [...state.quoteRequests].sort((a, b) => (b.createdAt || "").localeCompare(a.createdAt || "")).forEach((req) => {
      const card = document.createElement("div");
      card.className = "rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-5";
      card.innerHTML = `
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="font-semibold text-[var(--ink)]">${escapeHtml(req.name)}</p>
            <p class="text-xs text-[var(--ink-muted)]">${escapeHtml(req.phone)} · ${escapeHtml(req.email)} · ${escapeHtml(req.city || "")}</p>
            <p class="mt-1 text-xs text-[var(--ink-muted)]">Recebido em ${req.createdAt}</p>
          </div>
          <select data-q-status="${req.id}" class="rounded-full border border-[var(--border)] bg-[var(--surface)] px-3 py-1.5 text-xs font-semibold text-[var(--ink)]">
            ${statusOptions.map((s) => `<option value="${s}" ${req.status === s ? "selected" : ""}>${s}</option>`).join("")}
          </select>
        </div>
        <p class="mt-3 text-sm text-[var(--ink)]"><strong>Interesse:</strong> ${escapeHtml(req.interest || "—")}</p>
        <p class="mt-1 text-sm text-[var(--ink-muted)]">${escapeHtml(req.message || "")}</p>
        <p class="mt-1 text-xs text-[var(--ink-muted)]">Preferência de contato: ${escapeHtml(req.contactPreference || "—")}</p>
        <label class="mt-3 block text-xs font-medium text-[var(--ink-muted)]">
          Notas internas
          <textarea data-q-notes="${req.id}" rows="2" class="mt-1 w-full resize-none rounded-xl border border-[var(--border)] bg-[var(--surface)] px-3 py-2 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]">${escapeHtml(req.notes || "")}</textarea>
        </label>
      `;
      quoteList.appendChild(card);
    });
  }

  quoteList.addEventListener("change", (event) => {
    const target = event.target;
    const statusId = target.getAttribute?.("data-q-status");
    if (statusId) {
      const req = state.quoteRequests.find((r) => r.id === statusId);
      if (req) req.status = target.value;
      saveState(state);
      renderDashboard();
    }
  });
  quoteList.addEventListener("blur", (event) => {
    const target = event.target;
    const notesId = target.getAttribute?.("data-q-notes");
    if (notesId) {
      const req = state.quoteRequests.find((r) => r.id === notesId);
      if (req) req.notes = target.value;
      saveState(state);
    }
  }, true);

  // ============ CONFIGURAÇÕES ============
  const settingsForm = document.querySelector("[data-settings-form]");
  function renderSettings() {
    Object.entries(state.settings).forEach(([key, value]) => {
      const field = settingsForm.querySelector(`[name="${key}"]`);
      if (field) field.value = value || "";
    });
  }
  settingsForm.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(settingsForm);
    const next = {};
    for (const [key, value] of data.entries()) next[key] = String(value);
    state.settings = { ...state.settings, ...next };
    saveState(state);
    const feedback = settingsForm.querySelector("[data-settings-feedback]");
    feedback.classList.remove("hidden");
    setTimeout(() => feedback.classList.add("hidden"), 3000);
  });

  // --- Reset geral ---
  document.querySelector('[data-action="reset-all"]').addEventListener("click", () => {
    if (!confirm("Restaurar todos os dados do painel (produtos, categorias, coleções, ambientes, ofertas, banners, solicitações e configurações) para os valores originais de demonstração? Isso apaga suas alterações locais.")) return;
    state = {
      products: seedProducts.map((p) => ({ ...p })),
      categories: seedCategories.map((c) => ({ ...c })),
      collections: seedCollections.map((c) => ({ ...c })),
      ambientes: seedAmbientes.map((a) => ({ ...a })),
      banners: seedBanners.map((b) => ({ ...b })),
      quoteRequests: seedQuoteRequests.map((q) => ({ ...q })),
      settings: { ...seedSettings },
    };
    saveState(state);
    renderAll();
    alert("Dados originais restaurados com sucesso.");
  });

  function renderAll() {
    renderDashboard();
    renderProducts();
    renderTaxonomy("categorias");
    renderTaxonomy("colecoes");
    renderTaxonomy("ambientes");
    renderOffers();
    renderBanners();
    renderQuoteRequests();
    renderSettings();
  }

  renderAll();
</script>
