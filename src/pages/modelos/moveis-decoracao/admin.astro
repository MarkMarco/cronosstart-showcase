---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import ShowcaseLayout from "../../../layouts/ShowcaseLayout.astro";
import MaisonLumeLogo from "../../../components/logos/MaisonLumeLogo.astro";
import Icon from "../../../components/ui/Icon.astro";
import { maisonLumeConfig as config, categories, collections, ambientes, products } from "../../../config/showcases/moveis-decoracao";

const seo = {
  title: "Painel administrativo — Maison Lume (modelo demonstrativo)",
  description: "Painel administrativo demonstrativo de catálogo, ofertas e conteúdo da Maison Lume.",
};

const seedProducts = products.map((p) => ({ ...p, archived: false }));
const seedCategories = categories.map((c) => ({ ...c }));
const seedCollections = collections.map((c) => ({ ...c }));
const seedAmbientes = ambientes.map((a) => ({ ...a }));

const seedBanners = [
  {
    id: "banner-1",
    title: "Coleção Aurora chegou",
    subtitle: "Tons claros para começar a estação com leveza.",
    ctaLabel: "Ver coleção",
    ctaHref: "#colecoes",
    active: true,
    order: 1,
    startDate: "2026-06-01",
    endDate: "",
  },
  {
    id: "banner-2",
    title: "Até 20% em peças selecionadas",
    subtitle: "Ofertas por tempo limitado no catálogo.",
    ctaLabel: "Ver ofertas",
    ctaHref: "#ofertas",
    active: false,
    order: 2,
    startDate: "",
    endDate: "",
  },
];

const seedQuoteRequests = [
  {
    id: "req-1",
    name: "Fernanda Lopes",
    phone: "(11) 98888-1234",
    email: "fernanda@exemplo.com",
    interest: "Sofá Modular Aurora",
    city: "São Paulo/SP",
    message: "Gostaria de saber prazo de entrega e cores disponíveis.",
    contactPreference: "WhatsApp",
    status: "novo",
    notes: "",
    createdAt: "2026-07-20",
  },
  {
    id: "req-2",
    name: "Carlos Menezes",
    phone: "(21) 97777-5678",
    email: "carlos@exemplo.com",
    interest: "Sala contemporânea (ambiente completo)",
    city: "Rio de Janeiro/RJ",
    message: "Quero orçar o ambiente inteiro, incluindo iluminação.",
    contactPreference: "E-mail",
    status: "em atendimento",
    notes: "Catálogo enviado por e-mail em 22/07.",
    createdAt: "2026-07-18",
  },
  {
    id: "req-3",
    name: "Juliana Prado",
    phone: "(31) 96666-4321",
    email: "juliana@exemplo.com",
    interest: "Mesa de Jantar Terra 6 Lugares",
    city: "Belo Horizonte/MG",
    message: "Confirmar se acompanha as cadeiras no valor.",
    contactPreference: "Telefone",
    status: "orçamento enviado",
    notes: "",
    createdAt: "2026-07-10",
  },
  {
    id: "req-4",
    name: "Roberto Alves",
    phone: "(41) 95555-9876",
    email: "roberto@exemplo.com",
    interest: "Cadeira Ergonômica Essencial",
    city: "Curitiba/PR",
    message: "Pedido finalizado na loja física.",
    contactPreference: "WhatsApp",
    status: "concluído",
    notes: "Cliente satisfeito.",
    createdAt: "2026-06-30",
  },
];

const seedSettings = {
  companyName: config.company.name,
  whatsapp: config.contact.whatsappNumber,
  phone: config.contact.phone,
  email: config.contact.email,
  address: `${config.contact.city}/${config.contact.state}`,
  hours: config.contact.hours ?? "",
  instagram: config.contact.instagram ?? "",
  facebook: config.contact.facebook ?? "",
  deliveryInfo: "Prazo e condições de entrega calculados no orçamento, conforme a região.",
  institutionalText: config.about?.paragraphs?.[0] ?? "",
  footerText: "Modelo demonstrativo desenvolvido pela CronosStart.",
  defaultWhatsappMessage: config.contact.whatsappMessage,
};

const iconOptions = ["sofa", "bed", "layers", "briefcase", "lamp", "palette", "leaf", "home", "grid", "tag", "ruler", "sparkle"];
const toneOptions = ["sand", "linen", "walnut", "graphite", "stone", "clay", "sage"];

const tabs = [
  { id: "dashboard", label: "Dashboard" },
  { id: "produtos", label: "Produtos" },
  { id: "categorias", label: "Categorias" },
  { id: "colecoes", label: "Coleções" },
  { id: "ambientes", label: "Ambientes" },
  { id: "ofertas", label: "Ofertas" },
  { id: "banners", label: "Banners" },
  { id: "solicitacoes", label: "Solicitações" },
  { id: "config", label: "Configurações" },
];
---

<ShowcaseLayout config={{ ...config, seo }}>
  <MaisonLumeLogo slot="header-logo" />
  <MaisonLumeLogo slot="footer-logo" />

  <section class="bg-[var(--surface)] px-6 pb-16 pt-14 sm:pt-20">
    <div class="mx-auto max-w-6xl">
      <div data-login-gate class="mx-auto max-w-sm py-16 text-center">
        <span class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--primary)]/10 text-[var(--primary)]">
          <Icon name="key" class="h-6 w-6" />
        </span>
        <h1 class="font-[var(--font-heading)] text-2xl font-semibold tracking-tight text-[var(--ink)]">Acesso restrito</h1>
        <p class="mt-2 text-sm text-[var(--ink-muted)]">Painel administrativo demonstrativo — Maison Lume</p>
        <form data-login-form class="mt-8 space-y-3 text-left">
          <label class="block text-sm font-medium text-[var(--ink)]">
            E-mail
            <input
              type="email"
              value="loja@maisonlume-demo.com.br"
              readonly
              class="mt-1.5 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink-muted)] outline-none"
            />
          </label>
          <label class="block text-sm font-medium text-[var(--ink)]">
            Senha
            <input
              type="password"
              value="demonstracao"
              readonly
              class="mt-1.5 w-full rounded-[var(--radius-control)] border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-2.5 text-sm text-[var(--ink-muted)] outline-none"
            />
          </label>
          <button
            type="submit"
            class="!mt-6 w-full rounded-[var(--radius-control)] bg-[var(--primary)] px-6 py-3 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5"
          >
            Entrar no painel
          </button>
          <p class="text-center text-xs text-[var(--ink-muted)]">
            Acesso demonstrativo — campos pré-preenchidos, qualquer clique em "Entrar" libera o acesso.
          </p>
        </form>
      </div>

      <div data-admin-content class="hidden">
        <div class="rounded-2xl border border-[var(--accent)]/30 bg-[var(--accent)]/10 px-5 py-4 text-sm text-[var(--ink)]">
          <strong class="font-semibold">Ambiente de demonstração.</strong> As alterações abaixo ficam salvas apenas
          neste navegador (localStorage) e se refletem no site público enquanto você navegar neste mesmo navegador
          e dispositivo.
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Painel administrativo</p>
            <h1 class="mt-2 font-[var(--font-heading)] text-3xl font-semibold tracking-tight text-[var(--ink)] sm:text-4xl">
              Maison Lume
            </h1>
          </div>
          <button
            type="button"
            data-action="reset-all"
            class="inline-flex items-center gap-2 rounded-[var(--radius-control)] border border-[var(--border)] px-5 py-2.5 text-sm font-semibold text-[var(--ink)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            <Icon name="refresh" class="h-4 w-4" />
            Restaurar dados originais
          </button>
        </div>

        <div class="-mx-6 mt-6 flex gap-2 overflow-x-auto px-6 pb-1" role="tablist">
          {
            tabs.map((tab) => (
              <button
                type="button"
                role="tab"
                data-tab-button={tab.id}
                class="shrink-0 rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--ink-muted)] transition-colors"
              >
                {tab.label}
              </button>
            ))
          }
        </div>

        <!-- DASHBOARD -->
        <div data-panel="dashboard" class="mt-6">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Produtos ativos</p>
              <p data-stat="produtos-ativos" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Em oferta</p>
              <p data-stat="em-oferta" class="mt-1 text-2xl font-semibold text-[var(--accent)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Categorias ativas</p>
              <p data-stat="categorias-ativas" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Solicitações novas</p>
              <p data-stat="solicitacoes-novas" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Coleções ativas</p>
              <p data-stat="colecoes-ativas" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Ambientes ativos</p>
              <p data-stat="ambientes-ativos" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
              <p class="text-xs text-[var(--ink-muted)]">Banners ativos</p>
              <p data-stat="banners-ativos" class="mt-1 text-2xl font-semibold text-[var(--ink)]">0</p>
            </div>
          </div>
          <div class="mt-4 rounded-2xl border border-dashed border-[var(--border)] p-4 text-sm text-[var(--ink-muted)]">
            Em um projeto real, esta área também mostraria os produtos e categorias mais visitados, com base em
            dados reais de acesso. Como este é um modelo demonstrativo sem tráfego real, esse indicador não é
            simulado aqui para não apresentar números fictícios como se fossem reais.
          </div>
        </div>

        <!-- PRODUTOS -->
        <div data-panel="produtos" class="mt-6 hidden">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-[var(--ink)]">Produtos</h2>
            <button
              type="button"
              data-action="toggle-product-form"
              class="inline-flex items-center gap-2 rounded-[var(--radius-control)] bg-[var(--primary)] px-5 py-2.5 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5"
            >
              <Icon name="check" class="h-4 w-4" />
              Adicionar produto
            </button>
          </div>

          <div class="mt-4 grid gap-3 rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-4 sm:grid-cols-[1.3fr_1fr_1fr_1fr_auto]">
            <label class="block text-xs font-medium text-[var(--ink-muted)]">
              Buscar
              <input type="text" data-p-search placeholder="Nome ou SKU..." class="mt-1 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
            </label>
            <label class="block text-xs font-medium text-[var(--ink-muted)]">
              Categoria
              <select data-p-filter-category class="mt-1 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]">
                <option value="">Todas</option>
                {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
              </select>
            </label>
            <label class="block text-xs font-medium text-[var(--ink-muted)]">
              Status
              <select data-p-filter-status class="mt-1 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]">
                <option value="">Todos</option>
                <option value="disponivel">Disponível</option>
                <option value="indisponivel">Indisponível</option>
              </select>
            </label>
            <label class="block text-xs font-medium text-[var(--ink-muted)]">
              Ordenar por
              <select data-p-sort class="mt-1 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]">
                <option value="order">Ordem de exibição</option>
                <option value="name">Nome</option>
                <option value="price-asc">Menor preço</option>
                <option value="price-desc">Maior preço</option>
              </select>
            </label>
            <label class="flex items-center gap-2 text-xs font-medium text-[var(--ink-muted)] sm:pt-4">
              <input type="checkbox" data-p-show-archived class="h-4 w-4 rounded accent-[var(--primary)]" />
              Arquivados
            </label>
          </div>

          <form data-product-form class="mt-6 hidden grid-cols-1 gap-6 rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-6 lg:grid-cols-[1.3fr_1fr]">
            <div>
              <h3 data-product-form-title class="text-base font-semibold text-[var(--ink)]">Novo produto</h3>
              <input type="hidden" name="id" />
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
                  Nome
                  <input type="text" name="name" data-pf="name" required class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  SKU
                  <input type="text" name="sku" required class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Categoria
                  <select name="category" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]">
                    {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
                  </select>
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Coleção
                  <select name="collection" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]">
                    <option value="">Nenhuma</option>
                    {collections.map((c) => <option value={c.slug}>{c.name}</option>)}
                  </select>
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Ambiente
                  <select name="ambiente" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]">
                    <option value="">Nenhum</option>
                    {ambientes.map((a) => <option value={a.slug}>{a.name}</option>)}
                  </select>
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Preço (R$)
                  <input type="number" name="price" data-pf="price" required min="0" step="10" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Preço anterior (oferta)
                  <input type="number" name="previousPrice" data-pf="previousPrice" min="0" step="10" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <label class="flex items-center gap-2 self-end pb-2.5 text-sm font-medium text-[var(--ink)]">
                  <input type="checkbox" name="offerActive" class="h-4 w-4 rounded accent-[var(--primary)]" />
                  Oferta ativa
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Oferta válida até
                  <input type="date" name="offerEndsAt" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Tom visual
                  <select name="tone" data-pf="tone" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]">
                    {toneOptions.map((t) => <option value={t}>{t}</option>)}
                  </select>
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Ícone
                  <select name="icon" data-pf="icon" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]">
                    {iconOptions.map((i) => <option value={i}>{i}</option>)}
                  </select>
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Materiais (separados por vírgula)
                  <input type="text" name="materials" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Dimensões
                  <input type="text" name="dimensions" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Cores (separadas por vírgula)
                  <input type="text" name="colors" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Selo (opcional)
                  <input type="text" name="badge" placeholder="Ex.: Novo" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <label class="block text-sm font-medium text-[var(--ink)]">
                  Ordem de exibição
                  <input type="number" name="displayOrder" min="1" class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]" />
                </label>
                <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
                  <label class="flex items-center gap-2 text-sm font-medium text-[var(--ink)]">
                    <input type="checkbox" name="available" checked class="h-4 w-4 rounded accent-[var(--primary)]" />
                    Disponível
                  </label>
                  <label class="flex items-center gap-2 text-sm font-medium text-[var(--ink)]">
                    <input type="checkbox" name="featured" class="h-4 w-4 rounded accent-[var(--primary)]" />
                    Destaque
                  </label>
                  <label class="flex items-center gap-2 text-sm font-medium text-[var(--ink)]">
                    <input type="checkbox" name="isNew" class="h-4 w-4 rounded accent-[var(--primary)]" />
                    Novo
                  </label>
                </div>
                <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
                  Caminho da imagem
                  <input
                    type="text"
                    name="image"
                    data-pf="image"
                    placeholder="/images/showcases/moveis-decoracao/products/nome-do-produto.jpg"
                    class="mt-1.5 w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"
                  />
                  <span class="mt-1 block text-xs text-[var(--ink-muted)]">
                    Use um caminho de imagem já existente em /images/showcases/moveis-decoracao/products/ — se deixar em branco, um tom de cor é usado como imagem padrão.
                  </span>
                </label>
                <label class="block text-sm font-medium text-[var(--ink)] sm:col-span-2">
                  Descrição
                  <textarea name="description" rows="3" data-pf="description" class="mt-1.5 w-full resize-none rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm text-[var(--ink)] outline-none focus:border-[var(--primary)]"></textarea>
                </label>
              </div>
              <div class="mt-5 flex flex-wrap gap-3">
                <button type="submit" class="inline-flex items-center gap-2 rounded-[var(--radius-control)] bg-[var(--primary)] px-6 py-2.5 text-sm font-semibold text-[var(--primary-ink)] transition-transform hover:-translate-y-0.5">
                  Publicar produto
                </button>
                <button type="button" data-action="duplicate-current" class="inline-flex items-center gap-2 rounded-[var(--radius-control)] border border-[var(--border)] px-6 py-2.5 text-sm font-semibold text-[var(--ink)]">
                  Duplicar
                </button>
                <button type="button" data-action="cancel-product-form" class="inline-flex items-center gap-2 rounded-[var(--radius-control)] border border-[var(--border)] px-6 py-2.5 text-sm font-semibold text-[var(--ink)]">
                  Cancelar
                </button>
              </div>
            </div>

            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--ink-muted)]">Pré-visualização</p>
              <div class="mt-3 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)]">
                <div class="relative aspect-[4/3] w-full">
                  <div data-preview="visual" class="absolute inset-0"></div>
                  <img data-preview="image" src="" alt="" class="absolute inset-0 hidden h-full w-full object-cover" />
                </div>
                <div class="p-5">
                  <p data-preview="taxonomy" class="text-xs font-medium uppercase tracking-wide text-[var(--ink-muted)]">Categoria</p>
